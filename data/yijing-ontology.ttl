yj:note_1590 a yj:CommentaryNote ;
    rdfs:label "张载注·《御纂周易折中》·损卦·总论"@zh-Hans ;
    rdfs:comment "龟弗能违，言受益之可必，信然不疑也。"@zh-Hans ;
    yj:commentaryNoteText "龟弗能违，言受益之可必，信然不疑也。"@zh-Hans ;
    yj:sourceCitation "《御纂周易折中》·损卦·总论"@zh-Hans ;
