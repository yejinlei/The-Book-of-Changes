# === Commentaries (注本) ===
yj:zb_zixia a yj:Commentary ;
    rdfs:label "子夏易传"@zh-Hans ;
    rdfs:comment "先秦/后人依托 子夏易传：相传子夏所撰，今本为后人辑佚，是最早的易传之一。"@zh-Hans ;
    yj:name "子夏易传"@zh-Hans ;
    yj:dynasty "先秦/后人依托"@zh-Hans ;
    yj:author "子夏（托）"@zh-Hans ;
    yj:baihuaText "相传子夏所撰，今本为后人辑佚，是最早的易传之一。"@zh-Hans ;
    yj:authorOf yj:zj_zixia .

yj:zb_jingfang a yj:Commentary ;
    rdfs:label "京氏易传"@zh-Hans ;
    rdfs:comment "西汉 京氏易传：京房撰，八宫卦、纳甲、世应、飞伏、五行六亲诸说之所出，汉易代表作。"@zh-Hans ;
    yj:name "京氏易传"@zh-Hans ;
    yj:dynasty "西汉"@zh-Hans ;
    yj:author "京房"@zh-Hans ;
    yj:baihuaText "京房撰，八宫卦、纳甲、世应、飞伏、五行六亲诸说之所出，汉易代表作。"@zh-Hans ;
    yj:authorOf yj:zj_jingfang .

yj:zb_zhengxuan a yj:Commentary ;
    rdfs:label "周易郑注"@zh-Hans ;
    rdfs:comment "东汉 周易郑注：郑玄以爻辰说注易，兼采今古文，东汉经学集大成之作，今有辑本。"@zh-Hans ;
    yj:name "周易郑注"@zh-Hans ;
    yj:dynasty "东汉"@zh-Hans ;
    yj:author "郑玄"@zh-Hans ;
    yj:baihuaText "郑玄以爻辰说注易，兼采今古文，东汉经学集大成之作，今有辑本。"@zh-Hans ;
    yj:authorOf yj:zj_zhengxuan .

yj:zb_yufan a yj:Commentary ;
    rdfs:label "虞氏易注"@zh-Hans ;
    rdfs:comment "三国 虞氏易注：汉易象数集大成，《周易集解》引其说最多，清张惠言辑为《周易虞氏义》。"@zh-Hans ;
    yj:name "虞氏易注"@zh-Hans ;
    yj:dynasty "三国"@zh-Hans ;
    yj:author "虞翻"@zh-Hans ;
    yj:baihuaText "汉易象数集大成，《周易集解》引其说最多，清张惠言辑为《周易虞氏义》。"@zh-Hans ;
    yj:authorOf yj:zj_yufan .

yj:zb_wangbi a yj:Commentary ;
    rdfs:label "周易注"@zh-Hans ;
    rdfs:comment "魏晋 周易注：王弼注64卦及《文言》，韩康伯补《系辞》等，扫象言理，玄学易代表作，后为《周易正义》采用。"@zh-Hans ;
    yj:name "周易注"@zh-Hans ;
    yj:dynasty "魏晋"@zh-Hans ;
    yj:author "王弼、韩康伯"@zh-Hans ;
    yj:baihuaText "王弼注64卦及《文言》，韩康伯补《系辞》等，扫象言理，玄学易代表作，后为《周易正义》采用。"@zh-Hans ;
    yj:authorOf yj:zj_wangbi .

yj:zb_kongshu a yj:Commentary ;
    rdfs:label "周易正义"@zh-Hans ;
    rdfs:comment "唐 周易正义：唐代官修《五经正义》之首，以王弼注为底本，唐代以来科举标准，影响极大。"@zh-Hans ;
    yj:name "周易正义"@zh-Hans ;
    yj:dynasty "唐"@zh-Hans ;
    yj:author "孔颖达等"@zh-Hans ;
    yj:baihuaText "唐代官修《五经正义》之首，以王弼注为底本，唐代以来科举标准，影响极大。"@zh-Hans ;
    yj:authorOf yj:zj_kongyingda .

yj:zb_jijie a yj:Commentary ;
    rdfs:label "周易集解"@zh-Hans ;
    rdfs:comment "唐 周易集解：集汉魏至唐35家易注，保存大量汉易佚说，是研究汉易的第一要籍。"@zh-Hans ;
    yj:name "周易集解"@zh-Hans ;
    yj:dynasty "唐"@zh-Hans ;
    yj:author "李鼎祚"@zh-Hans ;
    yj:baihuaText "集汉魏至唐35家易注，保存大量汉易佚说，是研究汉易的第一要籍。"@zh-Hans ;
    yj:authorOf yj:zj_lidingzuo .

yj:zb_chengtuan a yj:Commentary ;
    rdfs:label "伊川易传"@zh-Hans ;
    rdfs:comment "北宋 伊川易传：程颐理学解易代表作，专讲义理，说理精纯，为义理易学高峰。"@zh-Hans ;
    yj:name "伊川易传"@zh-Hans ;
    yj:dynasty "北宋"@zh-Hans ;
    yj:author "程颐"@zh-Hans ;
    yj:baihuaText "程颐理学解易代表作，专讲义理，说理精纯，为义理易学高峰。"@zh-Hans ;
    yj:authorOf yj:zj_chengyi .

yj:zb_shaoyong a yj:Commentary ;
    rdfs:label "皇极经世书"@zh-Hans ;
    rdfs:comment "北宋 皇极经世书：邵雍先天象数学巨著，以元会运世推演宇宙历史。"@zh-Hans ;
    yj:name "皇极经世书"@zh-Hans ;
    yj:dynasty "北宋"@zh-Hans ;
    yj:author "邵雍"@zh-Hans ;
    yj:baihuaText "邵雍先天象数学巨著，以元会运世推演宇宙历史。"@zh-Hans ;
    yj:authorOf yj:zj_shaoyong .

yj:zb_benyi a yj:Commentary ;
    rdfs:label "周易本义"@zh-Hans ;
    rdfs:comment "南宋 周易本义：朱熹易学代表作，区分经传，还易为占筮书，列河图洛书先天诸图，元明清科举标准。"@zh-Hans ;
    yj:name "周易本义"@zh-Hans ;
    yj:dynasty "南宋"@zh-Hans ;
    yj:author "朱熹"@zh-Hans ;
    yj:baihuaText "朱熹易学代表作，区分经传，还易为占筮书，列河图洛书先天诸图，元明清科举标准。"@zh-Hans ;
    yj:authorOf yj:zj_zhuxi .

yj:zb_yangwanli a yj:Commentary ;
    rdfs:label "诚斋易传"@zh-Hans ;
    rdfs:comment "南宋 诚斋易传：以历代史事证易义，与程传并称\"程杨\"。"@zh-Hans ;
    yj:name "诚斋易传"@zh-Hans ;
    yj:dynasty "南宋"@zh-Hans ;
    yj:author "杨万里"@zh-Hans ;
    yj:baihuaText "以历代史事证易义，与程传并称\"程杨\"。"@zh-Hans ;
    yj:authorOf yj:zj_yangwanli .

yj:zb_laizhide a yj:Commentary ;
    rdfs:label "周易集注（来氏易）"@zh-Hans ;
    rdfs:comment "明 周易集注（来氏易）：来知德隐居二十九年所著，发明错综说，明代象数易代表。"@zh-Hans ;
    yj:name "周易集注（来氏易）"@zh-Hans ;
    yj:dynasty "明"@zh-Hans ;
    yj:author "来知德"@zh-Hans ;
    yj:baihuaText "来知德隐居二十九年所著，发明错综说，明代象数易代表。"@zh-Hans ;
    yj:authorOf yj:zj_laizhide .

yj:zb_wangfuzhi a yj:Commentary ;
    rdfs:label "周易外传/内传"@zh-Hans ;
    rdfs:comment "明末清初 周易外传/内传：王夫之易学代表作，博大精深，代表传统易学最高水平之一。"@zh-Hans ;
    yj:name "周易外传/内传"@zh-Hans ;
    yj:dynasty "明末清初"@zh-Hans ;
    yj:author "王夫之"@zh-Hans ;
    yj:baihuaText "王夫之易学代表作，博大精深，代表传统易学最高水平之一。"@zh-Hans ;
    yj:authorOf yj:zj_wangfuzhi .

yj:zb_zhezhong a yj:Commentary ;
    rdfs:label "御纂周易折中"@zh-Hans ;
    rdfs:comment "清（康熙） 御纂周易折中：奉康熙诏编纂，以程传、本义为主，博采历代诸家之说，为集大成的官方易注。"@zh-Hans ;
    yj:name "御纂周易折中"@zh-Hans ;
    yj:dynasty "清（康熙）"@zh-Hans ;
    yj:author "李光地等"@zh-Hans ;
    yj:baihuaText "奉康熙诏编纂，以程传、本义为主，博采历代诸家之说，为集大成的官方易注。"@zh-Hans ;
    yj:authorOf yj:zj_liguangdi .

yj:zb_huidong a yj:Commentary ;
    rdfs:label "易汉学/周易述"@zh-Hans ;
    rdfs:comment "清 易汉学/周易述：清代复兴汉易代表，钩稽汉儒易说。"@zh-Hans ;
    yj:name "易汉学/周易述"@zh-Hans ;
    yj:dynasty "清"@zh-Hans ;
    yj:author "惠栋"@zh-Hans ;
    yj:baihuaText "清代复兴汉易代表，钩稽汉儒易说。"@zh-Hans ;
    yj:authorOf yj:zj_huidong .

yj:zb_jiaoxun a yj:Commentary ;
    rdfs:label "易学三书"@zh-Hans ;
    rdfs:comment "清 易学三书：焦循以旁通、相错、时行三例通释全易，清代易学殿军。"@zh-Hans ;
    yj:name "易学三书"@zh-Hans ;
    yj:dynasty "清"@zh-Hans ;
    yj:author "焦循"@zh-Hans ;
    yj:baihuaText "焦循以旁通、相错、时行三例通释全易，清代易学殿军。"@zh-Hans ;
    yj:authorOf yj:zj_jiaoxun .

yj:zb_shangbinghe a yj:Commentary ;
    rdfs:label "周易尚氏学"@zh-Hans ;
    rdfs:comment "近现代 周易尚氏学：近现代象数易学代表作，从《焦氏易林》发掘先秦古象。"@zh-Hans ;
    yj:name "周易尚氏学"@zh-Hans ;
    yj:dynasty "近现代"@zh-Hans ;
    yj:author "尚秉和"@zh-Hans ;
    yj:baihuaText "近现代象数易学代表作，从《焦氏易林》发掘先秦古象。"@zh-Hans ;
    yj:authorOf yj:zj_shangbinghe .

yj:zb_gaoheng a yj:Commentary ;
    rdfs:label "周易古经今注/大传今注"@zh-Hans ;
    rdfs:comment "现代 周易古经今注/大传今注：现代考据派易学代表作，以文字训诂见长，区分经传研究。"@zh-Hans ;
    yj:name "周易古经今注/大传今注"@zh-Hans ;
    yj:dynasty "现代"@zh-Hans ;
    yj:author "高亨"@zh-Hans ;
    yj:baihuaText "现代考据派易学代表作，以文字训诂见长，区分经传研究。"@zh-Hans ;
    yj:authorOf yj:zj_gaoheng .

yj:zb_zhubokun a yj:Commentary ;
    rdfs:label "易学哲学史"@zh-Hans ;
    rdfs:comment "当代 易学哲学史：四卷本易学通史，从先秦到清代，易学哲学史最系统著作。"@zh-Hans ;
    yj:name "易学哲学史"@zh-Hans ;
    yj:dynasty "当代"@zh-Hans ;
    yj:author "朱伯崑"@zh-Hans ;
    yj:baihuaText "四卷本易学通史，从先秦到清代，易学哲学史最系统著作。"@zh-Hans ;
    yj:authorOf yj:zj_zhubokun .

yj:zb_huangshouqi a yj:Commentary ;
    rdfs:label "周易译注"@zh-Hans ;
    rdfs:comment "当代 周易译注：当代最通行的周易今注今译本，译文准确，注释详尽。"@zh-Hans ;
    yj:name "周易译注"@zh-Hans ;
    yj:dynasty "当代"@zh-Hans ;
    yj:author "黄寿祺、张善文"@zh-Hans ;
    yj:baihuaText "当代最通行的周易今注今译本，译文准确，注释详尽。"@zh-Hans ;
    yj:authorOf yj:zj_huangshouqi .

yj:zb_liudajun a yj:Commentary ;
    rdfs:label "周易概论"@zh-Hans ;
    rdfs:comment "当代 周易概论：当代象数易学入门佳作。"@zh-Hans ;
    yj:name "周易概论"@zh-Hans ;
    yj:dynasty "当代"@zh-Hans ;
    yj:author "刘大钧"@zh-Hans ;
    yj:baihuaText "当代象数易学入门佳作。"@zh-Hans ;
    yj:authorOf yj:zj_liudajun .

# === Scholarly Schools (流派) ===
yj:lp_bianyi a yj:School ;
    rdfs:label "变易"@zh-Hans ;
    rdfs:comment "易之为言变也。宇宙万物时刻在变化运动，无一息不变，卦爻者所以模拟变化之道。"@zh-Hans ;
    yj:name "变易"@zh-Hans ;
    yj:baihuaText "易之为言变也。宇宙万物时刻在变化运动，无一息不变，卦爻者所以模拟变化之道。"@zh-Hans .

yj:lp_jianyi a yj:School ;
    rdfs:label "简易"@zh-Hans ;
    rdfs:comment "乾以易知，坤以简能。易则易知，简则易从。大道至简，执简驭繁。"@zh-Hans ;
    yj:name "简易"@zh-Hans ;
    yj:baihuaText "乾以易知，坤以简能。易则易知，简则易从。大道至简，执简驭繁。"@zh-Hans .

yj:lp_buyi a yj:School ;
    rdfs:label "不易"@zh-Hans ;
    rdfs:comment "变动之中有不变者存。天尊地卑，乾坤定矣；动静有常，刚柔断矣。变中之常道为不易。"@zh-Hans ;
    yj:name "不易"@zh-Hans ;
    yj:baihuaText "变动之中有不变者存。天尊地卑，乾坤定矣；动静有常，刚柔断矣。变中之常道为不易。"@zh-Hans .

yj:lp_xiangshu a yj:School ;
    rdfs:label "象数派"@zh-Hans ;
    rdfs:comment "以卦象、爻位、奇偶之数为核心解释周易，注重卦变、互体、纳甲、爻辰、卦气等体例。代表：孟喜、京房、虞翻、邵雍、来知德、尚秉和、刘大钧。"@zh-Hans ;
    yj:name "象数派"@zh-Hans ;
    yj:baihuaText "以卦象、爻位、奇偶之数为核心解释周易，注重卦变、互体、纳甲、爻辰、卦气等体例。代表：孟喜、京房、虞翻、邵雍、来知德、尚秉和、刘大钧。"@zh-Hans .

yj:lp_yili a yj:School ;
    rdfs:label "义理派"@zh-Hans ;
    rdfs:comment "撇弃象数繁琐，以阐发易理、儒家义理为主，注重德义、政事、修齐治平。代表：王弼、程颐、朱熹（兼图书）、王夫之。"@zh-Hans ;
    yj:name "义理派"@zh-Hans ;
    yj:baihuaText "撇弃象数繁琐，以阐发易理、儒家义理为主，注重德义、政事、修齐治平。代表：王弼、程颐、朱熹（兼图书）、王夫之。"@zh-Hans .

yj:lp_tushu a yj:School ;
    rdfs:label "图书派"@zh-Hans ;
    rdfs:comment "以河图、洛书、先天图、太极图等图式解释易之起源与结构。代表：陈抟、邵雍、朱熹（采图说）。"@zh-Hans ;
    yj:name "图书派"@zh-Hans ;
    yj:baihuaText "以河图、洛书、先天图、太极图等图式解释易之起源与结构。代表：陈抟、邵雍、朱熹（采图说）。"@zh-Hans .

yj:lp_tuili a yj:School ;
    rdfs:label "义理/占筮派（术数派）"@zh-Hans ;
    rdfs:comment "以周易用于占筮预测，包括纳甲筮法、梅花易数、六爻、奇门、六壬等实用术数。代表：京房、邵雍（梅花易数托名）。"@zh-Hans ;
    yj:name "义理/占筮派（术数派）"@zh-Hans ;
    yj:baihuaText "以周易用于占筮预测，包括纳甲筮法、梅花易数、六爻、奇门、六壬等实用术数。代表：京房、邵雍（梅花易数托名）。"@zh-Hans .

yj:lp_shishi a yj:School ;
    rdfs:label "史事易"@zh-Hans ;
    rdfs:comment "以历史事实印证易义，引史证经。代表：干宝、杨万里。"@zh-Hans ;
    yj:name "史事易"@zh-Hans ;
    yj:baihuaText "以历史事实印证易义，引史证经。代表：干宝、杨万里。"@zh-Hans .

yj:lp_kaozheng a yj:School ;
    rdfs:label "考据派"@zh-Hans ;
    rdfs:comment "以文字训诂、文献考据方法研究周易，注重版本、文字、源流。代表：惠栋、张惠言、高亨、李镜池、顾颉刚。"@zh-Hans ;
    yj:name "考据派"@zh-Hans ;
    yj:baihuaText "以文字训诂、文献考据方法研究周易，注重版本、文字、源流。代表：惠栋、张惠言、高亨、李镜池、顾颉刚。"@zh-Hans .

yj:lp_dao a yj:School ;
    rdfs:label "道家易/丹道易"@zh-Hans ;
    rdfs:comment "以易理论丹道修炼。代表：魏伯阳《周易参同契》。"@zh-Hans ;
    yj:name "道家易/丹道易"@zh-Hans ;
    yj:baihuaText "以易理论丹道修炼。代表：魏伯阳《周易参同契》。"@zh-Hans .

yj:lp_fo a yj:School ;
    rdfs:label "佛家易/禅易"@zh-Hans ;
    rdfs:comment "以佛理解易、以禅解易。代表：智旭《周易禅解》。"@zh-Hans ;
    yj:name "佛家易/禅易"@zh-Hans ;
    yj:baihuaText "以佛理解易、以禅解易。代表：智旭《周易禅解》。"@zh-Hans .

yj:lp_qitazongjiao a yj:School ;
    rdfs:label "会通派/现代新易"@zh-Hans ;
    rdfs:comment "融会中西，或与现代科学、管理学结合。代表：杭辛斋、南怀瑾、曾仕强。"@zh-Hans ;
    yj:name "会通派/现代新易"@zh-Hans ;
    yj:baihuaText "融会中西，或与现代科学、管理学结合。代表：杭辛斋、南怀瑾、曾仕强。"@zh-Hans .

# === Divination Methods (筮法) ===
yj:sf_dayan a yj:DivinationMethod ;
    rdfs:label "大衍揲蓍法"@zh-Hans ;
    rdfs:comment "《系辞》所载正统筮法，用五十策蓍草三变而成爻。"@zh-Hans ;
    yj:name "大衍揲蓍法"@zh-Hans .

yj:sf_tongqian a yj:DivinationMethod ;
    rdfs:label "铜钱摇卦法"@zh-Hans ;
    rdfs:comment "火珠林三钱代蓍，三枚铜钱共六次成卦。"@zh-Hans ;
    yj:name "铜钱摇卦法"@zh-Hans .

yj:sf_meihua a yj:DivinationMethod ;
    rdfs:label "梅花易数"@zh-Hans ;
    rdfs:comment "邵雍先天易，年月日时起卦。"@zh-Hans ;
    yj:name "梅花易数"@zh-Hans .

yj:sf_najia a yj:DivinationMethod ;
    rdfs:label "纳甲筮法"@zh-Hans ;
    rdfs:comment "火珠林纳甲装卦，世应六亲六神飞伏。"@zh-Hans ;
    yj:name "纳甲筮法"@zh-Hans .

