yj:note_1589 a yj:CommentaryNote ;
    rdfs:label "张载注·《御纂周易折中》·晋卦·总论"@zh-Hans ;
    rdfs:comment "无可进而进，唯“伐邑”于内则可矣，如君子则知止也。"@zh-Hans ;
    yj:commentaryNoteText "无可进而进，唯“伐邑”于内则可矣，如君子则知止也。"@zh-Hans ;
