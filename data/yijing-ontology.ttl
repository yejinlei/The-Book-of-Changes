@prefix yj:    <https://yejinlei.github.io/The-Book-of-Changes/ontology/yijing#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix ctext: <https://ctext.org/wiki.pl?if=gb&chapter=> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix :      <https://yejinlei.github.io/The-Book-of-Changes/ontology/yijing#> .

<> a owl:Ontology ;
    dct:title "易经本体论 (Yijing Ontology)"@zh-Hans ;
    dct:title "The Book of Changes (Yijing) Ontology"@en ;
    owl:versionInfo "1.0" ;
    dct:creator <https://yejinlei.github.io/> ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    rdfs:comment "面向数字人文研究的易经本体论，覆盖六十四卦、三百八十六爻、十翼、历代注家与注本、筮法、卦变、纳甲、校勘异文、学术传承关系网络。"@zh-Hans ;
    rdfs:comment "An open RDF/OWL ontology for digital humanities research on the Chinese classic Yijing (I Ching, Book of Changes), covering 64 hexagrams, 386 lines, Ten Wings, historical commentaries and commentators, divination methods, hexagram transformations, Najia system, textual variants, and scholarly lineages."@en .

# === Classes ===
yj:Hexagram a owl:Class ;
    rdfs:label "卦"@zh-Hans ;
    skos:prefLabel "卦"@zh-Hans ;
    rdfs:comment "Hexagram (gua 卦)"@en ;
    owl:sameAs wd:Hexagram ;
    rdfs:subClassOf skos:Concept .

yj:Trigram a owl:Class ;
    rdfs:label "三画卦/八卦"@zh-Hans ;
    skos:prefLabel "三画卦/八卦"@zh-Hans ;
    rdfs:comment "Trigram (bagua 八卦)"@en ;
    owl:sameAs wd:Trigram ;
    rdfs:subClassOf skos:Concept .

yj:Line a owl:Class ;
    rdfs:label "爻"@zh-Hans ;
    skos:prefLabel "爻"@zh-Hans ;
    rdfs:comment "Line (yao 爻)"@en ;
    owl:sameAs wd:HexagramLine ;
    rdfs:subClassOf skos:Concept .

yj:LineText a owl:Class ;
    rdfs:label "爻辞"@zh-Hans ;
    skos:prefLabel "爻辞"@zh-Hans ;
    rdfs:comment "Line statement (yaoci)"@en ;
    rdfs:subClassOf skos:Concept .

yj:HexagramText a owl:Class ;
    rdfs:label "卦辞"@zh-Hans ;
    skos:prefLabel "卦辞"@zh-Hans ;
    rdfs:comment "Hexagram statement (guaci)"@en ;
    rdfs:subClassOf skos:Concept .

yj:YiZhuan a owl:Class ;
    rdfs:label "十翼"@zh-Hans ;
    skos:prefLabel "十翼"@zh-Hans ;
    rdfs:comment "Ten Wings (shiyi 十翼)"@en ;
    owl:sameAs wd:Ten_Wings ;
    rdfs:subClassOf skos:Concept .

yj:Commentary a owl:Class ;
    rdfs:label "注本/易传"@zh-Hans ;
    skos:prefLabel "注本/易传"@zh-Hans ;
    rdfs:comment "Commentary / Appended text"@en ;
    rdfs:subClassOf skos:Concept .

yj:Commentator a owl:Class ;
    rdfs:label "注家/易学家"@zh-Hans ;
    skos:prefLabel "注家/易学家"@zh-Hans ;
    rdfs:comment "Commentator (Zhujia 注家)"@en ;
    owl:sameAs wd:I_Ching_divination ;
    rdfs:subClassOf skos:Concept .

yj:CommentaryNote a owl:Class ;
    rdfs:label "注文/评注"@zh-Hans ;
    skos:prefLabel "注文/评注"@zh-Hans ;
    rdfs:comment "Commentary note / individual annotation"@en ;
    rdfs:subClassOf skos:Concept .

yj:School a owl:Class ;
    rdfs:label "学派/流派"@zh-Hans ;
    skos:prefLabel "学派/流派"@zh-Hans ;
    rdfs:comment "Scholarly school (liupai 流派)"@en ;
    rdfs:subClassOf skos:Concept .

yj:DivinationMethod a owl:Class ;
    rdfs:label "筮法"@zh-Hans ;
    skos:prefLabel "筮法"@zh-Hans ;
    rdfs:comment "Divination method (shifa 筮法)"@en ;
    owl:sameAs wd:I_Ching_divination ;
    rdfs:subClassOf skos:Concept .

yj:DivinationResult a owl:Class ;
    rdfs:label "占筮结果"@zh-Hans ;
    skos:prefLabel "占筮结果"@zh-Hans ;
    rdfs:comment "Divination result"@en ;
    rdfs:subClassOf skos:Concept .

yj:HexagramChange a owl:Class ;
    rdfs:label "卦变"@zh-Hans ;
    skos:prefLabel "卦变"@zh-Hans ;
    rdfs:comment "Hexagram change (guabian)"@en ;
    rdfs:subClassOf skos:Concept .

yj:NajiaSystem a owl:Class ;
    rdfs:label "纳甲筮法体系"@zh-Hans ;
    skos:prefLabel "纳甲筮法体系"@zh-Hans ;
    rdfs:comment "Najia / Huozhulin fire-pearl grove divination system"@en ;
    rdfs:subClassOf skos:Concept .

yj:TextualVersion a owl:Class ;
    rdfs:label "版本"@zh-Hans ;
    skos:prefLabel "版本"@zh-Hans ;
    rdfs:comment "Textual version (banben)"@en ;
    rdfs:subClassOf skos:Concept .

yj:TextualVariant a owl:Class ;
    rdfs:label "异文"@zh-Hans ;
    skos:prefLabel "异文"@zh-Hans ;
    rdfs:comment "Textual variant (yiwen)"@en ;
    rdfs:subClassOf skos:Concept .

yj:AcademicRelation a owl:Class ;
    rdfs:label "学术关系"@zh-Hans ;
    skos:prefLabel "学术关系"@zh-Hans ;
    rdfs:comment "Scholarly relation between commentators"@en ;
    rdfs:subClassOf skos:Concept .

yj:TrigramSymbol a owl:Class ;
    rdfs:label "八卦象"@zh-Hans ;
    skos:prefLabel "八卦象"@zh-Hans ;
    rdfs:comment "Trigram symbol (yin-yang lines)"@en ;
    rdfs:subClassOf skos:Concept .

# === Object Properties ===
yj:upperTrigram a owl:ObjectProperty ;
    rdfs:label "上卦"@zh-Hans ;
    rdfs:comment "upper trigram"@en .

yj:lowerTrigram a owl:ObjectProperty ;
    rdfs:label "下卦"@zh-Hans ;
    rdfs:comment "lower trigram"@en .

yj:hasLine a owl:ObjectProperty ;
    rdfs:label "有爻"@zh-Hans ;
    rdfs:comment "has a line position"@en .

yj:lineOf a owl:ObjectProperty ;
    rdfs:label "爻所属卦"@zh-Hans ;
    rdfs:comment "belongs to hexagram"@en .

yj:hasGuaci a owl:ObjectProperty ;
    rdfs:label "有卦辞"@zh-Hans ;
    rdfs:comment "has hexagram statement"@en .

yj:hasYaoci a owl:ObjectProperty ;
    rdfs:label "有爻辞"@zh-Hans ;
    rdfs:comment "has line statement"@en .

yj:hasTuanZhuan a owl:ObjectProperty ;
    rdfs:label "有彖传"@zh-Hans ;
    rdfs:comment "has Tuan commentary"@en .

yj:hasXiangZhuan a owl:ObjectProperty ;
    rdfs:label "有象传"@zh-Hans ;
    rdfs:comment "has Xiang commentary"@en .

yj:hasWenYan a owl:ObjectProperty ;
    rdfs:label "有文言传"@zh-Hans ;
    rdfs:comment "has Wenyan commentary"@en .

yj:cuoGua a owl:ObjectProperty ;
    rdfs:label "错卦"@zh-Hans ;
    rdfs:comment "opposite hexagram (all lines inverted)"@en .

yj:zongGua a owl:ObjectProperty ;
    rdfs:label "综卦"@zh-Hans ;
    rdfs:comment "inverted hexagram (top-bottom flipped)"@en .

yj:huGua a owl:ObjectProperty ;
    rdfs:label "互卦"@zh-Hans ;
    rdfs:comment "nuclear hexagram"@en .

yj:jiaoGua a owl:ObjectProperty ;
    rdfs:label "交卦"@zh-Hans ;
    rdfs:comment "transposed hexagram (upper/lower swapped)"@en .

yj:bianTo a owl:ObjectProperty ;
    rdfs:label "变为"@zh-Hans ;
    rdfs:comment "transforms into hexagram"@en .

yj:inTenWings a owl:ObjectProperty ;
    rdfs:label "在十翼中"@zh-Hans ;
    rdfs:comment "appears in the Ten Wings"@en .

yj:annotatedBy a owl:ObjectProperty ;
    rdfs:label "被注家注解"@zh-Hans ;
    rdfs:comment "is annotated by commentator"@en .

yj:annotates a owl:ObjectProperty ;
    rdfs:label "注解"@zh-Hans ;
    rdfs:comment "annotates a passage"@en .

yj:belongsToCommentary a owl:ObjectProperty ;
    rdfs:label "所属注本"@zh-Hans ;
    rdfs:comment "belongs to a commentary work"@en .

yj:authorOf a owl:ObjectProperty ;
    rdfs:label "作者"@zh-Hans ;
    rdfs:comment "author of a commentary"@en .

yj:belongsToSchool a owl:ObjectProperty ;
    rdfs:label "所属流派"@zh-Hans ;
    rdfs:comment "belongs to scholarly school"@en .

yj:discipleOf a owl:ObjectProperty ;
    rdfs:label "师承于"@zh-Hans ;
    rdfs:comment "disciple / student of"@en .

yj:followsDoctrineOf a owl:ObjectProperty ;
    rdfs:label "宗述"@zh-Hans ;
    rdfs:comment "follows doctrine of"@en .

yj:cites a owl:ObjectProperty ;
    rdfs:label "引述"@zh-Hans ;
    rdfs:comment "cites"@en .

yj:criticizes a owl:ObjectProperty ;
    rdfs:label "驳斥"@zh-Hans ;
    rdfs:comment "criticizes"@en .

yj:commentsOn a owl:ObjectProperty ;
    rdfs:label "评议"@zh-Hans ;
    rdfs:comment "comments on"@en .

yj:hasVariant a owl:ObjectProperty ;
    rdfs:label "有异文"@zh-Hans ;
    rdfs:comment "has textual variant"@en .

yj:inVersion a owl:ObjectProperty ;
    rdfs:label "见于版本"@zh-Hans ;
    rdfs:comment "appears in version"@en .

yj:variantIn a owl:ObjectProperty ;
    rdfs:label "版本异文位置"@zh-Hans ;
    rdfs:comment "variant located in"@en .

yj:methodOf a owl:ObjectProperty ;
    rdfs:label "筮法所属"@zh-Hans ;
    rdfs:comment "of divination method"@en .

yj:inPalace a owl:ObjectProperty ;
    rdfs:label "属八宫"@zh-Hans ;
    rdfs:comment "belongs to Najia palace"@en .

yj:shiYao a owl:ObjectProperty ;
    rdfs:label "世爻"@zh-Hans ;
    rdfs:comment "world line"@en .

yj:yingYao a owl:ObjectProperty ;
    rdfs:label "应爻"@zh-Hans ;
    rdfs:comment "response line"@en .

yj:worldLine a owl:ObjectProperty ;
    rdfs:label "世爻位置"@zh-Hans ;
    rdfs:comment "world line position"@en .

yj:responseLine a owl:ObjectProperty ;
    rdfs:label "应爻位置"@zh-Hans ;
    rdfs:comment "response line position"@en .

yj:correspondsTo a owl:ObjectProperty ;
    rdfs:label "对应"@zh-Hans ;
    rdfs:comment "corresponds to"@en .

# === Datatype Properties ===
yj:yaoPosition a owl:DatatypeProperty ;
    rdfs:label "爻位"@zh-Hans ;
    rdfs:comment "line position (1-6)"@en ;
    rdfs:range xsd:integer ;
    .

yj:yinYang a owl:DatatypeProperty ;
    rdfs:label "阴阳"@zh-Hans ;
    rdfs:comment "yin/yang attribute"@en ;
    .

yj:name a owl:DatatypeProperty ;
    rdfs:label "名称"@zh-Hans ;
    rdfs:comment "name"@en ;
    .

yj:guaName a owl:DatatypeProperty ;
    rdfs:label "卦名"@zh-Hans ;
    rdfs:comment "hexagram name"@en ;
    .

yj:trigramName a owl:DatatypeProperty ;
    rdfs:label "卦名"@zh-Hans ;
    rdfs:comment "trigram name"@en ;
    .

yj:symbol a owl:DatatypeProperty ;
    rdfs:label "卦画"@zh-Hans ;
    rdfs:comment "hexagram symbol"@en ;
    .

yj:sequenceNumber a owl:DatatypeProperty ;
    rdfs:label "卦序"@zh-Hans ;
    rdfs:comment "sequence number (1-64)"@en ;
    rdfs:range xsd:integer ;
    .

yj:wuxing a owl:DatatypeProperty ;
    rdfs:label "五行"@zh-Hans ;
    rdfs:comment "five phases wuxing"@en ;
    .

yj:guaciText a owl:DatatypeProperty ;
    rdfs:label "卦辞原文"@zh-Hans ;
    rdfs:comment "hexagram statement text"@en ;
    .

yj:yaociText a owl:DatatypeProperty ;
    rdfs:label "爻辞原文"@zh-Hans ;
    rdfs:comment "line statement text"@en ;
    .

yj:xiangText a owl:DatatypeProperty ;
    rdfs:label "象传原文"@zh-Hans ;
    rdfs:comment "xiang commentary text"@en ;
    .

yj:tuanText a owl:DatatypeProperty ;
    rdfs:label "彖传原文"@zh-Hans ;
    rdfs:comment "tuan commentary text"@en ;
    .

yj:xiaoxiangText a owl:DatatypeProperty ;
    rdfs:label "小象传原文"@zh-Hans ;
    rdfs:comment "small xiang line commentary text"@en ;
    .

yj:baihuaText a owl:DatatypeProperty ;
    rdfs:label "白话译文"@zh-Hans ;
    rdfs:comment "modern Chinese translation"@en ;
    .

yj:birthDeath a owl:DatatypeProperty ;
    rdfs:label "生卒年"@zh-Hans ;
    rdfs:comment "birth-death years"@en ;
    .

yj:dynasty a owl:DatatypeProperty ;
    rdfs:label "朝代"@zh-Hans ;
    rdfs:comment "dynasty/period"@en ;
    .

yj:zihao a owl:DatatypeProperty ;
    rdfs:label "字号"@zh-Hans ;
    rdfs:comment "courtesy name"@en ;
    .

yj:xingming a owl:DatatypeProperty ;
    rdfs:label "姓名"@zh-Hans ;
    rdfs:comment "personal name"@en ;
    .

yj:nativePlace a owl:DatatypeProperty ;
    rdfs:label "籍贯"@zh-Hans ;
    rdfs:comment "native place"@en ;
    .

yj:representativeWork a owl:DatatypeProperty ;
    rdfs:label "代表作"@zh-Hans ;
    rdfs:comment "representative work"@en ;
    .

yj:schoolNote a owl:DatatypeProperty ;
    rdfs:label "学派说明"@zh-Hans ;
    rdfs:comment "school description"@en ;
    .

yj:readingCount a owl:DatatypeProperty ;
    rdfs:label "引文数"@zh-Hans ;
    rdfs:comment "citation count"@en ;
    rdfs:range xsd:integer ;
    .

yj:commentaryNoteText a owl:DatatypeProperty ;
    rdfs:label "注文原文"@zh-Hans ;
    rdfs:comment "commentary note text"@en ;
    .

yj:variantReading a owl:DatatypeProperty ;
    rdfs:label "异文"@zh-Hans ;
    rdfs:comment "variant reading"@en ;
    .

yj:receivedText a owl:DatatypeProperty ;
    rdfs:label "通行本文"@zh-Hans ;
    rdfs:comment "received text"@en ;
    .

yj:note a owl:DatatypeProperty ;
    rdfs:label "校记/说明"@zh-Hans ;
    rdfs:comment "editorial note"@en ;
    .

yj:sourceCitation a owl:DatatypeProperty ;
    rdfs:label "出处"@zh-Hans ;
    rdfs:comment "source citation"@en ;
    .

yj:probability a owl:DatatypeProperty ;
    rdfs:label "概率"@zh-Hans ;
    rdfs:comment "probability"@en ;
    rdfs:range xsd:decimal ;
    .

yj:stepOrder a owl:DatatypeProperty ;
    rdfs:label "步骤序号"@zh-Hans ;
    rdfs:comment "step order"@en ;
    rdfs:range xsd:integer ;
    .

yj:stepDescription a owl:DatatypeProperty ;
    rdfs:label "步骤说明"@zh-Hans ;
    rdfs:comment "step description"@en ;
    .

yj:nayinStemBranch a owl:DatatypeProperty ;
    rdfs:label "纳甲干支"@zh-Hans ;
    rdfs:comment "Najia stem-branch"@en ;
    .

yj:liuQin a owl:DatatypeProperty ;
    rdfs:label "六亲"@zh-Hans ;
    rdfs:comment "six relations"@en ;
    .

yj:liuShen a owl:DatatypeProperty ;
    rdfs:label "六神"@zh-Hans ;
    rdfs:comment "six spirits"@en ;
    .

yj:externalId a owl:DatatypeProperty ;
    rdfs:label "外部标识"@zh-Hans ;
    rdfs:comment "external identifier"@en ;
    .

# === Bagua (8 Trigrams) ===
yj:tri_qian a yj:Trigram ;
    rdfs:label "乾"@zh-Hans ;
    skos:altLabel "天"@zh-Hans ;
    rdfs:comment "八卦之乾，五行属金，象为天/健"@zh-Hans ;
    yj:name "乾"@zh-Hans ;
    yj:trigramName "乾"@zh-Hans ;
    yj:wuxing "金"@zh-Hans ;
    yj:symbol "☰"@zh-Hans ;
    yj:sequenceNumber "1"^^xsd:integer .

yj:tri_dui a yj:Trigram ;
    rdfs:label "兑"@zh-Hans ;
    skos:altLabel "泽"@zh-Hans ;
    rdfs:comment "八卦之兑，五行属金，象为泽/悦"@zh-Hans ;
    yj:name "兑"@zh-Hans ;
    yj:trigramName "兑"@zh-Hans ;
    yj:wuxing "金"@zh-Hans ;
    yj:symbol "☱"@zh-Hans ;
    yj:sequenceNumber "2"^^xsd:integer .

yj:tri_li a yj:Trigram ;
    rdfs:label "离"@zh-Hans ;
    skos:altLabel "火"@zh-Hans ;
    rdfs:comment "八卦之离，五行属火，象为火/明"@zh-Hans ;
    yj:name "离"@zh-Hans ;
    yj:trigramName "离"@zh-Hans ;
    yj:wuxing "火"@zh-Hans ;
    yj:symbol "☲"@zh-Hans ;
    yj:sequenceNumber "3"^^xsd:integer .

yj:tri_zhen a yj:Trigram ;
    rdfs:label "震"@zh-Hans ;
    skos:altLabel "雷"@zh-Hans ;
    rdfs:comment "八卦之震，五行属木，象为雷/动"@zh-Hans ;
    yj:name "震"@zh-Hans ;
    yj:trigramName "震"@zh-Hans ;
    yj:wuxing "木"@zh-Hans ;
    yj:symbol "☳"@zh-Hans ;
    yj:sequenceNumber "4"^^xsd:integer .

yj:tri_xun a yj:Trigram ;
    rdfs:label "巽"@zh-Hans ;
    skos:altLabel "风"@zh-Hans ;
    rdfs:comment "八卦之巽，五行属木，象为风/入"@zh-Hans ;
    yj:name "巽"@zh-Hans ;
    yj:trigramName "巽"@zh-Hans ;
    yj:wuxing "木"@zh-Hans ;
    yj:symbol "☴"@zh-Hans ;
    yj:sequenceNumber "5"^^xsd:integer .

yj:tri_kan a yj:Trigram ;
    rdfs:label "坎"@zh-Hans ;
    skos:altLabel "水"@zh-Hans ;
    rdfs:comment "八卦之坎，五行属水，象为水/险"@zh-Hans ;
    yj:name "坎"@zh-Hans ;
    yj:trigramName "坎"@zh-Hans ;
    yj:wuxing "水"@zh-Hans ;
    yj:symbol "☵"@zh-Hans ;
    yj:sequenceNumber "6"^^xsd:integer .

yj:tri_gen a yj:Trigram ;
    rdfs:label "艮"@zh-Hans ;
    skos:altLabel "山"@zh-Hans ;
    rdfs:comment "八卦之艮，五行属土，象为山/止"@zh-Hans ;
    yj:name "艮"@zh-Hans ;
    yj:trigramName "艮"@zh-Hans ;
    yj:wuxing "土"@zh-Hans ;
    yj:symbol "☶"@zh-Hans ;
    yj:sequenceNumber "7"^^xsd:integer .

yj:tri_kun a yj:Trigram ;
    rdfs:label "坤"@zh-Hans ;
    skos:altLabel "地"@zh-Hans ;
    rdfs:comment "八卦之坤，五行属土，象为地/顺"@zh-Hans ;
    yj:name "坤"@zh-Hans ;
    yj:trigramName "坤"@zh-Hans ;
    yj:wuxing "土"@zh-Hans ;
    yj:symbol "☷"@zh-Hans ;
    yj:sequenceNumber "8"^^xsd:integer .

# === 64 Hexagrams ===
yj:gua_00 a yj:Hexagram ;
    rdfs:label "乾"@zh-Hans ;
    skos:altLabel "1·乾"@zh-Hans ;
    rdfs:comment "第1卦 ䷀，乾上乾下，五行属金"@zh-Hans ;
    yj:name "乾"@zh-Hans ;
    yj:guaName "乾"@zh-Hans ;
    yj:sequenceNumber "1"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "乾：元、享、利、贞。"@zh-Hans ;
    yj:tuanText "大哉乾元，万物资始，乃统天。云行雨施，品物流形。大明终始，六位时成，时乘六龙以御天。乾道变化，各正性命。保合大和，乃利贞。首出庶物，万国咸宁。"@zh-Hans ;
    yj:xiangText "天行健，君子以自强不息。潜龙勿用，阳在下也。见龙在田，德施普也。终日乾乾，反复道也。或跃在渊，进无咎也。飞龙在天，大人造也。亢龙有悔，盈不可久也。"@zh-Hans .

yj:gua_01 a yj:Hexagram ;
    rdfs:label "坤"@zh-Hans ;
    skos:altLabel "2·坤"@zh-Hans ;
    rdfs:comment "第2卦 ䷁，坤上坤下，五行属土"@zh-Hans ;
    yj:name "坤"@zh-Hans ;
    yj:guaName "坤"@zh-Hans ;
    yj:sequenceNumber "2"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "坤：元亨，利牝马之贞。"@zh-Hans ;
    yj:tuanText "至哉坤元，万物资生，乃顺承天。坤厚载物，德合无疆。含宏光大，品物咸亨。牝马地类，行地无疆，柔顺利贞。君子攸行。先迷失道，后顺得常。西南得朋，乃与类行。东北丧朋，乃终有庆。马君云：孟秋之月，阴气始着，而坤之位，同类相得，故“西南得朋”。孟春之月，阳气始着，阴始从阳，失其党类，故“东北丧朋”。失之甚矣。而荀君以为阴起于午，至申三阴，得坤一体，故曰“西南得朋”。阳起于子，至寅三阳，丧坤一体，故曰“东北丧朋”。就如荀说，从午至申，得坤一体，故曰“西南得朋”。阳起于子，至寅三阳，丧坤一体，故曰“东北丧朋”就如荀说，从午至申，经当言南西得朋；子至寅，当言北东丧朋。以乾变坤，而言丧朋，经以乾卦为丧耶？此何异于马也。安贞之吉，应地无疆。"@zh-Hans ;
    yj:xiangText "地势坤，君子以厚德载物。履霜坚冰，阴始凝也。驯致其道，至坚冰也。六二之动，直以方也。不习无不利，地道光也。含章可贞，以时发也。或从王事，知光大也。括囊，无咎，慎不害也。黄裳，元吉，文在中也。龙战于野，其道穷也。用六，永贞，以大终也。"@zh-Hans .

yj:gua_02 a yj:Hexagram ;
    rdfs:label "屯"@zh-Hans ;
    skos:altLabel "3·屯"@zh-Hans ;
    rdfs:comment "第3卦 ䷂，坎上震下，五行属水"@zh-Hans ;
    yj:name "屯"@zh-Hans ;
    yj:guaName "屯"@zh-Hans ;
    yj:sequenceNumber "3"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "屯：元、亨、利、贞。"@zh-Hans ;
    yj:tuanText "屯，刚柔始交而难生。动乎险中，大亨贞。雷雨之动满形，天造草昧。宜建侯而不宁。"@zh-Hans ;
    yj:xiangText "云雷，屯。君子以经论。虽盘桓，志行正也。以贵下贱，大得民也。六二之难，乘刚也。十年乃字，反常也。即鹿无虞，以从禽也。君子舍之，往吝穷也。求而往，明也。屯其膏，施未光也。泣血涟如，何可长也。"@zh-Hans .

yj:gua_03 a yj:Hexagram ;
    rdfs:label "蒙"@zh-Hans ;
    skos:altLabel "4·蒙"@zh-Hans ;
    rdfs:comment "第4卦 ䷃，艮上坎下，五行属山"@zh-Hans ;
    yj:name "蒙"@zh-Hans ;
    yj:guaName "蒙"@zh-Hans ;
    yj:sequenceNumber "4"^^xsd:integer ;
    yj:wuxing "山"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "蒙：亨。"@zh-Hans ;
    yj:tuanText "蒙，山下有险，险而止，蒙。蒙亨，以亨行时中也。匪我求童蒙，童蒙求我，志应也。初筮告，以刚中也。再三渎，渎则不告，渎蒙也。蒙以养正，圣功也。"@zh-Hans ;
    yj:xiangText "山下出泉，蒙。君子以果行育德。利用刑人，以正法也。勿用娶女，行不顺也。童蒙之吉，顺以巽也。利用御寇，上下顺也。"@zh-Hans .

yj:gua_04 a yj:Hexagram ;
    rdfs:label "需"@zh-Hans ;
    skos:altLabel "5·需"@zh-Hans ;
    rdfs:comment "第5卦 ䷄，坎上乾下，五行属水"@zh-Hans ;
    yj:name "需"@zh-Hans ;
    yj:guaName "需"@zh-Hans ;
    yj:sequenceNumber "5"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "需：有孚，光亨，贞吉。"@zh-Hans ;
    yj:tuanText "需，须也。险在前也，刚健而不陷。其义不困穷矣。需，有孚，光亨，贞吉。位乎天位，以正中也。利涉大川，往有功也。"@zh-Hans ;
    yj:xiangText "云上于天，需。君子以饮食宴乐。需于郊，不犯难行也。利用恒无咎，未失常也。需于沙，衍在中也。虽小有言，以吉终也。需于泥，灾在外也。自我致寇，敬慎不败也。需于血，顺以听也。酒食贞吉，以中正也。不速之客来，敬之终吉。虽不当位，未大失也。"@zh-Hans .

yj:gua_05 a yj:Hexagram ;
    rdfs:label "讼"@zh-Hans ;
    skos:altLabel "6·讼"@zh-Hans ;
    rdfs:comment "第6卦 ䷅，乾上坎下，五行属天"@zh-Hans ;
    yj:name "讼"@zh-Hans ;
    yj:guaName "讼"@zh-Hans ;
    yj:sequenceNumber "6"^^xsd:integer ;
    yj:wuxing "天"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "讼：有孚，"@zh-Hans ;
    yj:tuanText "讼，上刚下险，险而健，讼。讼，有孚窒惕，中吉，刚来而得中也。终凶，讼不可成也。利见大人，尚中正也。不利涉大川，入于渊也。"@zh-Hans ;
    yj:xiangText "天与水违行，讼。君子以作事谋始。不永所事，讼不可长也。虽小有言，其辩明也。不克讼，归逋窜也。自下讼上，患至掇也。食旧德，从上吉也。复即命渝，安贞吉，不失也。以讼受服，亦不足敬也。"@zh-Hans .

yj:gua_06 a yj:Hexagram ;
    rdfs:label "师"@zh-Hans ;
    skos:altLabel "7·师"@zh-Hans ;
    rdfs:comment "第7卦 ䷆，坤上坎下，五行属地"@zh-Hans ;
    yj:name "师"@zh-Hans ;
    yj:guaName "师"@zh-Hans ;
    yj:sequenceNumber "7"^^xsd:integer ;
    yj:wuxing "地"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "师：贞，丈人吉，无咎。"@zh-Hans ;
    yj:tuanText "师，众也。贞，正也。能以众正，可以王矣。刚中而应，行险而顺，以此毒天下，而民从之，吉又何咎矣。"@zh-Hans ;
    yj:xiangText "地中有水，师。君子以容民畜众。师或舆尸，大无功也。左次无咎，未失常也。长子帅师，以中行也。弟子舆尸，使不当也。大君有命，以正功也。小人勿用，必乱邦也。"@zh-Hans .

yj:gua_07 a yj:Hexagram ;
    rdfs:label "比"@zh-Hans ;
    skos:altLabel "8·比"@zh-Hans ;
    rdfs:comment "第8卦 ䷇，坎上坤下，五行属水"@zh-Hans ;
    yj:name "比"@zh-Hans ;
    yj:guaName "比"@zh-Hans ;
    yj:sequenceNumber "8"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "比：吉。"@zh-Hans ;
    yj:tuanText "比，吉也。比辅也。下顺从也。原筮元永贞，无咎，以刚中也。不宁方来，上下应也。后夫凶，其道穷也。"@zh-Hans ;
    yj:xiangText "地上有水，比。先王以建万国，亲诸侯。比之初六，有它吉也。比之自内，不自失也。比之匪人，不亦伤乎。外比于贤，以从上也。显比之吉，位正中也。舍逆取顺，失前禽也。邑人不戒，上使中也。比之无首，无所终也。"@zh-Hans .

yj:gua_08 a yj:Hexagram ;
    rdfs:label "小畜"@zh-Hans ;
    skos:altLabel "9·小畜"@zh-Hans ;
    rdfs:comment "第9卦 ䷈，巽上乾下，五行属木"@zh-Hans ;
    yj:name "小畜"@zh-Hans ;
    yj:guaName "小畜"@zh-Hans ;
    yj:sequenceNumber "9"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "小畜：亨。"@zh-Hans ;
    yj:tuanText "小畜，柔得位而上下应之，曰小畜。健而巽，刚中而志行，乃亨。密云不雨，尚往也。自我西郊，施未行也。"@zh-Hans ;
    yj:xiangText "风行天上，小畜。君子以懿文德。牵复在中，亦不自失也。夫妻反目，不能正室也。有孚惕出，上合志也。有孚挛如，不独富也。既雨既处，得积载也。君子征凶，有所疑也。"@zh-Hans .

yj:gua_09 a yj:Hexagram ;
    rdfs:label "履"@zh-Hans ;
    skos:altLabel "10·履"@zh-Hans ;
    rdfs:comment "第10卦 ䷉，乾上兑下，五行属金"@zh-Hans ;
    yj:name "履"@zh-Hans ;
    yj:guaName "履"@zh-Hans ;
    yj:sequenceNumber "10"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "履：履虎尾，不咥人。亨，利贞。"@zh-Hans ;
    yj:tuanText "履，柔履刚也。说而应乎乾，是以履虎尾，不咥人。亨。刚中正，履帝位而不疚，光明也。"@zh-Hans ;
    yj:xiangText "上天下泽，履。君子以辩上下，定民志。素履之往，独行愿也。幽人贞吉，中不自乱也。眇而视，不足以有明也。跛而履，不足以与行也。咥人之凶，位不当也。武人为于大君，志刚也。愬愬终吉，志行也。夬履贞厉，位正当也。元吉在上，大有庆也。"@zh-Hans .

yj:gua_10 a yj:Hexagram ;
    rdfs:label "泰"@zh-Hans ;
    skos:altLabel "11·泰"@zh-Hans ;
    rdfs:comment "第11卦 ䷊，坤上乾下，五行属地"@zh-Hans ;
    yj:name "泰"@zh-Hans ;
    yj:guaName "泰"@zh-Hans ;
    yj:sequenceNumber "11"^^xsd:integer ;
    yj:wuxing "地"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "泰：小往大来，吉、亨。"@zh-Hans ;
    yj:tuanText "泰，小往大来，吉、亨。则是天地交而万物通也；上下交而其志同也；内阳而外阴，内健而外顺；内君子而外小人，君子道长，小人道消也。"@zh-Hans ;
    yj:xiangText "天地交泰，后以财成天地之道，辅相天地之宜，以左右民。拔茅征吉，志在外也。包荒，得尚于中行，以光大也。无平不陂，天地际也。翩翩不富，皆失实也。不戒以孚，中心愿也。以祉元吉，中以行愿也。城复于隍，其命乱也。"@zh-Hans .

yj:gua_11 a yj:Hexagram ;
    rdfs:label "否"@zh-Hans ;
    skos:altLabel "12·否"@zh-Hans ;
    rdfs:comment "第12卦 ䷋，乾上坤下，五行属金"@zh-Hans ;
    yj:name "否"@zh-Hans ;
    yj:guaName "否"@zh-Hans ;
    yj:sequenceNumber "12"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "否：否之匪人，不利君子贞，大往小来。"@zh-Hans ;
    yj:tuanText "否匪人，不利君子贞。大往小来，则是天地不交而万物不通也。上下不交而天下无邦也。内阴而外阳，内柔而外刚，内小人而外君子。小人道长，君子道消也。"@zh-Hans ;
    yj:xiangText "天地不交，否。君子以俭德辟难，不可荣以禄。拔茅贞吉，志在君也。大人否享，不乱群也。有命无咎，志行也。大人之吉，位正当也。否终则倾，何可长也。"@zh-Hans .

yj:gua_12 a yj:Hexagram ;
    rdfs:label "同人"@zh-Hans ;
    skos:altLabel "13·同人"@zh-Hans ;
    rdfs:comment "第13卦 ䷌，乾上离下，五行属火"@zh-Hans ;
    yj:name "同人"@zh-Hans ;
    yj:guaName "同人"@zh-Hans ;
    yj:sequenceNumber "13"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "同人：同人于野，亨。"@zh-Hans ;
    yj:tuanText "同人，柔得位得中，而应乎乾，曰同人。文明以健，中正而应，君子正也。唯君子为能通天下之志。"@zh-Hans ;
    yj:xiangText "天与火，同人。君子以类族辩物。出门同人，又谁咎也。同人于宗，吝道也。伏戎于莽，敌刚也。三岁不兴，安行也。乘其庸，义弗克也。其吉，则困而反则也。同人之先，以中直也。大师相遇，言相克也。同人于郊，志未得也。"@zh-Hans .

yj:gua_13 a yj:Hexagram ;
    rdfs:label "大有"@zh-Hans ;
    skos:altLabel "14·大有"@zh-Hans ;
    rdfs:comment "第14卦 ䷍，离上乾下，五行属火"@zh-Hans ;
    yj:name "大有"@zh-Hans ;
    yj:guaName "大有"@zh-Hans ;
    yj:sequenceNumber "14"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "大有：元亨。"@zh-Hans ;
    yj:tuanText "大有，柔得尊位，大中而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以元亨。"@zh-Hans ;
    yj:xiangText "火在天上，大有。君子以遏恶扬善，顺天休命。大有初九，无交害也。大车以载，积中不败也。公用亨于天子，小人害也。匪其尫，无咎，明辩折也。厥孚交如，信以发志也。威如之吉，易而无备也。大有上吉，自天右也。"@zh-Hans .

yj:gua_14 a yj:Hexagram ;
    rdfs:label "谦"@zh-Hans ;
    skos:altLabel "15·谦"@zh-Hans ;
    rdfs:comment "第15卦 ䷎，坤上艮下，五行属地"@zh-Hans ;
    yj:name "谦"@zh-Hans ;
    yj:guaName "谦"@zh-Hans ;
    yj:sequenceNumber "15"^^xsd:integer ;
    yj:wuxing "地"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "谦：亨。"@zh-Hans ;
    yj:tuanText "谦亨。天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦，尊而光，卑而不可逾，君子之终也。"@zh-Hans ;
    yj:xiangText "地中有山，谦。君子以捋多益寡，称物平施。谦谦君子，卑以自牧也。鸣谦贞吉，中心得也。劳谦君子，万民服也。无不利捴谦，不违则也。利用侵伐，征不服也。鸣谦，志未得也，可用行师，征邑国也。"@zh-Hans .

yj:gua_15 a yj:Hexagram ;
    rdfs:label "豫"@zh-Hans ;
    skos:altLabel "16·豫"@zh-Hans ;
    rdfs:comment "第16卦 ䷏，震上坤下，五行属木"@zh-Hans ;
    yj:name "豫"@zh-Hans ;
    yj:guaName "豫"@zh-Hans ;
    yj:sequenceNumber "16"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "豫：利建侯、行师。"@zh-Hans ;
    yj:tuanText "豫，刚应而志行，△侯果曰四为卦主，五阴应之，刚志大行，故曰“刚应而志行”。顺以动，豫。豫顺以动，故天地如之，而况建侯行师乎！天地以顺动，故日月不过，而四时不忒。圣人以顺动，则刑罚清而民服。豫之时义大矣哉。"@zh-Hans ;
    yj:xiangText "雷出地奋，豫。先王以作乐崇德，殷荐之上帝，以配祖考。初六鸣豫，志穷凶也。不终日，贞吉，以中正也。由豫，大有得，志大行也。六五贞疾，乘刚也。恒不死，中未亡也。冥豫在上，何可长也？"@zh-Hans .

yj:gua_16 a yj:Hexagram ;
    rdfs:label "随"@zh-Hans ;
    skos:altLabel "17·随"@zh-Hans ;
    rdfs:comment "第17卦 ䷐，兑上震下，五行属金"@zh-Hans ;
    yj:name "随"@zh-Hans ;
    yj:guaName "随"@zh-Hans ;
    yj:sequenceNumber "17"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "随：元、亨、利、贞，无咎。"@zh-Hans ;
    yj:tuanText "随，刚来而下柔，动而说，随。大亨贞，无咎。而天下随时，随之时义大矣哉。"@zh-Hans ;
    yj:xiangText "泽中有雷，随。君子以向晦入宴息。官有渝，从正吉也。出门交有功，不失也。系小子，弗兼与也。系丈夫，志舍下也。随有获，其义凶也。有孚在道，明功也。孚于嘉，吉，位正中也。拘系之，上穷也。"@zh-Hans .

yj:gua_17 a yj:Hexagram ;
    rdfs:label "蛊"@zh-Hans ;
    skos:altLabel "18·蛊"@zh-Hans ;
    rdfs:comment "第18卦 ䷑，艮上巽下，五行属土"@zh-Hans ;
    yj:name "蛊"@zh-Hans ;
    yj:guaName "蛊"@zh-Hans ;
    yj:sequenceNumber "18"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "蛊：元亨。"@zh-Hans ;
    yj:tuanText "蛊，刚上而柔下，巽而止，蛊。蛊元亨，而天下治也。利涉大川，往有事也。先甲三日，后甲三日，终则有始，天行也。"@zh-Hans ;
    yj:xiangText "山下有风，蛊。君子以振民育德。干父之蛊，意承考也。裕父之蛊，往未得也。干父用誉，承以德也。不事王侯，志可则也。"@zh-Hans .

yj:gua_18 a yj:Hexagram ;
    rdfs:label "临"@zh-Hans ;
    skos:altLabel "19·临"@zh-Hans ;
    rdfs:comment "第19卦 ䷒，坤上兑下，五行属土"@zh-Hans ;
    yj:name "临"@zh-Hans ;
    yj:guaName "临"@zh-Hans ;
    yj:sequenceNumber "19"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "临：元、亨、利、贞。"@zh-Hans ;
    yj:tuanText "临，刚浸而长。说而顺，刚中而应。大亨以正，天之道也。至于八月有凶，消不久也。"@zh-Hans ;
    yj:xiangText "泽上有地，临。君子以教思无穷，容保民无疆。咸临贞吉，志行正也。咸临吉，无不利，未顺命也。至临无咎，位当也。敦临之吉，志在内也。"@zh-Hans .

yj:gua_19 a yj:Hexagram ;
    rdfs:label "观"@zh-Hans ;
    skos:altLabel "20·观"@zh-Hans ;
    rdfs:comment "第20卦 ䷓，巽上坤下，五行属木"@zh-Hans ;
    yj:name "观"@zh-Hans ;
    yj:guaName "观"@zh-Hans ;
    yj:sequenceNumber "20"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "观：盥而不荐，有孚颙若。"@zh-Hans ;
    yj:tuanText "大观在上，顺而巽，中正以观天下。观，盥而不荐，有孚颙若，下观而化也。观天之神道，而四时不忒。圣人神道设教，而天下服矣。"@zh-Hans ;
    yj:xiangText "风行地上，观。先王以省方观民设教。初六童观，小人道也。窥观女贞，亦可丑也。观我生进退，未失道也。观国之光，尚宾也。观我生，观民也。观其生，志未平也。"@zh-Hans .

yj:gua_20 a yj:Hexagram ;
    rdfs:label "噬嗑"@zh-Hans ;
    skos:altLabel "21·噬嗑"@zh-Hans ;
    rdfs:comment "第21卦 ䷔，离上震下，五行属火"@zh-Hans ;
    yj:name "噬嗑"@zh-Hans ;
    yj:guaName "噬嗑"@zh-Hans ;
    yj:sequenceNumber "21"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "噬嗑：享，利用狱。"@zh-Hans ;
    yj:tuanText "颐中有物，曰噬嗑。噬嗑而亨。刚柔分，动而明，雷电合而章。柔得中而上行，虽不当位，利用狱也。"@zh-Hans ;
    yj:xiangText "雷电，噬嗑。先王以明罚敕法。屦校灭趾，不行也。噬肤灭鼻，乘刚也。遇毒，位不当也。贞厉无咎，得当也。何校灭耳，聪不明也。"@zh-Hans .

yj:gua_21 a yj:Hexagram ;
    rdfs:label "贲"@zh-Hans ;
    skos:altLabel "22·贲"@zh-Hans ;
    rdfs:comment "第22卦 ䷕，艮上离下，五行属土"@zh-Hans ;
    yj:name "贲"@zh-Hans ;
    yj:guaName "贲"@zh-Hans ;
    yj:sequenceNumber "22"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "贲：亨。"@zh-Hans ;
    yj:tuanText "贲亨，柔来而文刚，故亨。分刚上而文柔，故小利有攸往。天文也。文明以止，人文也。观乎天文，以察时变。观乎人文，以化成天下。"@zh-Hans ;
    yj:xiangText "山下有火，贲。君子以明庶政，无敢折狱。舍车而徒，义弗乘也。六四，当位疑也。匪寇婚媾，终无尤也。六五之吉，有喜也。白贲无咎，上得志也。"@zh-Hans .

yj:gua_22 a yj:Hexagram ;
    rdfs:label "剥"@zh-Hans ;
    skos:altLabel "23·剥"@zh-Hans ;
    rdfs:comment "第23卦 ䷖，艮上坤下，五行属土"@zh-Hans ;
    yj:name "剥"@zh-Hans ;
    yj:guaName "剥"@zh-Hans ;
    yj:sequenceNumber "23"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "剥：不利有攸往。"@zh-Hans ;
    yj:tuanText "剥，剥也。柔变刚也。不利有攸往，小人长也。顺而止之，观象也。君子尚消息盈虚，天行也。"@zh-Hans ;
    yj:xiangText "山附于地，剥。上以厚下安宅。剥床以足，以灭下也。剥床以辨，未有与也。剥床以肤，切近灾也。以宫人宠，终无尤也。君子德车，民所载也。小人剥庐，终不可用也。"@zh-Hans .

yj:gua_23 a yj:Hexagram ;
    rdfs:label "复"@zh-Hans ;
    skos:altLabel "24·复"@zh-Hans ;
    rdfs:comment "第24卦 ䷗，坤上震下，五行属土"@zh-Hans ;
    yj:name "复"@zh-Hans ;
    yj:guaName "复"@zh-Hans ;
    yj:sequenceNumber "24"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "复：亨。"@zh-Hans ;
    yj:tuanText "复亨，刚反动，而以顺行，是以出入无疾，朋来无咎。反复其道，七日来复，天行也。利有攸往，刚长也。复，其见天地之心乎。"@zh-Hans ;
    yj:xiangText "雷在地中，复。先王以至日闭关，商旅不行，后不省方。不远之复，以修身也。频复之厉，义无咎也。迷复之凶，反君道也。"@zh-Hans .

yj:gua_24 a yj:Hexagram ;
    rdfs:label "无妄"@zh-Hans ;
    skos:altLabel "25·无妄"@zh-Hans ;
    rdfs:comment "第25卦 ䷘，乾上震下，五行属金"@zh-Hans ;
    yj:name "无妄"@zh-Hans ;
    yj:guaName "无妄"@zh-Hans ;
    yj:sequenceNumber "25"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "无妄。"@zh-Hans ;
    yj:tuanText "无妄，刚自外来而为主于内。动而健，刚中而应。大享以正，天之命也。其匪正有眚，不利有攸往。无妄之往，何之矣。天命不右，行矣哉。"@zh-Hans ;
    yj:xiangText "天下雷行，物与无妄，先王以茂对时育万物。无妄之往，得志也。不耕获，未富也。可贞无咎，固有之也。无妄之药，不可试也。无妄之行，穷之灾也。"@zh-Hans .

yj:gua_25 a yj:Hexagram ;
    rdfs:label "大畜"@zh-Hans ;
    skos:altLabel "26·大畜"@zh-Hans ;
    rdfs:comment "第26卦 ䷙，艮上乾下，五行属土"@zh-Hans ;
    yj:name "大畜"@zh-Hans ;
    yj:guaName "大畜"@zh-Hans ;
    yj:sequenceNumber "26"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "大畜：利贞。"@zh-Hans ;
    yj:tuanText "大畜，刚健笃实，辉光日新。其德刚上而尚贤。能健止，大正也。不家食吉，养贤也。利涉大川，应乎天也。"@zh-Hans ;
    yj:xiangText "天在山中，大畜。君子以多志前言往行，以畜其德。有厉，利已，不犯灾也。舆说腹，中无尤也。六四元吉，有喜也。六五之吉，有庆也。何天之衢，道大行也。"@zh-Hans .

yj:gua_26 a yj:Hexagram ;
    rdfs:label "颐"@zh-Hans ;
    skos:altLabel "27·颐"@zh-Hans ;
    rdfs:comment "第27卦 ䷚，艮上震下，五行属土"@zh-Hans ;
    yj:name "颐"@zh-Hans ;
    yj:guaName "颐"@zh-Hans ;
    yj:sequenceNumber "27"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "颐：贞吉。"@zh-Hans ;
    yj:tuanText "颐贞吉，养正则吉也。观颐，观其所养也。自求口实，观其自养也。天地养万物，圣人养贤以及万民。颐之时大矣哉。△天地养物，圣人养贤以及万民，人非颐不生，故大矣。"@zh-Hans ;
    yj:xiangText "山下有雷，颐。君子以慎言语，节饮食。观我朵颐亦不足贵也。六二征凶，行失类也。十年勿用，道大悖也。颠颐之吉，上施光也。居贞之吉，顺以从上也。"@zh-Hans .

yj:gua_27 a yj:Hexagram ;
    rdfs:label "大过"@zh-Hans ;
    skos:altLabel "28·大过"@zh-Hans ;
    rdfs:comment "第28卦 ䷛，兑上巽下，五行属金"@zh-Hans ;
    yj:name "大过"@zh-Hans ;
    yj:guaName "大过"@zh-Hans ;
    yj:sequenceNumber "28"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "大过：栋桡。"@zh-Hans ;
    yj:tuanText "大过，大者过也。栋桡，本末弱也。刚过而中，巽而说行，利有攸往，乃亨。大过之时大矣哉。"@zh-Hans ;
    yj:xiangText "泽灭木，大过。君子以独立不惧，遁世无闷。藉用白茅，柔在下也。老夫女妻，过以相与也。栋隆之吉，不桡乎下也。枯杨生华，何可久也。老妇士夫，亦可丑也。过涉之凶，不可咎也。"@zh-Hans .

yj:gua_28 a yj:Hexagram ;
    rdfs:label "坎"@zh-Hans ;
    skos:altLabel "29·坎"@zh-Hans ;
    rdfs:comment "第29卦 ䷜，坎上坎下，五行属水"@zh-Hans ;
    yj:name "坎"@zh-Hans ;
    yj:guaName "坎"@zh-Hans ;
    yj:sequenceNumber "29"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "坎：习坎，有孚，唯心亨，行有尚。"@zh-Hans ;
    yj:tuanText "习坎，重险也。水流而不盈，行险而不失其信。维心亨，乃以刚中也。行有尚，往有功也。天险不可升也，地险山川丘陵也。王公设险以守其国，险之时用大矣哉。"@zh-Hans ;
    yj:xiangText "水洊至，习坎。君子以常德行习教事。习坎入坎，失道凶也。求小得，未出中也。来之坎坎，终无功也。樽酒簋，刚柔际也。坎不盈，中未光大也。上六失道，凶三岁也。案《周礼》：王之外朝，左九棘，右九棘，面三槐，司寇公卿议狱于其下。害人者，加明刑。任之以事。上罪三年而舍，中罪二年而舍，下罪一年而舍也。"@zh-Hans .

yj:gua_29 a yj:Hexagram ;
    rdfs:label "离"@zh-Hans ;
    skos:altLabel "30·离"@zh-Hans ;
    rdfs:comment "第30卦 ䷝，离上离下，五行属火"@zh-Hans ;
    yj:name "离"@zh-Hans ;
    yj:guaName "离"@zh-Hans ;
    yj:sequenceNumber "30"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "离：利贞，亨。"@zh-Hans ;
    yj:tuanText "离，丽也。日月丽乎天。百谷草木丽乎也。重明以丽乎正，乃化成天下。柔丽乎中正，故亨。是以畜牝牛吉也。"@zh-Hans ;
    yj:xiangText "明两作离，大人以继明照于四方。履错之敬，以辟咎也。日昃之离，何可久也。突如，其来如，无所容也。六五之吉，离王公也。王用出征，以正邦也。"@zh-Hans .

yj:gua_30 a yj:Hexagram ;
    rdfs:label "咸"@zh-Hans ;
    skos:altLabel "31·咸"@zh-Hans ;
    rdfs:comment "第31卦 ䷞，兑上艮下，五行属金"@zh-Hans ;
    yj:name "咸"@zh-Hans ;
    yj:guaName "咸"@zh-Hans ;
    yj:sequenceNumber "31"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "咸：亨，利贞，取女吉。"@zh-Hans ;
    yj:tuanText "咸，感也。柔上而刚下，二气感应以相与。止而说，男下女，是以亨利贞，取女吉也。天地感而万物化生，圣人感人心而天下和平。观其所感，而天地万物之情可见矣。"@zh-Hans ;
    yj:xiangText "山上有泽，咸。君子以虚受人。咸其股，亦不处也。志在随人，所执下也。贞吉悔亡，未感害也。憧憧往来，未光大也。咸其脢，志末也。咸其辅颊舌，媵口说也。"@zh-Hans .

yj:gua_31 a yj:Hexagram ;
    rdfs:label "恒"@zh-Hans ;
    skos:altLabel "32·恒"@zh-Hans ;
    rdfs:comment "第32卦 ䷟，震上巽下，五行属木"@zh-Hans ;
    yj:name "恒"@zh-Hans ;
    yj:guaName "恒"@zh-Hans ;
    yj:sequenceNumber "32"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "恒：亨，无咎，利贞。"@zh-Hans ;
    yj:tuanText "恒，久也。刚上而柔下，雷风相与，巽而动，刚柔皆应，恒。恒亨，无咎，利贞，久于其道也。天地之道，恒久而不已也。利有攸往，终则有始也。日月得天而能久照，四时变化而久成。圣人久于其道，而天下化成。观其所恒，而天地万物之情可见矣。"@zh-Hans ;
    yj:xiangText "雷风，恒。君子以立不易方。浚恒之凶，始求深也。九二悔亡，能久中也。不恒其德，无所容也。妇人贞吉，从一而终也。夫子制义，从妇凶也。"@zh-Hans .

yj:gua_32 a yj:Hexagram ;
    rdfs:label "遁"@zh-Hans ;
    skos:altLabel "33·遁"@zh-Hans ;
    rdfs:comment "第33卦 ䷠，乾上艮下，五行属金"@zh-Hans ;
    yj:name "遁"@zh-Hans ;
    yj:guaName "遁"@zh-Hans ;
    yj:sequenceNumber "33"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "遁：亨。"@zh-Hans ;
    yj:tuanText "遁亨，遁而亨也。刚当位而应，与时行也。小利贞，浸而长也。遁之时义大矣哉。"@zh-Hans ;
    yj:xiangText "天下有山，遁。君子以远小人，不恶而严。遁尾之厉，不往何灾也。执用黄牛，固志也。系遁之厉，有疾惫也。畜臣妾吉，不可大事也。君子好遁，小人否也。嘉遁贞吉，以正志也。肥遁无不利，无所疑也。"@zh-Hans .

yj:gua_33 a yj:Hexagram ;
    rdfs:label "大壮"@zh-Hans ;
    skos:altLabel "34·大壮"@zh-Hans ;
    rdfs:comment "第34卦 ䷡，震上乾下，五行属木"@zh-Hans ;
    yj:name "大壮"@zh-Hans ;
    yj:guaName "大壮"@zh-Hans ;
    yj:sequenceNumber "34"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "大壮：利贞。"@zh-Hans ;
    yj:tuanText "大壮，大者壮也。刚以动，故壮。大壮利贞，大者正也。正大而天地之情可见矣。"@zh-Hans ;
    yj:xiangText "雷在天上，大壮。君子以非礼弗履。壮于趾，其孚穷也。小人用壮，君子罔也。丧羊于易，位不当也。不能退，不能遂，不详也。艰则吉，咎不长也。"@zh-Hans .

yj:gua_34 a yj:Hexagram ;
    rdfs:label "晋"@zh-Hans ;
    skos:altLabel "35·晋"@zh-Hans ;
    rdfs:comment "第35卦 ䷢，离上坤下，五行属火"@zh-Hans ;
    yj:name "晋"@zh-Hans ;
    yj:guaName "晋"@zh-Hans ;
    yj:sequenceNumber "35"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "晋：康侯用锡马蕃庶，昼日三接。"@zh-Hans ;
    yj:tuanText "晋，进也。明出地上，顺而丽乎大明。柔进而上行，是以康侯用锡马蕃庶。昼日三接也。"@zh-Hans ;
    yj:xiangText "明出地上。晋。君子以自昭明德。晋如，摧如，独行正也。裕无咎，未受命也。受兹介福，以中正也。众允之志，上行也。硕鼠贞厉，位不当也。矢得勿恤，往有庆也。惟用伐邑，道未光也。"@zh-Hans .

yj:gua_35 a yj:Hexagram ;
    rdfs:label "明夷"@zh-Hans ;
    skos:altLabel "36·明夷"@zh-Hans ;
    rdfs:comment "第36卦 ䷣，坤上离下，五行属土"@zh-Hans ;
    yj:name "明夷"@zh-Hans ;
    yj:guaName "明夷"@zh-Hans ;
    yj:sequenceNumber "36"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "明夷：利艰贞。"@zh-Hans ;
    yj:tuanText "明入地中，明夷。内文明而外柔顺，以蒙大难，文王以之。利艰贞，晦其明也。内难而能正其志，箕子以之。"@zh-Hans ;
    yj:xiangText "明入地中，明夷。君子以莅众，用晦而明。君子于行，义不食也。六二之吉，顺以则也。南狩之志，乃大得也。入于左腹，获心意也。箕子之贞，明不可息也。初登于天，照四国也。后入于地，失则也。0123456"@zh-Hans .

yj:gua_36 a yj:Hexagram ;
    rdfs:label "家人"@zh-Hans ;
    skos:altLabel "37·家人"@zh-Hans ;
    rdfs:comment "第37卦 ䷤，巽上离下，五行属木"@zh-Hans ;
    yj:name "家人"@zh-Hans ;
    yj:guaName "家人"@zh-Hans ;
    yj:sequenceNumber "37"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "家人：利女贞。"@zh-Hans ;
    yj:tuanText "家人，女正位乎内，男正位乎外。男女正，天地之大义也。家人有严君焉，父母之谓也。父父，子子，兄兄，弟弟，夫夫，妇妇，而家道正。正家而天下定矣。"@zh-Hans ;
    yj:xiangText "风自火出，家人。君子以言有物而行有恒。六二之吉，顺以巽也。家人嗃々，未失也。妇子嘻嘻，失家节也。王假有家，交相爱也。威如之吉，反身之谓也。"@zh-Hans .

yj:gua_37 a yj:Hexagram ;
    rdfs:label "睽"@zh-Hans ;
    skos:altLabel "38·睽"@zh-Hans ;
    rdfs:comment "第38卦 ䷥，离上兑下，五行属火"@zh-Hans ;
    yj:name "睽"@zh-Hans ;
    yj:guaName "睽"@zh-Hans ;
    yj:sequenceNumber "38"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "睽：小事吉。"@zh-Hans ;
    yj:tuanText "睽，火动而上，泽动而下。二女同居，其志不同行。说而丽乎明，柔进而上行，得中而应乎刚，是以小事吉。天地睽而其事同也。男女睽而其志通也。万物睽而其事类也。睽之时用大矣哉。"@zh-Hans ;
    yj:xiangText "上火下泽，睽。君子以同而异。遇主于巷，未失道也。见舆曳，位不当也。无初有终，遇刚也。交孚无咎，志行也。厥宗噬肤，往有庆也。遇雨之吉，群疑亡也。"@zh-Hans .

yj:gua_38 a yj:Hexagram ;
    rdfs:label "蹇"@zh-Hans ;
    skos:altLabel "39·蹇"@zh-Hans ;
    rdfs:comment "第39卦 ䷦，坎上艮下，五行属水"@zh-Hans ;
    yj:name "蹇"@zh-Hans ;
    yj:guaName "蹇"@zh-Hans ;
    yj:sequenceNumber "39"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "蹇：利西南，不利东北。"@zh-Hans ;
    yj:tuanText "蹇，难也，险在前也。见险而能止，知矣哉。蹇利西南，往得中也。不利东北，其道穷也。利见大人，往有功也。当位贞吉，以正邦也。蹇之时用大矣哉。"@zh-Hans ;
    yj:xiangText "山上有水，蹇。君子以反身修德。往蹇来誉，宜待时也。王臣蹇蹇，终无尤也。往蹇来反，内喜之也。往蹇来连，当位实也。大蹇朋来，以中节也。往蹇来硕，志在内也。利见大人，以从贵也。"@zh-Hans .

yj:gua_39 a yj:Hexagram ;
    rdfs:label "解"@zh-Hans ;
    skos:altLabel "40·解"@zh-Hans ;
    rdfs:comment "第40卦 ䷧，震上坎下，五行属木"@zh-Hans ;
    yj:name "解"@zh-Hans ;
    yj:guaName "解"@zh-Hans ;
    yj:sequenceNumber "40"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "解：利西南，"@zh-Hans ;
    yj:tuanText "解，险以动，动而免乎险，解。解利西南，往得众也。无所往，其来复吉，乃得中也。有攸往，夙吉，往有功也。天地解而雷雨作，雷雨作而百果草木皆甲宅。解之时大矣哉。"@zh-Hans ;
    yj:xiangText "雷雨作，解。君子以赦过宥罪。刚柔之际，义无咎也。九二贞吉，得中道也。负且乘，亦可丑也。自我致戎，又谁咎也。解而母，未当位也。君有解，小人退也。公用射隼，以解悖也。"@zh-Hans .

yj:gua_40 a yj:Hexagram ;
    rdfs:label "损"@zh-Hans ;
    skos:altLabel "41·损"@zh-Hans ;
    rdfs:comment "第41卦 ䷨，艮上兑下，五行属土"@zh-Hans ;
    yj:name "损"@zh-Hans ;
    yj:guaName "损"@zh-Hans ;
    yj:sequenceNumber "41"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "损：有孚，元吉，无咎可贞，利有攸往。曷之用，二簋可用享。"@zh-Hans ;
    yj:tuanText "损，损下益上，其道上行。损而有孚，元吉，无咎。可贞。利有攸往。曷之用？二簋可用享。二簋应有时。损刚益柔有时。损益盈虚，与时偕行。"@zh-Hans ;
    yj:xiangText "山下有泽，损。君子以征忿窒欲。祀事遄往，上合志也。九二利贞，中以为志也。一人行，三则疑也。损其疾，亦可喜也。六五元吉，自上佑也。弗损益之，大得志也。"@zh-Hans .

yj:gua_41 a yj:Hexagram ;
    rdfs:label "益"@zh-Hans ;
    skos:altLabel "42·益"@zh-Hans ;
    rdfs:comment "第42卦 ䷩，巽上震下，五行属木"@zh-Hans ;
    yj:name "益"@zh-Hans ;
    yj:guaName "益"@zh-Hans ;
    yj:sequenceNumber "42"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "益：利有攸往。"@zh-Hans ;
    yj:tuanText "益，损上益下，民说无疆。自上下下，其道大光。利有攸往，中正有庆。利涉大川，木道乃行。益动而巽，日进无疆。天施地生，其益无方。凡益之道，与时偕行。"@zh-Hans ;
    yj:xiangText "风雷，益。君子以见善则迁，有过则改。元吉，无咎，下不厚事也。或益之，自外来也。益用凶事，固有之矣。告公从，以益志也。有孚惠心，勿问之矣。惠我德，大得志也。莫益之，遍辞也。或击之，自外来也。"@zh-Hans .

yj:gua_42 a yj:Hexagram ;
    rdfs:label "夬"@zh-Hans ;
    skos:altLabel "43·夬"@zh-Hans ;
    rdfs:comment "第43卦 ䷪，兑上乾下，五行属金"@zh-Hans ;
    yj:name "夬"@zh-Hans ;
    yj:guaName "夬"@zh-Hans ;
    yj:sequenceNumber "43"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_qian ;
    yj:guaciText "夬：夬，扬于王庭。"@zh-Hans ;
    yj:tuanText "夬，决也，刚决柔也。健而说，决而和。扬于王庭，柔乘五刚也。孚号有厉，其危乃光也。告自邑，不利即戎，所尚乃穷也。利有攸往，刚长乃终也。"@zh-Hans ;
    yj:xiangText "泽上于天，夬。君子以施禄及下，居德则忌。不胜而往，咎也。有戎勿恤，得中道也。君子夬夬，终无咎也。其行次且，位不当也。闻言不信，聪不明也。中行无咎，中未光也。无号之凶，终不可长也。"@zh-Hans .

yj:gua_43 a yj:Hexagram ;
    rdfs:label "姤"@zh-Hans ;
    skos:altLabel "44·姤"@zh-Hans ;
    rdfs:comment "第44卦 ䷫，乾上巽下，五行属金"@zh-Hans ;
    yj:name "姤"@zh-Hans ;
    yj:guaName "姤"@zh-Hans ;
    yj:sequenceNumber "44"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_qian ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "姤：姤，女壮，"@zh-Hans ;
    yj:tuanText "姤，遇也。柔遇刚也。勿用娶女，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉。"@zh-Hans ;
    yj:xiangText "天下有风，姤。后以施命诰四方。系于金柅，柔道牵也。包有鱼，义不及宾也。其行次且，行未牵也。无鱼之凶，远民也。九五含章，中正也。有陨自天，志不舍命也。姤其角，上穷吝也。"@zh-Hans .

yj:gua_44 a yj:Hexagram ;
    rdfs:label "萃"@zh-Hans ;
    skos:altLabel "45·萃"@zh-Hans ;
    rdfs:comment "第45卦 ䷬，兑上坤下，五行属金"@zh-Hans ;
    yj:name "萃"@zh-Hans ;
    yj:guaName "萃"@zh-Hans ;
    yj:sequenceNumber "45"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_kun ;
    yj:guaciText "萃：亨，王假有庙。"@zh-Hans ;
    yj:tuanText "萃，聚也，顺以说，刚中而应，故聚也。王假有庙，致孝享也。利见大人亨，聚以正也。利贞。用大牲吉。利有攸往，顺天命也。观其所聚，而天地万物之情可见矣。"@zh-Hans ;
    yj:xiangText "泽上于地，萃。君子以除戎器，戒不虞。乃乱乃萃，其志乱也。引吉无咎，中未变也。往无咎，上巽也。萃有位，志未光也。赍资涕洟，未安上也。"@zh-Hans .

yj:gua_45 a yj:Hexagram ;
    rdfs:label "升"@zh-Hans ;
    skos:altLabel "46·升"@zh-Hans ;
    rdfs:comment "第46卦 ䷭，坤上巽下，五行属土"@zh-Hans ;
    yj:name "升"@zh-Hans ;
    yj:guaName "升"@zh-Hans ;
    yj:sequenceNumber "46"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_kun ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "升："@zh-Hans ;
    yj:tuanText "柔以时升，巽而顺，刚中而应，是以大亨。用见大人勿恤，有庆也。南征吉，志行也。"@zh-Hans ;
    yj:xiangText "地中生木，升。君子以慎德，积小以成高大。允升大吉，上合志也。九二之孚，有喜也。升虚邑，无所疑也。王用享于岐山，顺事也。贞吉升阶，大得志也。冥升在上，消不富也。"@zh-Hans .

yj:gua_46 a yj:Hexagram ;
    rdfs:label "困"@zh-Hans ;
    skos:altLabel "47·困"@zh-Hans ;
    rdfs:comment "第47卦 ䷮，兑上坎下，五行属金"@zh-Hans ;
    yj:name "困"@zh-Hans ;
    yj:guaName "困"@zh-Hans ;
    yj:sequenceNumber "47"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "困：亨，"@zh-Hans ;
    yj:tuanText "困，刚弇也。险以说，困而不失其所亨，其唯君子乎？贞大人吉，以刚中也。有言不信，尚口乃穷也。"@zh-Hans ;
    yj:xiangText "泽无水，困。君子以致命遂志。入于幽谷，幽不明也。困于酒食，中有庆也。据于蒺藜，乘刚也。入于其宫，不见其妻，不祥也。来荼荼，志在下也。虽不当位，有与也。劓刖，志未得也。乃徐有说，以中直也。利用祭祀，受福也。困于葛藟，未当也。动悔有悔，吉行也。"@zh-Hans .

yj:gua_47 a yj:Hexagram ;
    rdfs:label "井"@zh-Hans ;
    skos:altLabel "48·井"@zh-Hans ;
    rdfs:comment "第48卦 ䷯，坎上巽下，五行属水"@zh-Hans ;
    yj:name "井"@zh-Hans ;
    yj:guaName "井"@zh-Hans ;
    yj:sequenceNumber "48"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "井："@zh-Hans ;
    yj:tuanText "巽乎水而上水，井。井养而不穷也。改邑不改井，乃以刚中也。无丧无得。往来井井，汔至亦未繘，未有功也。羸其瓶，是以凶也。"@zh-Hans ;
    yj:xiangText "木上有水，井。君子以劳民劝相。井泥不食，下也。旧井无禽，时舍也。井谷射鲋，无与也。井渫不食，行恻也。求王明，受福也。井甃无咎，修井也。寒泉之食，中正也。元吉在上，大成也。"@zh-Hans .

yj:gua_48 a yj:Hexagram ;
    rdfs:label "革"@zh-Hans ;
    skos:altLabel "49·革"@zh-Hans ;
    rdfs:comment "第49卦 ䷰，兑上离下，五行属金"@zh-Hans ;
    yj:name "革"@zh-Hans ;
    yj:guaName "革"@zh-Hans ;
    yj:sequenceNumber "49"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "革："@zh-Hans ;
    yj:tuanText "革，水火相息，二女同居，其志不相得，曰革。已曰乃孚，革而信之。文明以说，大亨以正，革而当，其悔乃亡。天地革而四时成。汤武革命，顺乎天而应乎人。革之时大矣哉。"@zh-Hans ;
    yj:xiangText "泽中有火，革。君子以治历明时。巩用黄牛，不可以有为也。已日革之，行有嘉也。革言三就，又何之矣。改命之吉，信志也。大人虎变，其文柄也。君子豹变，其文蔚也。小人革面，顺以从君也。"@zh-Hans .

yj:gua_49 a yj:Hexagram ;
    rdfs:label "鼎"@zh-Hans ;
    skos:altLabel "50·鼎"@zh-Hans ;
    rdfs:comment "第50卦 ䷱，离上巽下，五行属火"@zh-Hans ;
    yj:name "鼎"@zh-Hans ;
    yj:guaName "鼎"@zh-Hans ;
    yj:sequenceNumber "50"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "鼎："@zh-Hans ;
    yj:tuanText "鼎，象也。以木巽火，亨饪也。圣人亨以享上帝，而大亨以养圣贤。巽而耳目聪明，柔进而上行，得中而应乎刚，是以元亨。"@zh-Hans ;
    yj:xiangText "木上有火，鼎。君子以正位凝命。鼎颠趾，未悖也。利出否，以从贵也。鼎有实，慎所之也。我仇有疾，终无尤也。鼎耳革，失其义也。覆公餗，信如何也。鼎黄耳，中以为实也。玉铉在上，刚柔节也。"@zh-Hans .

yj:gua_50 a yj:Hexagram ;
    rdfs:label "震"@zh-Hans ;
    skos:altLabel "51·震"@zh-Hans ;
    rdfs:comment "第51卦 ䷲，震上震下，五行属木"@zh-Hans ;
    yj:name "震"@zh-Hans ;
    yj:guaName "震"@zh-Hans ;
    yj:sequenceNumber "51"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_zhen ;
    yj:guaciText "震：亨。"@zh-Hans ;
    yj:tuanText "震，亨，震来虩虩，恐致福也。笑言哑哑，后有则也。震惊百里，惊远而惧迩也。出可以守宗庙社稷，以为祭主也。"@zh-Hans ;
    yj:xiangText "洊雷震，君子以恐惧修剩震来虩虩，恐致福也。笑言哑哑，后有则也。震来厉，乘刚也。震遂泥，未光也。震往来厉，危行也。其事在中，大无丧也。震索索，中未得也。虽凶无咎，畏邻戒也。"@zh-Hans .

yj:gua_51 a yj:Hexagram ;
    rdfs:label "艮"@zh-Hans ;
    skos:altLabel "52·艮"@zh-Hans ;
    rdfs:comment "第52卦 ䷳，艮上艮下，五行属土"@zh-Hans ;
    yj:name "艮"@zh-Hans ;
    yj:guaName "艮"@zh-Hans ;
    yj:sequenceNumber "52"^^xsd:integer ;
    yj:wuxing "土"@zh-Hans ;
    yj:upperTrigram yj:tri_gen ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "艮：艮其背，"@zh-Hans ;
    yj:tuanText "艮，止也。时止则止，时行则行，动静不失其时，其道光明。艮其止，止其所也。上下敌应，不相与也。是以不获其身，行其庭，不见其人，无咎也。"@zh-Hans ;
    yj:xiangText "兼山艮。君子以思不出其位。艮其趾，未失正也。不拯其随，未违听也。艮其限，危阍心也。艮其身，止诸躬也。艮其辅，以中正也。敦艮之吉，以厚终也。"@zh-Hans .

yj:gua_52 a yj:Hexagram ;
    rdfs:label "渐"@zh-Hans ;
    skos:altLabel "53·渐"@zh-Hans ;
    rdfs:comment "第53卦 ䷴，巽上艮下，五行属木"@zh-Hans ;
    yj:name "渐"@zh-Hans ;
    yj:guaName "渐"@zh-Hans ;
    yj:sequenceNumber "53"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "渐：女归吉，利贞。"@zh-Hans ;
    yj:tuanText "渐之进也。女归吉也。进得位，往有功也。进以正，可以正邦也。其位刚得中也。止而巽，动不穷也。"@zh-Hans ;
    yj:xiangText "山上有木，渐。君子居贤德善俗。小子之厉，义无咎也。饮食衎衎，不素饱也。夫征不复，离群丑也。妇孕不育，失其道也。利用御寇，顺相保也。或得其桷，顺以巽也。终莫之胜吉，得所愿也。其羽可用为仪吉，不可乱也。"@zh-Hans .

yj:gua_53 a yj:Hexagram ;
    rdfs:label "归妹"@zh-Hans ;
    skos:altLabel "54·归妹"@zh-Hans ;
    rdfs:comment "第54卦 ䷵，震上兑下，五行属木"@zh-Hans ;
    yj:name "归妹"@zh-Hans ;
    yj:guaName "归妹"@zh-Hans ;
    yj:sequenceNumber "54"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "归妹："@zh-Hans ;
    yj:tuanText "归妹，天地之大义也。天地不交而万物不兴。归妹，人之终始也。说以动，所归妹也。征凶，位不当也。无攸利，柔乘刚也。"@zh-Hans ;
    yj:xiangText "泽上有雷，归妹。君子以永终知敝。归妹以娣，以恒也。跛而履，吉相承也。利幽人之贞，未变常也。归妹以须，位未当也。愆期之志，有待而行也。帝乙归妹，不如其娣之袂良也。其位在中，以贵行也。上六无实，承虚筐也。"@zh-Hans .

yj:gua_54 a yj:Hexagram ;
    rdfs:label "丰"@zh-Hans ;
    skos:altLabel "55·丰"@zh-Hans ;
    rdfs:comment "第55卦 ䷶，震上离下，五行属木"@zh-Hans ;
    yj:name "丰"@zh-Hans ;
    yj:guaName "丰"@zh-Hans ;
    yj:sequenceNumber "55"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "丰：亨，"@zh-Hans ;
    yj:tuanText "丰，大也。明以动，故丰。王假之，尚大也。勿忧，宜日中，宜照天下也。日中则昃，月盈则食，天地盈虚，与时消息，而况于人乎，况于鬼神乎。"@zh-Hans ;
    yj:xiangText "雷电皆至，丰。君子以折狱致刑。虽旬无咎，过旬灾也。有孚发若，信以发志也。丰其沛，不可大事也。折其右肱，终不可用也。丰其蔀，位不当也。日中见斗，幽不明也。遇其夷主，吉行也。六五之吉，有庆也。丰其屋，天际祥也。窥其户，阒其无人，自藏也。"@zh-Hans .

yj:gua_55 a yj:Hexagram ;
    rdfs:label "旅"@zh-Hans ;
    skos:altLabel "56·旅"@zh-Hans ;
    rdfs:comment "第56卦 ䷷，离上艮下，五行属火"@zh-Hans ;
    yj:name "旅"@zh-Hans ;
    yj:guaName "旅"@zh-Hans ;
    yj:sequenceNumber "56"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "旅：小亨，旅贞吉。"@zh-Hans ;
    yj:tuanText "旅小亨。柔得中乎外，而顺乎刚，止而丽乎明，是以小亨旅贞吉也。旅之时义大矣哉。"@zh-Hans ;
    yj:xiangText "山上有火，旅。君子以明慎用刑，而不留狱。旅琐琐，志穷灾也。得僮仆贞，终无尤也。旅焚其次，亦以伤矣。以旅与下，其义丧也。旅于处，未得位也。得其资斧，心未快也。终以誉命，上逮也。以旅在上，其义焚也。丧牛于易，终莫之闻也。"@zh-Hans .

yj:gua_56 a yj:Hexagram ;
    rdfs:label "巽"@zh-Hans ;
    skos:altLabel "57·巽"@zh-Hans ;
    rdfs:comment "第57卦 ䷸，巽上巽下，五行属木"@zh-Hans ;
    yj:name "巽"@zh-Hans ;
    yj:guaName "巽"@zh-Hans ;
    yj:sequenceNumber "57"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_xun ;
    yj:guaciText "巽：小亨，利有攸往，利见大人。"@zh-Hans ;
    yj:tuanText "重巽以申命，刚巽乎中正而志行，柔皆顺乎刚，是以小亨。利有攸往，利见大人。"@zh-Hans ;
    yj:xiangText "随风，巽。君子以申命行事。进退，志疑也。利武人之贞，志治也。纷若之吉，得中也。频巽之吝，志穷也。田获三品，有功也。九五之吉，位正中也。巽在床下，上穷也。丧其齐斧，正乎凶也。"@zh-Hans .

yj:gua_57 a yj:Hexagram ;
    rdfs:label "兑"@zh-Hans ;
    skos:altLabel "58·兑"@zh-Hans ;
    rdfs:comment "第58卦 ䷹，兑上兑下，五行属金"@zh-Hans ;
    yj:name "兑"@zh-Hans ;
    yj:guaName "兑"@zh-Hans ;
    yj:sequenceNumber "58"^^xsd:integer ;
    yj:wuxing "金"@zh-Hans ;
    yj:upperTrigram yj:tri_dui ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "兑：亨，利贞。"@zh-Hans ;
    yj:tuanText "兑，说也。刚中而柔外，说以利贞，是以顺乎天而应乎人。说以先民，民忘其劳；说以犯难，民忘其死，说之大民劝矣哉。"@zh-Hans ;
    yj:xiangText "丽泽，兑，君子以朋友讲习。和兑之吉，行未疑也。孚兑之吉，信志也。来兑之凶，位不当也。九四之喜，有庆也。孚于剥，位正当也。上六引兑，未光也。"@zh-Hans .

yj:gua_58 a yj:Hexagram ;
    rdfs:label "涣"@zh-Hans ;
    skos:altLabel "59·涣"@zh-Hans ;
    rdfs:comment "第59卦 ䷺，巽上坎下，五行属木"@zh-Hans ;
    yj:name "涣"@zh-Hans ;
    yj:guaName "涣"@zh-Hans ;
    yj:sequenceNumber "59"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "涣：亨。"@zh-Hans ;
    yj:tuanText "涣亨，刚来而不穷，柔得位乎外而上同。利涉大川，乘木有功也。"@zh-Hans ;
    yj:xiangText "风行水上，涣。先王以享于帝，立庙。初六之吉，顺也。涣奔其机，得愿也。涣其躬，志在外也。涣其群元吉，光大也。涣其血，远害也。"@zh-Hans .

yj:gua_59 a yj:Hexagram ;
    rdfs:label "节"@zh-Hans ;
    skos:altLabel "60·节"@zh-Hans ;
    rdfs:comment "第60卦 ䷻，坎上兑下，五行属水"@zh-Hans ;
    yj:name "节"@zh-Hans ;
    yj:guaName "节"@zh-Hans ;
    yj:sequenceNumber "60"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "节：亨，"@zh-Hans ;
    yj:tuanText "节亨，刚柔分而刚得中，说以行险，当位以节，中正以通，天地节而四时成。节以制度，不伤财，不害民。"@zh-Hans ;
    yj:xiangText "泽上有水，节。君子以制数度，议德行。不出户庭，知通塞也。不出门庭凶，失时极也。不节之嗟，又谁咎也。安节之亨，承上道也。甘节之吉，居位中也。苦节贞凶，其道穷也。"@zh-Hans .

yj:gua_60 a yj:Hexagram ;
    rdfs:label "中孚"@zh-Hans ;
    skos:altLabel "61·中孚"@zh-Hans ;
    rdfs:comment "第61卦 ䷼，巽上兑下，五行属木"@zh-Hans ;
    yj:name "中孚"@zh-Hans ;
    yj:guaName "中孚"@zh-Hans ;
    yj:sequenceNumber "61"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_xun ;
    yj:lowerTrigram yj:tri_dui ;
    yj:guaciText "中孚："@zh-Hans ;
    yj:tuanText "中孚，柔在内而刚得中，说而巽孚，乃化邦也。豚鱼吉：信及豚鱼也。利涉大川，乘木舟虚也。中孚以利贞，乃应乎天也。"@zh-Hans ;
    yj:xiangText "泽上有风，中孚。君子以议狱缓死。初九虞吉，志未变也。其子和之，中心愿也。或鼓或罢，位不当也。马匹亡，绝类上也。有孚挛如，位正当也。翰音登于天，何可长也。"@zh-Hans .

yj:gua_61 a yj:Hexagram ;
    rdfs:label "小过"@zh-Hans ;
    skos:altLabel "62·小过"@zh-Hans ;
    rdfs:comment "第62卦 ䷽，震上艮下，五行属木"@zh-Hans ;
    yj:name "小过"@zh-Hans ;
    yj:guaName "小过"@zh-Hans ;
    yj:sequenceNumber "62"^^xsd:integer ;
    yj:wuxing "木"@zh-Hans ;
    yj:upperTrigram yj:tri_zhen ;
    yj:lowerTrigram yj:tri_gen ;
    yj:guaciText "小过：亨，利贞。"@zh-Hans ;
    yj:tuanText "小过，小者过而亨也。过以利贞，与时行也。柔得中，是以小事吉也。刚失位而不中，是以不可大事也。有飞鸟之象焉，飞鸟遗之音。不宜上，宜下，大吉。上逆而下顺也。"@zh-Hans ;
    yj:xiangText "山上有雷，小过。君子以行过乎恭，丧过乎哀，用过乎俭。飞鸟以凶，不可如何也。不及其君，臣不可过也。从或戕之，凶如何也。弗过遇之，位不当也。往厉必戒，终不可长也。密云不雨，已上也。弗遇过之，已亢之。"@zh-Hans .

yj:gua_62 a yj:Hexagram ;
    rdfs:label "既济"@zh-Hans ;
    skos:altLabel "63·既济"@zh-Hans ;
    rdfs:comment "第63卦 ䷾，坎上离下，五行属水"@zh-Hans ;
    yj:name "既济"@zh-Hans ;
    yj:guaName "既济"@zh-Hans ;
    yj:sequenceNumber "63"^^xsd:integer ;
    yj:wuxing "水"@zh-Hans ;
    yj:upperTrigram yj:tri_kan ;
    yj:lowerTrigram yj:tri_li ;
    yj:guaciText "既济：亨校利贞。"@zh-Hans ;
    yj:tuanText "既济亨，小者亨也。利贞，刚柔正而位当也。初吉，柔得中也。终止则乱，其道穷也。"@zh-Hans ;
    yj:xiangText "水在火上，既济。君子以思患而豫防之。七日得，以中道也。三年克之，惫也。终日戒，有所疑也。东邻杀牛，不如西邻之时也。濡其首厉，何可久也。"@zh-Hans .

yj:gua_63 a yj:Hexagram ;
    rdfs:label "未济"@zh-Hans ;
    skos:altLabel "64·未济"@zh-Hans ;
    rdfs:comment "第64卦 ䷿，离上坎下，五行属火"@zh-Hans ;
    yj:name "未济"@zh-Hans ;
    yj:guaName "未济"@zh-Hans ;
    yj:sequenceNumber "64"^^xsd:integer ;
    yj:wuxing "火"@zh-Hans ;
    yj:upperTrigram yj:tri_li ;
    yj:lowerTrigram yj:tri_kan ;
    yj:guaciText "未济：亨。"@zh-Hans ;
    yj:tuanText "未济亨，柔得中也。小狐汔济，未出中也。濡其尾，无攸利，不续终也。虽不当位，刚柔应也。"@zh-Hans ;
    yj:xiangText "火在水上，未济。君子以慎辨物居方。濡其尾，亦不知极也。九二贞吉，中以行正也。未济征凶，位不当也。贞吉悔亡，志行也。君子之光，其晖吉也。饮酒濡首，亦不知节也。"@zh-Hans .

# === Hexagram Relations (cuo/zong/hu/jiao) ===

# === 386 Lines (yao) ===
yj:gua_00_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "乾初九"@zh-Hans ;
    rdfs:comment "乾初九"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "潜龙勿用。"@zh-Hans ;
    yj:baihuaText "如潜藏的龙，时机未到，力量尚在积蓄。此时不宜轻举妄动、急于出头，应沉住气修养自己，等待条件成熟再行动。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "乾九二"@zh-Hans ;
    rdfs:comment "乾九二"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "见龙在田，利见大人。"@zh-Hans ;
    yj:baihuaText "如龙出现在田野，才华开始显露，也遇到可依靠的贵人。宜主动寻求贤明者的提携，在合适的位置上施展本领。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "乾九三"@zh-Hans ;
    rdfs:comment "乾九三"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "君子终日乾乾，夕惕，若厉，无咎。"@zh-Hans ;
    yj:baihuaText "君子整天勤勉不懈，到夜晚仍警惕自省，处境看似危险却能有惊无险。关键在于自强不息、随时戒惧，方能免于过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "乾九四"@zh-Hans ;
    rdfs:comment "乾九四"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "或跃在渊，无咎。"@zh-Hans ;
    yj:baihuaText "如龙在深渊边跃跃欲试，进退未定。此时可以尝试进取，只要审时度势、量力而行，就不会有过错。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "乾九五"@zh-Hans ;
    rdfs:comment "乾九五"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "飞龙在天，利见大人。"@zh-Hans ;
    yj:baihuaText "如龙飞腾于天，事业达到鼎盛，正是大展宏图、与贤者共成大事的时候。宜把握时机，以德居高位。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "乾上九"@zh-Hans ;
    rdfs:comment "乾上九"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "亢龙有悔。"@zh-Hans ;
    yj:baihuaText "如龙飞得过高，物极必反，必有悔恨。提醒人勿因成功而骄矜膨胀，懂得收势退让才能保全。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00_y7 a yj:Line ;
    rdfs:label "用九"@zh-Hans ;
    skos:altLabel "乾用九"@zh-Hans ;
    rdfs:comment "乾用九"@zh-Hans ;
    yj:lineOf yj:gua_00 ;
    yj:yaoPosition "0"^^xsd:integer ;
    yj:name "用九"@zh-Hans ;
    yj:yaociText "见群龙无首，吉。"@zh-Hans ;
    yj:baihuaText "群龙并起而不争首领，各自守分、协同共进，是吉利的。说明最理想的阳刚不是争强好胜，而是刚而能柔、彼此成全。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_00 yj:hasLine yj:gua_00_y1 ;
    yj:hasLine yj:gua_00_y2 ;
    yj:hasLine yj:gua_00_y3 ;
    yj:hasLine yj:gua_00_y4 ;
    yj:hasLine yj:gua_00_y5 ;
    yj:hasLine yj:gua_00_y6 ;
    yj:hasLine yj:gua_00_y7 .

yj:gua_01_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "坤初六"@zh-Hans ;
    rdfs:comment "坤初六"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "履霜，坚冰至。"@zh-Hans ;
    yj:baihuaText "踩到霜就应想到严冬将至，微小的迹象预示着重大的变化。提醒人见微知著，及早防范，勿等事态扩大才警觉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "坤六二"@zh-Hans ;
    rdfs:comment "坤六二"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "直方大。不习无不利。"@zh-Hans ;
    yj:baihuaText "品性正直、端方、宽厚，不去刻意造作也能处处顺利。只要守住内心的操守与本分，自然无所不利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "坤六三"@zh-Hans ;
    rdfs:comment "坤六三"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "含章可贞。或从王事，无成有终。"@zh-Hans ;
    yj:baihuaText "内含才华而不外露，可以守持正固；若参与君王之事，不居功、不争名，反而能有好的结果。宜低调谨慎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "坤六四"@zh-Hans ;
    rdfs:comment "坤六四"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "括囊，无咎，无誉。"@zh-Hans ;
    yj:baihuaText "像扎紧的口袋，不轻易开口表态，虽无美誉却也无灾祸。在局势不明时，谨慎沉默是最稳妥的选择。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "坤六五"@zh-Hans ;
    rdfs:comment "坤六五"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "黄裳，元吉。"@zh-Hans ;
    yj:baihuaText "身着黄色的下裳，谦居正位而心怀中道，是大吉之象。说明以谦逊温和居于尊位，最能得人拥戴。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "坤上六"@zh-Hans ;
    rdfs:comment "坤上六"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "龙战于野，其血玄黄。"@zh-Hans ;
    yj:baihuaText "阴气盛极而与阳相争，如同龙在旷野厮杀、血染大地。提示一味逞强争胜、越出本分，必将两败俱伤。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01_y7 a yj:Line ;
    rdfs:label "用六"@zh-Hans ;
    skos:altLabel "坤用六"@zh-Hans ;
    rdfs:comment "坤用六"@zh-Hans ;
    yj:lineOf yj:gua_01 ;
    yj:yaoPosition "-1"^^xsd:integer ;
    yj:name "用六"@zh-Hans ;
    yj:yaociText "利永贞。"@zh-Hans ;
    yj:baihuaText "永远守持柔顺正固的德行，便能以宽厚之心成就大局、善始善终。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_01 yj:hasLine yj:gua_01_y1 ;
    yj:hasLine yj:gua_01_y2 ;
    yj:hasLine yj:gua_01_y3 ;
    yj:hasLine yj:gua_01_y4 ;
    yj:hasLine yj:gua_01_y5 ;
    yj:hasLine yj:gua_01_y6 ;
    yj:hasLine yj:gua_01_y7 .

yj:gua_02_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "屯初九"@zh-Hans ;
    rdfs:comment "屯初九"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "盘桓，利居贞，利建侯。"@zh-Hans ;
    yj:baihuaText "起步时徘徊犹豫，宜安守正道、不可冒进，同时着手建立自己的班底与人脉基础，为将来铺路。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_02_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "屯六二"@zh-Hans ;
    rdfs:comment "屯六二"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "屯如邅如，乘马班加。匪寇婚媾，女子贞不字，十年乃字。"@zh-Hans ;
    yj:baihuaText "处境艰难、进退受阻，犹如骑马踌躇不前。看似有阻挠者，实则是来求合的缘分；宁可守节等待，久后终有转机。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_02_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "屯六三"@zh-Hans ;
    rdfs:comment "屯六三"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "即鹿无虞，惟入于林中，君子几，不如舍，往吝。"@zh-Hans ;
    yj:baihuaText "没有向导就贸然进山逐鹿，只会迷失林中。君子应懂得见机而止，不如放弃；勉强前往必致困窘。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_02_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "屯六四"@zh-Hans ;
    rdfs:comment "屯六四"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "乘马班如，求婚媾，往吉，无不利。"@zh-Hans ;
    yj:baihuaText "骑马徘徊、心中犹豫，宜主动寻求结伴婚姻式的合作。积极去促成结合，前往行事吉利，无所不利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_02_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "屯九五"@zh-Hans ;
    rdfs:comment "屯九五"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "屯其膏，小贞吉，大贞凶。"@zh-Hans ;
    yj:baihuaText "恩泽无法顺利施予，力量受到约束。此时小事守正可获吉，若强求大动作则有凶险，宜量力而为。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_02_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "屯上六"@zh-Hans ;
    rdfs:comment "屯上六"@zh-Hans ;
    yj:lineOf yj:gua_02 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "乘马班如，泣血涟如。"@zh-Hans ;
    yj:baihuaText "进退两难、徘徊无依，以至悲泣流血。说明困顿至极而无人相助，应及早反思求助，不可一味苦撑。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_02 yj:hasLine yj:gua_02_y1 ;
    yj:hasLine yj:gua_02_y2 ;
    yj:hasLine yj:gua_02_y3 ;
    yj:hasLine yj:gua_02_y4 ;
    yj:hasLine yj:gua_02_y5 ;
    yj:hasLine yj:gua_02_y6 .

yj:gua_03_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "蒙初六"@zh-Hans ;
    rdfs:comment "蒙初六"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "发蒙，利用刑人，用说桎梏，以往吝。"@zh-Hans ;
    yj:baihuaText "开启蒙昧之初，宜用规矩法度来端正人心，必要时加以惩戒以正其心。但若一味用刑无度，则会有遗憾。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_03_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "蒙九二"@zh-Hans ;
    rdfs:comment "蒙九二"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "包蒙，吉。纳妇，吉。子克家。"@zh-Hans ;
    yj:xiaoxiangText "子克家，刚柔接也。"@zh-Hans ;
    yj:baihuaText "包容蒙昧之人、教化众人，是大吉；娶妻成家亦吉，子弟能担起家业。说明以宽厚包容之心育人是正道。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_03_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "蒙六三"@zh-Hans ;
    rdfs:comment "蒙六三"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "勿用娶女，见金夫，不有躬，无攸利。"@zh-Hans ;
    yj:baihuaText "不要去娶这样的女子，她见财而动、不能自重，与之结合无所利。提醒人勿因贪图而失了分寸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_03_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "蒙六四"@zh-Hans ;
    rdfs:comment "蒙六四"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "困蒙，吝。"@zh-Hans ;
    yj:xiaoxiangText "困蒙之吝，独远实也。"@zh-Hans ;
    yj:baihuaText "困于蒙昧之中、无人开导，孤陋寡闻，处境困窘。说明脱离学养与良友，必陷僵局，宜主动求教。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_03_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "蒙六五"@zh-Hans ;
    rdfs:comment "蒙六五"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "童蒙，吉。"@zh-Hans ;
    yj:baihuaText "像天真虚心的孩童一样求教，肯听人言、不逞聪明，反得吉祥。谦虚受教是脱离蒙昧的最好办法。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_03_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "蒙上九"@zh-Hans ;
    rdfs:comment "蒙上九"@zh-Hans ;
    yj:lineOf yj:gua_03 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "击蒙，不利为寇，利御寇。"@zh-Hans ;
    yj:baihuaText "以严厉手段击破蒙昧，但不可矫枉过正、过于苛酷。宜把力量用于抵御外来的侵害，而非欺凌下属。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_03 yj:hasLine yj:gua_03_y1 ;
    yj:hasLine yj:gua_03_y2 ;
    yj:hasLine yj:gua_03_y3 ;
    yj:hasLine yj:gua_03_y4 ;
    yj:hasLine yj:gua_03_y5 ;
    yj:hasLine yj:gua_03_y6 .

yj:gua_04_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "需初九"@zh-Hans ;
    rdfs:comment "需初九"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "需于郊，利用恒，无咎。"@zh-Hans ;
    yj:baihuaText "在远离危险的郊野等待，宜保持恒心与耐心，不犯难而进，自然没有过错。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_04_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "需九二"@zh-Hans ;
    rdfs:comment "需九二"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "需于沙，小有言，终吉。"@zh-Hans ;
    yj:baihuaText "在靠近水边的沙地等待，虽有些小的口舌是非，但只要沉住气，最终仍会吉祥。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_04_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "需九三"@zh-Hans ;
    rdfs:comment "需九三"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "需于泥，致寇至。"@zh-Hans ;
    yj:baihuaText "在泥泞之地等待，已逼近险境，容易招来祸患。提醒人别把自己置于是非之地，应敬慎自守以免失败。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_04_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "需六四"@zh-Hans ;
    rdfs:comment "需六四"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "需于血，出自穴。"@zh-Hans ;
    yj:baihuaText "身陷险境、遭遇损伤，但能顺势脱出险穴。此时宜冷静顺从而听命，不自作主张，方能脱身。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_04_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "需九五"@zh-Hans ;
    rdfs:comment "需九五"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "需于酒食，贞吉。"@zh-Hans ;
    yj:baihuaText "在酒食安乐中从容等待时机，守正而吉。说明条件已就，安心守正、静候其成即可。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_04_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "需上六"@zh-Hans ;
    rdfs:comment "需上六"@zh-Hans ;
    yj:lineOf yj:gua_04 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "入于穴，有不速之客三人来，敬之终吉。"@zh-Hans ;
    yj:baihuaText "落入险穴，却来了三位不速之客。宜以恭敬之心相待，化解对立，最终转危为吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_04 yj:hasLine yj:gua_04_y1 ;
    yj:hasLine yj:gua_04_y2 ;
    yj:hasLine yj:gua_04_y3 ;
    yj:hasLine yj:gua_04_y4 ;
    yj:hasLine yj:gua_04_y5 ;
    yj:hasLine yj:gua_04_y6 .

yj:gua_05_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "讼初六"@zh-Hans ;
    rdfs:comment "讼初六"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "不永所事，小有言，终吉。"@zh-Hans ;
    yj:baihuaText "不要长久纠缠于争讼之事，虽有些小的口舌，及早收手便能善终。争执宜速了，不宜拖长。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_05_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "讼九二"@zh-Hans ;
    rdfs:comment "讼九二"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "不克讼，归而逋。其邑人三百户，无眚。"@zh-Hans ;
    yj:baihuaText "争讼不能取胜，不如退避回家，隐匿自守。安分于自己的小天地，反而可以免于灾祸。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_05_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "讼六三"@zh-Hans ;
    rdfs:comment "讼六三"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "食旧德，贞厉，终吉。或从王事，无成。"@zh-Hans ;
    yj:baihuaText "安享旧有的德业俸禄，守正而行虽有艰险，终得吉祥；若参与君王之事，不居功、不图成，方为妥当。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_05_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "讼九四"@zh-Hans ;
    rdfs:comment "讼九四"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "不克讼，复即命渝，安贞吉。"@zh-Hans ;
    yj:baihuaText "争讼无法取胜，于是回心转意、改从正命，安守贞正则吉。说明及时放下争执、回归本分不失为明智。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_05_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "讼九五"@zh-Hans ;
    rdfs:comment "讼九五"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "讼，元吉。"@zh-Hans ;
    yj:xiaoxiangText "讼，元吉，以中正也。"@zh-Hans ;
    yj:baihuaText "由公正中正者来审理争端，判断得当，大吉。说明争讼得遇明断，可以获得最为圆满的结果。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_05_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "讼上九"@zh-Hans ;
    rdfs:comment "讼上九"@zh-Hans ;
    yj:lineOf yj:gua_05 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "或锡之鞶带，终朝三拕之。"@zh-Hans ;
    yj:baihuaText "即便因讼获胜、得到赏赐的荣誉，也会屡得屡失、朝不保夕。提醒人靠争讼得来的荣耀终究不足为贵。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_05 yj:hasLine yj:gua_05_y1 ;
    yj:hasLine yj:gua_05_y2 ;
    yj:hasLine yj:gua_05_y3 ;
    yj:hasLine yj:gua_05_y4 ;
    yj:hasLine yj:gua_05_y5 ;
    yj:hasLine yj:gua_05_y6 .

yj:gua_06_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "师初六"@zh-Hans ;
    rdfs:comment "师初六"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "师出以律，否臧凶。"@zh-Hans ;
    yj:xiaoxiangText "师出以律，失律凶也。"@zh-Hans ;
    yj:baihuaText "出兵必须有严明的纪律，行动一开始就要以法度约束。若纪律败坏、毫无章法，必致凶险。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_06_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "师九二"@zh-Hans ;
    rdfs:comment "师九二"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "在师中，吉，无咎。王三锡命。"@zh-Hans ;
    yj:xiaoxiangText "在师中吉，承天宠也。王三锡命，怀万邦也。"@zh-Hans ;
    yj:baihuaText "身居军中主帅之位，得众心拥戴而吉祥无咎，君王屡次嘉奖授命。说明居位得中、上下信赖是用兵之吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_06_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "师六三"@zh-Hans ;
    rdfs:comment "师六三"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "师或舆尸，凶。"@zh-Hans ;
    yj:baihuaText "军中若由尸位无能者载尸领兵，必致凶险。警示用人不当、主事者失职，会带来严重失败。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_06_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "师六四"@zh-Hans ;
    rdfs:comment "师六四"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "师左次，无咎。"@zh-Hans ;
    yj:baihuaText "军队暂时退驻一旁、避免硬拼，没有过错。说明力量不足时懂得避让退守，符合常理，是稳妥之举。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_06_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "师六五"@zh-Hans ;
    rdfs:comment "师六五"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。"@zh-Hans ;
    yj:baihuaText "田野有禽兽来犯，宜捉拿处置、名正言顺而无咎。应由长子般的贤能者统军，若委任无能的次子必致凶险。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_06_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "师上六"@zh-Hans ;
    rdfs:comment "师上六"@zh-Hans ;
    yj:lineOf yj:gua_06 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "大君有命，开国承家，小人勿用。"@zh-Hans ;
    yj:baihuaText "君王颁下任命，论功行赏、分封开国承家。但小人不可重用，否则必将祸乱国家。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_06 yj:hasLine yj:gua_06_y1 ;
    yj:hasLine yj:gua_06_y2 ;
    yj:hasLine yj:gua_06_y3 ;
    yj:hasLine yj:gua_06_y4 ;
    yj:hasLine yj:gua_06_y5 ;
    yj:hasLine yj:gua_06_y6 .

yj:gua_07_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "比初六"@zh-Hans ;
    rdfs:comment "比初六"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "有孚比之，无咎。有孚盈缶，终来有它，吉。"@zh-Hans ;
    yj:baihuaText "怀着诚信去亲附他人没有过错；诚信充盈如满缶，终会带来意外的吉庆。说明以真诚待人，自然广结善缘。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_07_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "比六二"@zh-Hans ;
    rdfs:comment "比六二"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "比之自内，贞吉。"@zh-Hans ;
    yj:baihuaText "发自内心地亲附于人，守正而吉。说明真诚的亲近来自内在的认同，不自失本心，最为可贵。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_07_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "比六三"@zh-Hans ;
    rdfs:comment "比六三"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "比之匪人。"@zh-Hans ;
    yj:baihuaText "却去亲附了不该亲近的人。提醒人交友结盟要辨明对象，误附匪人，反受其害而令人痛惜。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_07_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "比六四"@zh-Hans ;
    rdfs:comment "比六四"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "外比之，贞吉。"@zh-Hans ;
    yj:baihuaText "向外亲附贤明之人，守正而吉。说明主动追随贤者、向上靠拢，是明智的选择。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_07_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "比九五"@zh-Hans ;
    rdfs:comment "比九五"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "显比。王用三驱，失前禽，邑人不戒，吉。"@zh-Hans ;
    yj:baihuaText "光明正大地亲附天下，如君王田猎只驱三面、留一线生机，本国之民不必戒备，吉。说明以宽仁待人、不强求尽得，反而广得人心。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_07_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "比上六"@zh-Hans ;
    rdfs:comment "比上六"@zh-Hans ;
    yj:lineOf yj:gua_07 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "比之无首，凶。"@zh-Hans ;
    yj:baihuaText "亲附而没有一个好的开端与首领，最终必致凶险。说明失去凝聚的核心与时机，团结就无从谈起。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_07 yj:hasLine yj:gua_07_y1 ;
    yj:hasLine yj:gua_07_y2 ;
    yj:hasLine yj:gua_07_y3 ;
    yj:hasLine yj:gua_07_y4 ;
    yj:hasLine yj:gua_07_y5 ;
    yj:hasLine yj:gua_07_y6 .

yj:gua_08_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "小畜初九"@zh-Hans ;
    rdfs:comment "小畜初九"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "复自道，何其咎，吉。"@zh-Hans ;
    yj:xiaoxiangText "复自道，其义吉也。"@zh-Hans ;
    yj:baihuaText "正处于起步归复的阶段，顺着正道回到自己应有的位置，本就合乎情理，不会有过失，前途吉祥。此时守正自持、不冒进，即可安然。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_08_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "小畜九二"@zh-Hans ;
    rdfs:comment "小畜九二"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "牵复，吉。"@zh-Hans ;
    yj:baihuaText "与同道相互牵连扶持而一同归复，得众人之力，处境稳健，结果吉祥。说明此时宜携手同行，借助同伴的力量共同回归正途。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_08_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "小畜九三"@zh-Hans ;
    rdfs:comment "小畜九三"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "车说辐，夫妻反目。"@zh-Hans ;
    yj:baihuaText "车轮的辐条脱落，象征前行受阻、彼此背离，如同夫妻反目失和。此爻警示关系或行动出了差池，宜反躬自省、修复内部矛盾。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_08_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "小畜六四"@zh-Hans ;
    rdfs:comment "小畜六四"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "有孚，血去惕出，无咎。"@zh-Hans ;
    yj:baihuaText "心怀诚信，血光之灾与忧惧都已消除，故无咎。说明以诚待人、消除猜忌，便能化解危险，走出不安的处境。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_08_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "小畜九五"@zh-Hans ;
    rdfs:comment "小畜九五"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "有孚挛如，富以其邻。"@zh-Hans ;
    yj:baihuaText "以诚信紧密团结众人，富足而不独享，愿与邻里共享其成。说明真正的富有在与人分享，讲信义、施惠于人可获人心与吉祥。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_08_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "小畜上九"@zh-Hans ;
    rdfs:comment "小畜上九"@zh-Hans ;
    yj:lineOf yj:gua_08 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "既雨既处，尚得载，妇贞厉。月几望，君子征凶。"@zh-Hans ;
    yj:baihuaText "雨已降下、事已安定，却能积载成果。但妇人若过于固执守常则危险，月近满则亏，君子此时贸然出征反招凶险。警示功成之际当知进退、戒盈满。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_08 yj:hasLine yj:gua_08_y1 ;
    yj:hasLine yj:gua_08_y2 ;
    yj:hasLine yj:gua_08_y3 ;
    yj:hasLine yj:gua_08_y4 ;
    yj:hasLine yj:gua_08_y5 ;
    yj:hasLine yj:gua_08_y6 .

yj:gua_09_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "履初九"@zh-Hans ;
    rdfs:comment "履初九"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "素履，往无咎。"@zh-Hans ;
    yj:baihuaText "以质朴本色行事，心无杂念、不慕虚荣地向前走去，不会有过失。说明安于朴素、本分踏实，是立身处世的稳妥之道。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_09_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "履九二"@zh-Hans ;
    rdfs:comment "履九二"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "履道坦坦，幽人贞吉。"@zh-Hans ;
    yj:baihuaText "行走在平坦的大道上，幽居守静的人持正自守，吉祥。说明当道路顺畅时更要保持清静不躁、中立自守，如此可获吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_09_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "履六三"@zh-Hans ;
    rdfs:comment "履六三"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "眇而视，跛而履，履虎尾，咥人，凶。武人为于大君。"@zh-Hans ;
    yj:baihuaText "眼力不足却想看远，腿脚不便却想远行，又踩着虎尾冒险，必遭咬伤而凶；如武夫妄想当君王，是不自量力。警示实力不济却勉强行险，将招祸患。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_09_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "履九四"@zh-Hans ;
    rdfs:comment "履九四"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "履虎尾，愬愬，终吉。"@zh-Hans ;
    yj:baihuaText "踩着老虎尾巴，心存戒惧谨慎，最终吉祥。说明身处险境时保持警惕、小心从事，虽紧张却可平安通过。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_09_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "履九五"@zh-Hans ;
    rdfs:comment "履九五"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "夬履，贞厉。"@zh-Hans ;
    yj:baihuaText "刚决果断地行事，虽动机端正，仍须警惕危险。说明居高位者果决本是应当，但也因位高权重而暗藏凶险，不可恃强。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_09_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "履上九"@zh-Hans ;
    rdfs:comment "履上九"@zh-Hans ;
    yj:lineOf yj:gua_09 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "视履考详，其旋元吉。"@zh-Hans ;
    yj:baihuaText "回顾自身的践履，考察其吉凶得失，若能周旋得当、善始善终，便大为吉祥。说明时常反省总结，方可圆满收场。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_09 yj:hasLine yj:gua_09_y1 ;
    yj:hasLine yj:gua_09_y2 ;
    yj:hasLine yj:gua_09_y3 ;
    yj:hasLine yj:gua_09_y4 ;
    yj:hasLine yj:gua_09_y5 ;
    yj:hasLine yj:gua_09_y6 .

yj:gua_10_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "泰初九"@zh-Hans ;
    rdfs:comment "泰初九"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "拔茅茹，以其汇，征吉。"@zh-Hans ;
    yj:baihuaText "拔起茅草连根带同类一同而起，象征贤者相聚、同心而出，前往行动吉祥。说明此时宜与志同者结伴进发，共同成就事业。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_10_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "泰九二"@zh-Hans ;
    rdfs:comment "泰九二"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "包荒，用冯河，不遐遗。朋亡，得尚于中行。"@zh-Hans ;
    yj:baihuaText "胸怀宽宏包容荒秽，敢于涉水渡河，不遗弃远方的贤才；不结私党，走中正之道而受重用。说明居高位者当包容、尚贤、去私，方能符合中道。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_10_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "泰九三"@zh-Hans ;
    rdfs:comment "泰九三"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "无平不陂，无往不复。艰贞无咎。勿恤其孚，于食有福。"@zh-Hans ;
    yj:baihuaText "没有永远的平坦，也没有只去不返的事物；在艰难中守正即可无咎。不必忧虑诚信不足，衣食自有福分。说明世事有起有伏，守正守恒方能安然。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_10_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "泰六四"@zh-Hans ;
    rdfs:comment "泰六四"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "翩翩，不富以其邻，不戒以孚。"@zh-Hans ;
    yj:baihuaText "轻快向下，不炫富而善待邻里，也不待告诫就自然诚信。说明内心真诚、谦和待邻，无需勉强就能获得信任。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_10_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "泰六五"@zh-Hans ;
    rdfs:comment "泰六五"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "帝乙归妹，以祉元吉。"@zh-Hans ;
    yj:baihuaText "帝乙嫁出女儿，因这份福祉而大吉。说明居尊位者以谦下、联姻之道与人结好，能广结良缘、获致大吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_10_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "泰上六"@zh-Hans ;
    rdfs:comment "泰上六"@zh-Hans ;
    yj:lineOf yj:gua_10 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "城复于隍，勿用师，自邑告命，贞吝。"@zh-Hans ;
    yj:baihuaText "城墙倾倒回壕沟，象征局面由泰转否、时势逆转。此时不可动用兵师，只能在自己城邑内发布告令，守正也难免艰吝。警示盛极须防倾覆。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_10 yj:hasLine yj:gua_10_y1 ;
    yj:hasLine yj:gua_10_y2 ;
    yj:hasLine yj:gua_10_y3 ;
    yj:hasLine yj:gua_10_y4 ;
    yj:hasLine yj:gua_10_y5 ;
    yj:hasLine yj:gua_10_y6 .

yj:gua_11_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "否初六"@zh-Hans ;
    rdfs:comment "否初六"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "拔茅茹以其汇，贞吉，亨。"@zh-Hans ;
    yj:baihuaText "如同拔起茅草连根带类一起拔，与同道者一同守正，吉祥而亨通。说明在闭塞之世，志同者应相互结伴、坚守正道以待时机。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_11_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "否六二"@zh-Hans ;
    rdfs:comment "否六二"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "包承，小人吉，大人否，亨。"@zh-Hans ;
    yj:baihuaText "一味包容承顺，小人以此为吉，君子则拒绝屈从反而亨通。说明面对恶势力，君子当守正不屈，不可曲意逢迎以苟且得利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_11_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "否六三"@zh-Hans ;
    rdfs:comment "否六三"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "包羞。"@zh-Hans ;
    yj:xiaoxiangText "包羞，位不当也。"@zh-Hans ;
    yj:baihuaText "为苟且容身而包藏羞耻，内心有愧。此爻警示身处否世却贪图禄位、隐忍含羞，终究于己有损，宜自省所守是否端正。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_11_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "否九四"@zh-Hans ;
    rdfs:comment "否九四"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "有命，无咎，畴离祉。"@zh-Hans ;
    yj:baihuaText "奉天命而行动，没有过错，同类都能依附而共享福祉。说明时机好转时，顺势而作、带领众人共进，可无咎而有福。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_11_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "否九五"@zh-Hans ;
    rdfs:comment "否九五"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "休否，大人吉。其亡其亡，系于包桑。"@zh-Hans ;
    yj:baihuaText "使闭塞休止，大人吉祥；但须时时戒惧“快要灭亡了”，如同把命运系于包桑之上般谨慎。说明转机初现时尤须居安思危、慎守其成。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_11_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "否上九"@zh-Hans ;
    rdfs:comment "否上九"@zh-Hans ;
    yj:lineOf yj:gua_11 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "倾否，先否后喜。"@zh-Hans ;
    yj:baihuaText "彻底倾覆这闭塞之局，先经艰难而后转为喜乐。说明否极泰来，闭塞到了尽头必被打破，坚持到转机到来便将迎来欢喜。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_11 yj:hasLine yj:gua_11_y1 ;
    yj:hasLine yj:gua_11_y2 ;
    yj:hasLine yj:gua_11_y3 ;
    yj:hasLine yj:gua_11_y4 ;
    yj:hasLine yj:gua_11_y5 ;
    yj:hasLine yj:gua_11_y6 .

yj:gua_12_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "同人初九"@zh-Hans ;
    rdfs:comment "同人初九"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "同人于门，无咎。"@zh-Hans ;
    yj:baihuaText "一出门就能与人和同，交往坦荡无私，不会有过失。说明人际往来应开放公允、不设私挟，如此广结善缘即无咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_12_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "同人六二"@zh-Hans ;
    rdfs:comment "同人六二"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "同人于宗，吝。"@zh-Hans ;
    yj:baihuaText "只同于自己宗族一派的人，狭隘自私，行不通。说明交往若困于私党、排斥外人，就失去了同人的正道，会招致困窘。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_12_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "同人九三"@zh-Hans ;
    rdfs:comment "同人九三"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "伏戎于莽，升其高陵，三岁不兴。"@zh-Hans ;
    yj:baihuaText "把兵戎埋伏在草莽中，又登上高陵窥望，三年都不敢发作。说明心怀猜忌、争强好斗却又力不能胜，只能长期僵持，宜放弃敌意。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_12_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "同人九四"@zh-Hans ;
    rdfs:comment "同人九四"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "乘其庸，弗克攻，吉。"@zh-Hans ;
    yj:baihuaText "登上城墙却不发动进攻，因道义上不该攻伐，故吉祥。说明即使占据优势、能胜之势，也应克制不斗，回归正道才得吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_12_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "同人九五"@zh-Hans ;
    rdfs:comment "同人九五"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "同人先号咷而后笑，大师克相遇。"@zh-Hans ;
    yj:baihuaText "与人和同者先是号啕痛哭，其后转悲为笑，经历大军相争后终得相遇相合。说明真诚结合同道必先历波折，坚持到底方能如愿。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_12_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "同人上九"@zh-Hans ;
    rdfs:comment "同人上九"@zh-Hans ;
    yj:lineOf yj:gua_12 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "同人于郊，无悔。"@zh-Hans ;
    yj:baihuaText "在城郊与人和同，虽未得志于庙堂，却也无可悔恨。说明志在广阔而非贪图显达，淡泊守正、坦然而处，便可无悔。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_12 yj:hasLine yj:gua_12_y1 ;
    yj:hasLine yj:gua_12_y2 ;
    yj:hasLine yj:gua_12_y3 ;
    yj:hasLine yj:gua_12_y4 ;
    yj:hasLine yj:gua_12_y5 ;
    yj:hasLine yj:gua_12_y6 .

yj:gua_13_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "大有初九"@zh-Hans ;
    rdfs:comment "大有初九"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "无交害，匪咎，艰则无咎。"@zh-Hans ;
    yj:baihuaText "不与人结怨受害，本身并无过错；但只要知晓艰难、谨慎从事，就能无咎。说明富有之初须远离害端、戒骄慎行，方能保全。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_13_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "大有九二"@zh-Hans ;
    rdfs:comment "大有九二"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "大车以载，有攸往，无咎。"@zh-Hans ;
    yj:baihuaText "用大车装载重物，有所前往，不会有过失。说明有实力又有担当，只要方向明确、稳妥装载，就能胜任远行而无咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_13_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "大有九三"@zh-Hans ;
    rdfs:comment "大有九三"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "公用亨于天子，小人弗克。"@zh-Hans ;
    yj:baihuaText "公侯把财富献给天子，小人则做不到。说明居富盛之时当心怀公义、上奉大局，若为小人之心只顾私利，反受其害。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_13_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "大有九四"@zh-Hans ;
    rdfs:comment "大有九四"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "匪其尫，无咎。"@zh-Hans ;
    yj:baihuaText "不夸耀自己的盛美，无咎。说明在富有之时当收敛谦退、不炫耀锋芒，明辨这一分际即可免于过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_13_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "大有六五"@zh-Hans ;
    rdfs:comment "大有六五"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "厥孚交如，威如吉。"@zh-Hans ;
    yj:baihuaText "以诚信与人交好，并保持威严，吉祥。说明居尊位者待人以诚、立身有威，宽严相济，才能赢得敬服而获吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_13_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "大有上九"@zh-Hans ;
    rdfs:comment "大有上九"@zh-Hans ;
    yj:lineOf yj:gua_13 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "自天右之，吉，无不利。"@zh-Hans ;
    yj:baihuaText "有上天保佑，吉祥而无所不利。说明秉承正道、顺应天意，自然得到各方相助，凡事顺遂而无所不利。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_13 yj:hasLine yj:gua_13_y1 ;
    yj:hasLine yj:gua_13_y2 ;
    yj:hasLine yj:gua_13_y3 ;
    yj:hasLine yj:gua_13_y4 ;
    yj:hasLine yj:gua_13_y5 ;
    yj:hasLine yj:gua_13_y6 .

yj:gua_14_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "谦初六"@zh-Hans ;
    rdfs:comment "谦初六"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "谦谦君子，用涉大川，吉。"@zh-Hans ;
    yj:baihuaText "谦而又谦的君子，以卑下自处，凭此可以渡过大河。说明极度谦逊并非软弱，而是修养深厚的表现，能助人成就大事。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_14_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "谦六二"@zh-Hans ;
    rdfs:comment "谦六二"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "鸣谦，贞吉。"@zh-Hans ;
    yj:baihuaText "谦名远扬、闻名于外，守正则吉。说明谦德已得人心、发自中诚，只要坚持正道，名声与实德相称便可获吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_14_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "谦九三"@zh-Hans ;
    rdfs:comment "谦九三"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "劳谦，君子有终，吉。"@zh-Hans ;
    yj:baihuaText "劳苦功高而仍然谦逊，君子能有善终，吉祥。说明有能力又肯谦让的人最受人心拥戴，万民信服，故能得吉而善终。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_14_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "谦六四"@zh-Hans ;
    rdfs:comment "谦六四"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "无不利，捴谦。"@zh-Hans ;
    yj:baihuaText "无所不利，处处发挥谦让。说明谦已由内而外、自然流露，行事得当而不违法则，因此事事顺利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_14_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "谦六五"@zh-Hans ;
    rdfs:comment "谦六五"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "不富以其邻，利用侵伐，无不利。"@zh-Hans ;
    yj:baihuaText "不炫富而善待邻里，必要时可以进行征伐，无所不利。说明谦逊不等于无原则，面对不服者也要有担当、予以纠正，方合于理。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_14_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "谦上六"@zh-Hans ;
    rdfs:comment "谦上六"@zh-Hans ;
    yj:lineOf yj:gua_14 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "鸣谦，利用行师，征邑国。"@zh-Hans ;
    yj:baihuaText "谦名在外，可以动用军队去征伐自己城邑中的不服者。说明谦德已极，但仍需以行动纠正内部的不正，志向未遂时可用强力正之。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_14 yj:hasLine yj:gua_14_y1 ;
    yj:hasLine yj:gua_14_y2 ;
    yj:hasLine yj:gua_14_y3 ;
    yj:hasLine yj:gua_14_y4 ;
    yj:hasLine yj:gua_14_y5 ;
    yj:hasLine yj:gua_14_y6 .

yj:gua_15_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "豫初六"@zh-Hans ;
    rdfs:comment "豫初六"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "鸣豫，凶。"@zh-Hans ;
    yj:baihuaText "得意忘形地张扬欢愉，凶。说明初得安乐便一味炫耀、沉迷于享乐，志向已穷，必招凶险，宜收敛戒骄。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_15_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "豫六二"@zh-Hans ;
    rdfs:comment "豫六二"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "介于石，不终日，贞吉。"@zh-Hans ;
    yj:baihuaText "操守坚介如磐石，不待终日就能明断，守正则吉。说明身处安乐仍能保持坚正不渝、当机立断，故能获吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_15_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "豫六三"@zh-Hans ;
    rdfs:comment "豫六三"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "盱豫悔，迟有悔。"@zh-Hans ;
    yj:xiaoxiangText "盱豫有悔，位不当也。"@zh-Hans ;
    yj:baihuaText "仰望逢迎以求欢愉，将生悔恨；迟迟不改更增悔恨。说明慕求安逸而依附逢迎下层之乐，悔恨必至，宜及早觉悟。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_15_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "豫九四"@zh-Hans ;
    rdfs:comment "豫九四"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "由豫，大有得，勿疑，朋盍戠。"@zh-Hans ;
    yj:baihuaText "众人依靠他而得到欢愉，大有所得，不必疑虑，朋友会像发饰聚合般聚集而来。说明自己成为大家快乐的源泉，坦诚无私便可聚众成大。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_15_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "豫六五"@zh-Hans ;
    rdfs:comment "豫六五"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "贞疾，恒不死。"@zh-Hans ;
    yj:baihuaText "虽常怀忧患如带病在身，却能长久不倒。说明居安乐之中仍有隐忧，但只要守正持中、不忘忧患，就能长存不亡。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_15_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "豫上六"@zh-Hans ;
    rdfs:comment "豫上六"@zh-Hans ;
    yj:lineOf yj:gua_15 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "冥豫，成有渝，无咎。"@zh-Hans ;
    yj:baihuaText "沉迷于安乐而昏聩，若事能及时改变，则无咎。说明一味沉溺享乐久必出事，须及早悔改转向，方可免于灾祸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_15 yj:hasLine yj:gua_15_y1 ;
    yj:hasLine yj:gua_15_y2 ;
    yj:hasLine yj:gua_15_y3 ;
    yj:hasLine yj:gua_15_y4 ;
    yj:hasLine yj:gua_15_y5 ;
    yj:hasLine yj:gua_15_y6 .

yj:gua_16_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "随初九"@zh-Hans ;
    rdfs:comment "随初九"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "官有渝，贞吉。出门交有功。"@zh-Hans ;
    yj:baihuaText "处境刚起步，该有所变动了。此时改变旧有的职务、岗位或立场，只要守正就吉利；主动出门与人交往、广结善缘，必能建立功业。启示是变要变得及时，交要交得主动。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_16_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "随六二"@zh-Hans ;
    rdfs:comment "随六二"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "系小子，失丈夫。"@zh-Hans ;
    yj:baihuaText "一心系着眼前的小人物，就会错失真正值得追随的有为之士。此爻提醒人择友择主须看格局，若贪恋亲近便利而放弃更值得依托的对象，是得不偿失的失策。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_16_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "随六三"@zh-Hans ;
    rdfs:comment "随六三"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "系丈夫，失小子，随有求，得。利居贞。"@zh-Hans ;
    yj:baihuaText "舍弃了低处的小关系，去追随高处的贤者，追随中有所求便能如愿。此爻利于安居守正。启示是：登上更高的平台、跟对更值得跟的人，方向对了努力就有回报。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_16_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "随九四"@zh-Hans ;
    rdfs:comment "随九四"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "随有获，贞凶。有孚在道，以明，何咎。"@zh-Hans ;
    yj:baihuaText "追随之中获利很多、收获很大，若贪得不止反有凶险。但只要心怀诚信、行事合乎正道，光明磊落，又哪来的过错？此爻劝人得势时不可贪，守诚守道方能化险为夷。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_16_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "随九五"@zh-Hans ;
    rdfs:comment "随九五"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "孚于嘉吉。"@zh-Hans ;
    yj:baihuaText "对所追随或所欣赏的美好事物抱有真诚的信任，因而吉利。此爻居中得正，象征以诚待人、择善而信，自然得到善报，是人主与人际关系中极佳的处境。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_16_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "随上六"@zh-Hans ;
    rdfs:comment "随上六"@zh-Hans ;
    yj:lineOf yj:gua_16 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "拘系之，乃从维之。王用亨于西山。"@zh-Hans ;
    yj:baihuaText "关系已经牢固到用绳捆绑、再加固的地步，也就是把局面彻底维系住了。如君王在西山举行祭祀那样以诚感通神灵。此爻提示：追随到了极处，只有以诚信相维系，才能长久不失。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_16 yj:hasLine yj:gua_16_y1 ;
    yj:hasLine yj:gua_16_y2 ;
    yj:hasLine yj:gua_16_y3 ;
    yj:hasLine yj:gua_16_y4 ;
    yj:hasLine yj:gua_16_y5 ;
    yj:hasLine yj:gua_16_y6 .

yj:gua_17_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "蛊初六"@zh-Hans ;
    rdfs:comment "蛊初六"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "干父之蛊，有子考，无咎。厉，终吉。"@zh-Hans ;
    yj:baihuaText "整治父辈留下的积弊，有这样能干的子辈去继承和补救，父辈就没有过错了。虽然过程艰险，但最终吉利。此爻鼓励后人勇于承担纠错与接班的责任，虽难而有成。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_17_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "蛊九二"@zh-Hans ;
    rdfs:comment "蛊九二"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "干母之蛊，不可贞。"@zh-Hans ;
    yj:xiaoxiangText "干母之蛊，得中道也。"@zh-Hans ;
    yj:baihuaText "整治母辈留下的弊病，不可固执刚强、一味纠正。此爻说明：面对温和柔弱、盘根错节的旧问题，要用柔和迂回之法，不宜硬碰硬，过刚反而伤情坏事。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_17_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "蛊九三"@zh-Hans ;
    rdfs:comment "蛊九三"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "干父之蛊，小有悔，无大咎。"@zh-Hans ;
    yj:xiaoxiangText "干父之蛊，终无咎也。"@zh-Hans ;
    yj:baihuaText "整治父辈留下的积弊，整治中稍有悔恨懊恼，却没有大的过咎。此爻提示：纠错难免用力过猛或引起微词，只要方向对，小挫折可以承受。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_17_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "蛊六四"@zh-Hans ;
    rdfs:comment "蛊六四"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "裕父之蛊，往见吝。"@zh-Hans ;
    yj:baihuaText "对父辈留下的弊病采取宽缓放任的态度，任其延续，这样走下去必生遗憾与羞辱。此爻警示：该整治而不整治、姑息养奸，终将自取其咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_17_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "蛊六五"@zh-Hans ;
    rdfs:comment "蛊六五"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "干父之蛊，用誉。"@zh-Hans ;
    yj:baihuaText "整治父辈留下的积弊，因而获得美好的声誉。此爻居君位而贤，象征以德承业、以功获誉，是整治弊乱最得体的结果，既有所作为又不失分寸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_17_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "蛊上九"@zh-Hans ;
    rdfs:comment "蛊上九"@zh-Hans ;
    yj:lineOf yj:gua_17 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "不事王侯，高尚其事。"@zh-Hans ;
    yj:baihuaText "不去侍奉王侯、不涉足权势，保持清高的志节与操守。此爻说的是：身处弊端丛生的时代，有人选择不与合作、独善其身，其志向高洁可以为人所效法。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_17 yj:hasLine yj:gua_17_y1 ;
    yj:hasLine yj:gua_17_y2 ;
    yj:hasLine yj:gua_17_y3 ;
    yj:hasLine yj:gua_17_y4 ;
    yj:hasLine yj:gua_17_y5 ;
    yj:hasLine yj:gua_17_y6 .

yj:gua_18_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "临初九"@zh-Hans ;
    rdfs:comment "临初九"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "咸临，贞吉。"@zh-Hans ;
    yj:baihuaText "以感应、打动的方式去临近他人，也就是用感染力去领导，只要守正就吉利。此爻提示：初出临事，凭真诚的感召与正直的志向打动人，是好的开端。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_18_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "临九二"@zh-Hans ;
    rdfs:comment "临九二"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "咸临，吉，无不利。"@zh-Hans ;
    yj:baihuaText "同样以感应感召的方式去临近，吉利，无论做什么都顺利。此爻刚中而应，象征德力兼备感召有力，正是大展身手、无往不利的好时候，但也须及时把握。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_18_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "临六三"@zh-Hans ;
    rdfs:comment "临六三"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "甘临，无攸利，既忧之，无咎。"@zh-Hans ;
    yj:xiaoxiangText "甘临，位不当也。既忧之，咎不长也。"@zh-Hans ;
    yj:baihuaText "用甜言蜜语、甘美之辞去讨好别人，没有什么好处；只要能及时忧虑省悟、改弦更张，就没有过咎。此爻提醒：靠谄媚取悦不能长久，知错即改尚可无咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_18_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "临六四"@zh-Hans ;
    rdfs:comment "临六四"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "至临，无咎。"@zh-Hans ;
    yj:baihuaText "以极为切近、深入的方式去临近下面的民众，没有过咎。此爻说明：领导若能亲自贴近、体察下情，位置摆得正确，就能得到信任而无差错。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_18_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "临六五"@zh-Hans ;
    rdfs:comment "临六五"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "知临，大君之宜，吉。"@zh-Hans ;
    yj:xiaoxiangText "大君之宜，行中之谓也。"@zh-Hans ;
    yj:baihuaText "以睿智、明智的方式去临近天下，这是伟大君主应有的作风，吉利。此爻象征以智慧驭下、知人善任，是大君临民最得当、最吉利的领导方式。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_18_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "临上六"@zh-Hans ;
    rdfs:comment "临上六"@zh-Hans ;
    yj:lineOf yj:gua_18 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "敦临，吉，无咎。"@zh-Hans ;
    yj:baihuaText "以敦厚笃实的态度去临近，吉祥，没有过咎。此爻居卦之极而以厚德临人，说明领导到了高处，唯有宽厚笃实、心系内部民众，才能善始善终。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_18 yj:hasLine yj:gua_18_y1 ;
    yj:hasLine yj:gua_18_y2 ;
    yj:hasLine yj:gua_18_y3 ;
    yj:hasLine yj:gua_18_y4 ;
    yj:hasLine yj:gua_18_y5 ;
    yj:hasLine yj:gua_18_y6 .

yj:gua_19_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "观初六"@zh-Hans ;
    rdfs:comment "观初六"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "童观，小人无咎，君子吝。"@zh-Hans ;
    yj:baihuaText "像小孩子一样浅薄地观看，见识短浅。对普通百姓来说这不算过错，但对有志有为的君子而言则可羞。此爻提醒立志高远者，观物察事不可停留在幼稚浅表的层面。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_19_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "观六二"@zh-Hans ;
    rdfs:comment "观六二"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "窥观，利女贞。"@zh-Hans ;
    yj:baihuaText "从门缝里窥看，所见有限。此爻利于女子守持贞正。它说明视野受限、只从狭隘角度看问题，虽可自守，却难有大的见识与作为，宜拓开眼界。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_19_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "观六三"@zh-Hans ;
    rdfs:comment "观六三"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "观我生，进退。"@zh-Hans ;
    yj:baihuaText "反观自己的作为与生活，据以决定进退。此爻说明：人处于成长之中，应常常检点自身、审视内省，知道自己该进该退，便没有走错路。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_19_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "观六四"@zh-Hans ;
    rdfs:comment "观六四"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "观国之光，利用宾于王。"@zh-Hans ;
    yj:baihuaText "观看一国的盛美气象，利于成为君王的宾客、参与其事。此爻象征处于高出之地，能观见大气象、接近上位者，正是施展才能、出仕用世的好时机。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_19_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "观九五"@zh-Hans ;
    rdfs:comment "观九五"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "观我生，君子无咎。"@zh-Hans ;
    yj:baihuaText "反省观察自己的所作所为，君子如此自省就没有过咎。此爻居尊位而能返观自身，说明居高位者要常审视自己的德行与政绩，自省方能无过。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_19_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "观上九"@zh-Hans ;
    rdfs:comment "观上九"@zh-Hans ;
    yj:lineOf yj:gua_19 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "观其生，君子无咎。"@zh-Hans ;
    yj:baihuaText "观察他人的作为与天下万民的状态，君子如此就没有过咎。此爻居高临下而心系天下，说明真正的君子不只自省，还要观照众人、体察民情，志向方可平静踏实。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_19 yj:hasLine yj:gua_19_y1 ;
    yj:hasLine yj:gua_19_y2 ;
    yj:hasLine yj:gua_19_y3 ;
    yj:hasLine yj:gua_19_y4 ;
    yj:hasLine yj:gua_19_y5 ;
    yj:hasLine yj:gua_19_y6 .

yj:gua_20_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "噬嗑初九"@zh-Hans ;
    rdfs:comment "噬嗑初九"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "屦校灭趾，无咎。"@zh-Hans ;
    yj:baihuaText "脚上戴着木枷，遮住了脚趾，行动受阻。这是初犯受轻惩，及时惩戒使其不再犯恶，因而没有过咎。此爻说明小惩防大恶，初犯受戒可免大祸。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_20_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "噬嗑六二"@zh-Hans ;
    rdfs:comment "噬嗑六二"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "噬肤灭鼻，无咎。"@zh-Hans ;
    yj:baihuaText "咬柔嫩的肉，深到把鼻子都陷进去了。此爻比喻惩治柔弱者用力稍过，但因其刚强而立、处置得当，终究没有过咎，只是须留意分寸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_20_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "噬嗑六三"@zh-Hans ;
    rdfs:comment "噬嗑六三"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "噬昔肉，遇毒，小吝，无咎。"@zh-Hans ;
    yj:baihuaText "咬陈腐的腊肉，遇上毒味，稍有羞吝，但没有大的过咎。此爻提示：处理积久变质、关系复杂的问题难免遇到麻烦和反噬，位不当时要谨慎应对，仍可免于大过。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_20_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "噬嗑九四"@zh-Hans ;
    rdfs:comment "噬嗑九四"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "噬干胏，得金矢，利艰贞，吉。"@zh-Hans ;
    yj:xiaoxiangText "利艰贞吉，未光也。"@zh-Hans ;
    yj:baihuaText "咬坚硬的带骨之肉，得到金属箭镞，利于在艰难中守持正道，吉利。此爻象征排除梗阻虽辛劳，却能取得关键进展，只要坚忍守正，终获吉庆。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_20_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "噬嗑六五"@zh-Hans ;
    rdfs:comment "噬嗑六五"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "噬干肉，得黄金，贞厉，无咎。"@zh-Hans ;
    yj:baihuaText "咬干硬的肉，得到黄金，守正虽有危厉，却无过咎。此爻居尊而处理难事，既有收获又须常怀戒惧，说明得位者只要恪守正道、谨慎行事，可保无咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_20_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "噬嗑上九"@zh-Hans ;
    rdfs:comment "噬嗑上九"@zh-Hans ;
    yj:lineOf yj:gua_20 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "何校灭耳，凶。"@zh-Hans ;
    yj:baihuaText "肩上扛着大枷，遮住了耳朵，凶险。此爻象征恶行累积到极点、屡教不改，听觉心智皆被蒙蔽，不知悔改，最终自取凶祸，警示人勿走到不可救药的地步。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_20 yj:hasLine yj:gua_20_y1 ;
    yj:hasLine yj:gua_20_y2 ;
    yj:hasLine yj:gua_20_y3 ;
    yj:hasLine yj:gua_20_y4 ;
    yj:hasLine yj:gua_20_y5 ;
    yj:hasLine yj:gua_20_y6 .

yj:gua_21_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "贲初九"@zh-Hans ;
    rdfs:comment "贲初九"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "贲其趾，舍车而徒。"@zh-Hans ;
    yj:baihuaText "装饰自己的脚趾，宁可舍弃车马而步行。此爻说明：宁可舍弃不必得的便利，也要守好本分、循义而行，文饰当合于义，不畏朴拙而图虚荣。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_21_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "贲六二"@zh-Hans ;
    rdfs:comment "贲六二"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "贲其须。"@zh-Hans ;
    yj:xiaoxiangText "贲其须，与上兴也。"@zh-Hans ;
    yj:baihuaText "装饰自己的胡须。胡须依附于下颌方能生长，此爻比喻：修饰须有所依托、顺势而为，自己力量不足时，宜依附于人、配合成全，不必强出头。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_21_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "贲九三"@zh-Hans ;
    rdfs:comment "贲九三"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "贲如濡如，永贞吉。"@zh-Hans ;
    yj:xiaoxiangText "永贞之吉，终莫之陵也。"@zh-Hans ;
    yj:baihuaText "装饰得华美润泽，长久守持正道就吉利。此爻提示：外表的光鲜美丽若能配合内在的端正并持之以恒，便是好事；若只图一时华丽而不守正，则难保长久。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_21_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "贲六四"@zh-Hans ;
    rdfs:comment "贲六四"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "贲如皤如，白马翰如，匪寇婚媾。"@zh-Hans ;
    yj:baihuaText "装饰得素白洁净，白马奔驰而来，来的不是盗寇，而是来求婚配的。此爻说明：在文饰与质朴之间徘徊犹疑之际，看似来势汹汹者实为善意的联姻，终无怨尤。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_21_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "贲六五"@zh-Hans ;
    rdfs:comment "贲六五"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "贲于邱园，束帛戋戋，吝。终吉。"@zh-Hans ;
    yj:baihuaText "在山丘园圃中受到装饰，所得赠礼只是微薄的束帛，显得寒俭吝啬，但最终吉祥。此爻说明：居尊位而崇尚俭朴、不事奢华，虽一时显得小气，终究是好的。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_21_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "贲上九"@zh-Hans ;
    rdfs:comment "贲上九"@zh-Hans ;
    yj:lineOf yj:gua_21 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "白贲，无咎。"@zh-Hans ;
    yj:baihuaText "以纯白素朴为饰，不再加任何文采，没有过咎。此爻象征文饰到了极致应回归本色，返璞归真、以质为尚，才是最高的境界，也是心安理得、志愿得偿之象。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_21 yj:hasLine yj:gua_21_y1 ;
    yj:hasLine yj:gua_21_y2 ;
    yj:hasLine yj:gua_21_y3 ;
    yj:hasLine yj:gua_21_y4 ;
    yj:hasLine yj:gua_21_y5 ;
    yj:hasLine yj:gua_21_y6 .

yj:gua_22_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "剥初六"@zh-Hans ;
    rdfs:comment "剥初六"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "剥床以足，蔑贞凶。"@zh-Hans ;
    yj:baihuaText "剥落床先从床脚开始，也就是从根基处一点点侵蚀、败坏正道，凶险。此爻警示：衰败往往从下面最基础的地方发端，若忽视根基的腐坏，祸患由此而起。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_22_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "剥六二"@zh-Hans ;
    rdfs:comment "剥六二"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "剥床以辨，蔑贞凶。"@zh-Hans ;
    yj:baihuaText "剥落已经自上侵蚀到床身与床脚的连接处，正道被破坏，凶险。此爻说明：剥蚀之势步步逼近，危害加重，孤立无援而又名节受损，处境凶险，须及早警觉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_22_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "剥六三"@zh-Hans ;
    rdfs:comment "剥六三"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "剥无咎。"@zh-Hans ;
    yj:xiaoxiangText "剥之无咎，失上下也。"@zh-Hans ;
    yj:baihuaText "在剥落之中，虽身处其境却暂无过咎。此爻象征：衰势当中有能自守、不与恶势力同流者，虽处险境而未陷于不义，因而可以免咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_22_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "剥六四"@zh-Hans ;
    rdfs:comment "剥六四"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "剥床以肤，凶。"@zh-Hans ;
    yj:baihuaText "剥落到已经侵蚀肌肤，切近灾祸，凶险。此爻警示：祸患已经逼近自身、切身可感，处境十分危险，此时必须及时自救、迅速止剥，切不可再麻木不仁。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_22_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "剥六五"@zh-Hans ;
    rdfs:comment "剥六五"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "贯鱼，以宫人宠，无不利。"@zh-Hans ;
    yj:baihuaText "像贯串的鱼那样有次序地排列，率领宫人一同承受恩宠，无往而不利。此爻说明：在衰乱之际，如能以柔顺中正之道引导众人归顺正道、有序地转变局面，反能化败为利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_22_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "剥上九"@zh-Hans ;
    rdfs:comment "剥上九"@zh-Hans ;
    yj:lineOf yj:gua_22 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "硕果不食。君子德车，小人剥庐。"@zh-Hans ;
    yj:baihuaText "硕大的果实没有被吃掉，留下来成为新生的种子。君子得到众人拥戴、如车承载民众，小人则自毁居所。此爻象征剥极将复、生机尚存，德厚者自有前途，无德者终无所归。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_22 yj:hasLine yj:gua_22_y1 ;
    yj:hasLine yj:gua_22_y2 ;
    yj:hasLine yj:gua_22_y3 ;
    yj:hasLine yj:gua_22_y4 ;
    yj:hasLine yj:gua_22_y5 ;
    yj:hasLine yj:gua_22_y6 .

yj:gua_23_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "复初九"@zh-Hans ;
    rdfs:comment "复初九"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "不远复，无祗悔，元吉。"@zh-Hans ;
    yj:baihuaText "走得不远就及时返回正路，没有大的悔恨，大吉。此爻处于回归之初、改过最易之时，说明人只要觉察偏差及早回头，就能保住根本、吉利无忧。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_23_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "复六二"@zh-Hans ;
    rdfs:comment "复六二"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "休复，吉。"@zh-Hans ;
    yj:xiaoxiangText "休复之吉，以下仁也。"@zh-Hans ;
    yj:baihuaText "休美地回复、从善如流地回归正道，吉祥。此爻近于初九阳气，能顺势追随善道、不勉强而为，说明依从贤德、安然向善，是最顺畅、最值得欣喜的复归。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_23_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "复六三"@zh-Hans ;
    rdfs:comment "复六三"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "频复，厉，无咎。"@zh-Hans ;
    yj:baihuaText "屡次回复又屡次失掉，进进退退，处境危厉，但终究没有过咎。此爻说明：意志不坚、反复摇摆之人虽一时危险，但只要始终想着回头，仍不至于铸成大错。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_23_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "复六四"@zh-Hans ;
    rdfs:comment "复六四"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "中行独复。"@zh-Hans ;
    yj:xiaoxiangText "中行独复，以从道也。"@zh-Hans ;
    yj:baihuaText "独自秉持中道，把自己独立地归复于正道。此爻居众阴之中而能自守中正、不随波逐流，说明身处群邪之间仍能独善其身、坚持向善，是可贵的操守。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_23_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "复六五"@zh-Hans ;
    rdfs:comment "复六五"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "敦复，无悔。"@zh-Hans ;
    yj:xiaoxiangText "敦复无悔，中以自考也。"@zh-Hans ;
    yj:baihuaText "以敦厚笃实之心回复正道，没有悔恨。此爻居中而有厚重之德，说明回归不必张扬，以敦厚诚笃之心自处，自我省察、踏实向善，便能无悔无憾。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_23_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "复上六"@zh-Hans ;
    rdfs:comment "复上六"@zh-Hans ;
    yj:lineOf yj:gua_23 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "迷复，凶、有灾眚。用行师，终有大败，以其国君凶，至于十年不克征。"@zh-Hans ;
    yj:baihuaText "迷失方向、错失时机才想回复，凶险，且有天灾人祸。若用兵出征，终会大败，连国君也遭殃，十年之久都不能兴兵征战。此爻警示：执迷不悟、拒绝回头，积重难返，后果极其严重。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_23 yj:hasLine yj:gua_23_y1 ;
    yj:hasLine yj:gua_23_y2 ;
    yj:hasLine yj:gua_23_y3 ;
    yj:hasLine yj:gua_23_y4 ;
    yj:hasLine yj:gua_23_y5 ;
    yj:hasLine yj:gua_23_y6 .

yj:gua_24_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "无妄初九"@zh-Hans ;
    rdfs:comment "无妄初九"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "无妄，往吉。"@zh-Hans ;
    yj:baihuaText "处在无妄之初，心志纯正、动机无邪，此时前往行事最为吉利。只要怀着一颗没有私欲杂念的诚心起步，前路自然通畅，宜果断行动而不必多虑。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_24_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "无妄六二"@zh-Hans ;
    rdfs:comment "无妄六二"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "不耕获，不菑畲，则利有攸往。"@zh-Hans ;
    yj:baihuaText "不贪图耕作收获，不急着开垦新田，先耕耘不问结果，反而利于前行。此爻教人做事只问耕耘不问收获，顺其自然地把本分事情做好，机缘到时自有回报。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_24_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "无妄六三"@zh-Hans ;
    rdfs:comment "无妄六三"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "无妄之灾，或系之牛。行人之得，邑人之灾。"@zh-Hans ;
    yj:baihuaText "无妄之灾意外降临，如同有人把牛拴在路边，过路人牵走了牛，却让无辜的邑人蒙受灾殃。此爻喻祸从天降、非己之过，宜冷静承受，不必自责，也不要慌乱妄动。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_24_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "无妄九四"@zh-Hans ;
    rdfs:comment "无妄九四"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "可贞，无咎。"@zh-Hans ;
    yj:baihuaText "可以固守正道，因此没有灾咎。此爻处境虽有牵制，但只要能守住本心和原则，不为外物所动，就能平安无事，关键在于贞定自守。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_24_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "无妄九五"@zh-Hans ;
    rdfs:comment "无妄九五"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "无妄之疾，勿药有喜。"@zh-Hans ;
    yj:baihuaText "无妄之疾无须用药，自然会有喜。此爻指身染小病或遇小患，并非自己行为有失，只要不去胡乱医治、妄加干预，静养自愈，反而吉利。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_24_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "无妄上九"@zh-Hans ;
    rdfs:comment "无妄上九"@zh-Hans ;
    yj:lineOf yj:gua_24 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "无妄行，有眚，无攸利。"@zh-Hans ;
    yj:baihuaText "已经到了无妄之极，若再勉强前行，必生灾患，没有什么好处。此爻警示人在极盛或无事之时强行作为，反会招祸，宜安分守静、及时收手。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_24 yj:hasLine yj:gua_24_y1 ;
    yj:hasLine yj:gua_24_y2 ;
    yj:hasLine yj:gua_24_y3 ;
    yj:hasLine yj:gua_24_y4 ;
    yj:hasLine yj:gua_24_y5 ;
    yj:hasLine yj:gua_24_y6 .

yj:gua_25_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "大畜初九"@zh-Hans ;
    rdfs:comment "大畜初九"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "有厉，利已。"@zh-Hans ;
    yj:baihuaText "面临危险，宜停止前进、暂缓行动。此爻处境有阻，力量尚不足以进取，最好的选择是主动停下、克制冲动，以避开眼前的灾祸。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_25_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "大畜九二"@zh-Hans ;
    rdfs:comment "大畜九二"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "舆说腹。"@zh-Hans ;
    yj:baihuaText "车子脱落了车轴，无法继续前行。此爻喻因故停下、进无所之，此时不必强求，应安心暂止等待时机，虽不能前进也并无过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_25_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "大畜九三"@zh-Hans ;
    rdfs:comment "大畜九三"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "良马逐，利艰贞，吉。日闲舆卫，"@zh-Hans ;
    yj:baihuaText "良马奔驰追逐，利于在艰难中坚守正道，可获吉利。此时应每天练习驾车的本领、休整防卫，做好准备，待时机一到便可顺利前行。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_25_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "大畜六四"@zh-Hans ;
    rdfs:comment "大畜六四"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "童牛之告，元吉。"@zh-Hans ;
    yj:baihuaText "给童牛加上护角之具，防患于未然，大为吉利。此爻喻趁问题尚小及早加以防范和约束，用最小的代价杜患于初萌，是最明智的做法。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_25_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "大畜六五"@zh-Hans ;
    rdfs:comment "大畜六五"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "豮豕之牙，吉。"@zh-Hans ;
    yj:baihuaText "阉猪之牙，虽獠牙犹在却已无害，吉利。此爻喻以柔顺之法化解刚强之气，从根源上消除祸患，不硬碰硬，所以吉祥。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_25_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "大畜上九"@zh-Hans ;
    rdfs:comment "大畜上九"@zh-Hans ;
    yj:lineOf yj:gua_25 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "何天之衢，享。"@zh-Hans ;
    yj:baihuaText "何等畅通的天上大道，亨通无阻。此爻是蓄养已成的极致，德才充实之后，前路豁然开朗，任其驰骋，大展宏图的时机终于到来。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_25 yj:hasLine yj:gua_25_y1 ;
    yj:hasLine yj:gua_25_y2 ;
    yj:hasLine yj:gua_25_y3 ;
    yj:hasLine yj:gua_25_y4 ;
    yj:hasLine yj:gua_25_y5 ;
    yj:hasLine yj:gua_25_y6 .

yj:gua_26_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "颐初九"@zh-Hans ;
    rdfs:comment "颐初九"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "舍尔灵龟，观我朵颐，凶。"@zh-Hans ;
    yj:baihuaText "放着你自己灵验的宝龟不用，却盯着我大快朵颐的样子，凶险。此爻讽人舍弃自身本具的才德，艳羡攀附他人的口体之欲，舍己求人必致凶。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_26_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "颐六二"@zh-Hans ;
    rdfs:comment "颐六二"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "颠颐，拂经于丘颐，征凶。"@zh-Hans ;
    yj:baihuaText "颠倒过来谋求颐养，违背常理去攀求高处之养，前往则凶。此爻喻求养不得其道、本末倒置，宜安守本分，不要妄想借外力谋取非分之养。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_26_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "颐六三"@zh-Hans ;
    rdfs:comment "颐六三"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "拂颐，贞凶。十年勿用，无攸利。"@zh-Hans ;
    yj:baihuaText "违背颐养之道而行，固守此道乃凶，十年之久也不可施用，无利可图。此爻喻方向根本错误、积习难返，须彻底停手改弦更张，久行必败。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_26_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "颐六四"@zh-Hans ;
    rdfs:comment "颐六四"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "颠颐，吉。虎视眈眈，其欲逐逐，无咎。"@zh-Hans ;
    yj:baihuaText "颠倒上下以养下，反而吉利，像老虎那样目不转睛地专注，欲求接连不断，没有过失。此爻喻居上位者倾力养贤养民，专心施惠则吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_26_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "颐六五"@zh-Hans ;
    rdfs:comment "颐六五"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "拂经，居贞吉，不可涉大川。"@zh-Hans ;
    yj:baihuaText "虽违常规，但安守正道则吉，只是不可渡涉大川。此爻喻自身条件不足，宜守住既有局面、量力而行，不可冒险图大，稳中求吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_26_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "颐上九"@zh-Hans ;
    rdfs:comment "颐上九"@zh-Hans ;
    yj:lineOf yj:gua_26 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "由颐，厉，吉。"@zh-Hans ;
    yj:baihuaText "天下由此得养，责任重大而处境艰险，然终归吉利。此爻喻人以一身担当养育天下的重任，虽履险境，只要持正尽责，必获吉祥。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_26 yj:hasLine yj:gua_26_y1 ;
    yj:hasLine yj:gua_26_y2 ;
    yj:hasLine yj:gua_26_y3 ;
    yj:hasLine yj:gua_26_y4 ;
    yj:hasLine yj:gua_26_y5 ;
    yj:hasLine yj:gua_26_y6 .

yj:gua_27_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "大过初六"@zh-Hans ;
    rdfs:comment "大过初六"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "藉用白茅，无咎。"@zh-Hans ;
    yj:baihuaText "用洁白的茅草衬垫祭物，谨慎敬慎，没有灾咎。此爻喻身处非常时期，行事要格外谦卑谨慎、小心为敬，虽处柔弱亦可避害保全。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_27_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "大过九二"@zh-Hans ;
    rdfs:comment "大过九二"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "枯杨生稊，老夫得其女妻，无不利。虞翻曰，稊，穉也。杨叶未舒称稊。巽为杨，乾为老，老杨故枯。阳在二也。十二月时，周之二月。兑为雨泽，枯杨得泽复生稊。二体乾老，故称“老夫”。女妻谓上兑，兑为少女，故曰“女妻”。大过之家，过以相与，老夫得其女妻，故“无不利”。"@zh-Hans ;
    yj:baihuaText "枯杨生下新芽，老夫娶得少妻，没有不利。此爻喻衰败之中重获生机、以非常方式相济相成，虽不寻常却能转危为安、共渡难关。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_27_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "大过九三"@zh-Hans ;
    rdfs:comment "大过九三"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "栋桡，凶。"@zh-Hans ;
    yj:xiaoxiangText "栋桡之凶，不可以有辅也。"@zh-Hans ;
    yj:baihuaText "栋梁弯曲，凶险。此爻喻身当重任而刚愎自用、逞强过甚，力不副任，终致倾覆，宜及早引退或借助他力，不可独力强撑。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_27_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "大过九四"@zh-Hans ;
    rdfs:comment "大过九四"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "栋隆，吉。有他吝。"@zh-Hans ;
    yj:baihuaText "栋梁高高隆起，吉利，但旁人或有不快。此爻喻得人相助或自身得力担当，局面转好而获吉，只是难免招致他人非议，宜宽容待之。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_27_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "大过九五"@zh-Hans ;
    rdfs:comment "大过九五"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "枯杨生华，老妇得其士夫，无咎无誉。"@zh-Hans ;
    yj:baihuaText "枯杨开出花朵，老妇嫁得少夫，没有灾咎也没有赞誉。此爻喻虚有其表、好景不长，虽可暂得其名，但不足以称美，宜务实莫虚张。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_27_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "大过上六"@zh-Hans ;
    rdfs:comment "大过上六"@zh-Hans ;
    yj:lineOf yj:gua_27 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "过涉灭顶，凶，无咎。"@zh-Hans ;
    yj:baihuaText "涉水过深以致灭顶，凶险，但并非自己有过错。此爻喻非常之际过度冒险、力所难支而遭败亡，虽出于担当、情有可原，然终难免凶。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_27 yj:hasLine yj:gua_27_y1 ;
    yj:hasLine yj:gua_27_y2 ;
    yj:hasLine yj:gua_27_y3 ;
    yj:hasLine yj:gua_27_y4 ;
    yj:hasLine yj:gua_27_y5 ;
    yj:hasLine yj:gua_27_y6 .

yj:gua_28_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "坎初六"@zh-Hans ;
    rdfs:comment "坎初六"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "习坎，入于坎窞，凶。"@zh-Hans ;
    yj:baihuaText "陷入重险之中，又跌入坑坎的最深处，凶险。此爻喻初逢艰险便乱了方寸、越陷越深，宜及早反省改辙，切莫在危险里越走越远。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_28_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "坎九二"@zh-Hans ;
    rdfs:comment "坎九二"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "坎有险，求小得。"@zh-Hans ;
    yj:baihuaText "坎陷之中确有危险，只求小的所得。此爻喻虽未能一下子脱险，但守中自持、不求大得，可以小有收获，宜安于渐进、徐图脱困。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_28_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "坎六三"@zh-Hans ;
    rdfs:comment "坎六三"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "来之坎坎，险且枕，入于坎窞，勿用。"@zh-Hans ;
    yj:baihuaText "前后来去都是坑坎，既险又不稳，已入陷坑深处，不可有所作为。此爻喻险上加险、进退失据，此时最忌妄动，宜静守待机，不可贸然施为。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_28_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "坎六四"@zh-Hans ;
    rdfs:comment "坎六四"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "樽酒簋，贰用缶。内约自牖，终无咎。"@zh-Hans ;
    yj:baihuaText "以一樽酒、两簋饭，配以瓦缶盛之，从窗户送入，简约相交，终无灾咎。此爻喻险难之中以诚朴简约待人接物，真心相与即可无咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_28_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "坎九五"@zh-Hans ;
    rdfs:comment "坎九五"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "坎不盈，禔既平，无咎。"@zh-Hans ;
    yj:baihuaText "坎坑尚未填满，但水已渐渐平缓，没有灾咎。此爻喻险难将平、转机初现，宜稳守中道、等待水到渠成，不必急切，守正即可无事。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_28_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "坎上六"@zh-Hans ;
    rdfs:comment "坎上六"@zh-Hans ;
    yj:lineOf yj:gua_28 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "系用徽纆，寘于丛棘，三岁不得，凶。"@zh-Hans ;
    yj:baihuaText "被绳索捆绑，关进丛棘牢狱，三年不得解脱，凶险。此爻喻执迷险道、咎由自取，宜及早悔改守正，否则长期受灾，代价沉重。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_28 yj:hasLine yj:gua_28_y1 ;
    yj:hasLine yj:gua_28_y2 ;
    yj:hasLine yj:gua_28_y3 ;
    yj:hasLine yj:gua_28_y4 ;
    yj:hasLine yj:gua_28_y5 ;
    yj:hasLine yj:gua_28_y6 .

yj:gua_29_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "离初九"@zh-Hans ;
    rdfs:comment "离初九"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "履错然，敬之，无咎。"@zh-Hans ;
    yj:baihuaText "脚步交错杂乱之际，心存敬慎，没有灾咎。此爻喻事情初起纷杂、头绪未清，只要怀着恭敬谨慎之心，处处留心，就能避开过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_29_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "离六二"@zh-Hans ;
    rdfs:comment "离六二"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "黄离，元吉。"@zh-Hans ;
    yj:xiaoxiangText "黄离元吉，得中道也。"@zh-Hans ;
    yj:baihuaText "黄色的光明，大吉。黄为中正之色，此爻喻以中道守正、明而不失其度，柔顺居中而知分寸，因此最为吉祥，是光明正道的最佳状态。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_29_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "离九三"@zh-Hans ;
    rdfs:comment "离九三"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "日昃之离，不鼓缶而歌，则大耋之嗟，凶。"@zh-Hans ;
    yj:baihuaText "夕阳西下的光明已近黄昏，若不能击缶而歌、坦然自乐，就只能发出龙钟老迈的悲叹，凶险。此爻喻盛极将衰，宜乐观自处、通达顺变，不可一味哀叹。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_29_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "离九四"@zh-Hans ;
    rdfs:comment "离九四"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "突如，其来如，焚如，死如，弃如。"@zh-Hans ;
    yj:baihuaText "突然而来，猝然降临，如烈火焚烧，如死亡，如被弃置。此爻喻躁进妄动、来势凶暴而无所容身，警示人行事不可突兀莽撞，否则自取灭亡。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_29_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "离六五"@zh-Hans ;
    rdfs:comment "离六五"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "出涕沱若，戚嗟若，吉。"@zh-Hans ;
    yj:baihuaText "泪流满面，忧伤悲叹，反而吉利。此爻喻身处危境而能心怀忧惧、反省戒惧，正因常怀忧患之心而终获吉祥，宜保持警惕。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_29_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "离上九"@zh-Hans ;
    rdfs:comment "离上九"@zh-Hans ;
    yj:lineOf yj:gua_29 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "王用出征，有嘉折首，获匪其丑，无咎。"@zh-Hans ;
    yj:baihuaText "君王出兵征伐，斩获首恶之功，俘获的不是自己的同类，没有灾咎。此爻喻以明正之道讨伐乱者、分清敌我、只惩首恶，如此行事可无过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_29 yj:hasLine yj:gua_29_y1 ;
    yj:hasLine yj:gua_29_y2 ;
    yj:hasLine yj:gua_29_y3 ;
    yj:hasLine yj:gua_29_y4 ;
    yj:hasLine yj:gua_29_y5 ;
    yj:hasLine yj:gua_29_y6 .

yj:gua_30_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "咸初六"@zh-Hans ;
    rdfs:comment "咸初六"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "咸其母。"@zh-Hans ;
    yj:xiaoxiangText "咸其母，志在外也。"@zh-Hans ;
    yj:baihuaText "感应到脚拇指，刚刚有所触动。此爻喻情感或意念才刚萌动，尚在浅表，宜稳住不急着行动，先辨明真伪再定进退，不要轻率起步。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_30_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "咸六二"@zh-Hans ;
    rdfs:comment "咸六二"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "咸其腓，凶。居吉。"@zh-Hans ;
    yj:xiaoxiangText "虽凶居吉，顺不害也。"@zh-Hans ;
    yj:baihuaText "感应到小腿肚，此时前往凶险，安居不动则吉。此爻喻心思浮动、跃跃欲试而尚不能自主，宜静守待时，不可急进，安处反而吉利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_30_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "咸九三"@zh-Hans ;
    rdfs:comment "咸九三"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "咸其股，执其随，往咎。"@zh-Hans ;
    yj:baihuaText "感应到大腿，只知道一味追随他人，前往则有灾咎。此爻喻随人而动、丧失自主，宜自守本志、明白自己的方向，不可盲从附和。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_30_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "咸九四"@zh-Hans ;
    rdfs:comment "咸九四"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "贞吉，悔亡。憧憧往来，朋从尔思。"@zh-Hans ;
    yj:baihuaText "守正则吉，悔恨消除，但心思往来不定，朋友们只是顺着你的想法。此爻喻心念摇摆、感而不专，宜贞定专一，不可犹豫反复，方能无悔。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_30_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "咸九五"@zh-Hans ;
    rdfs:comment "咸九五"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "咸其脢，无悔。"@zh-Hans ;
    yj:baihuaText "感应到背脊肉，无所作为，没有悔恨。此爻喻感应不涉私欲、淡然处之，虽无大作为也无悔恨，宜守中自持，不必刻意求感动人。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_30_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "咸上六"@zh-Hans ;
    rdfs:comment "咸上六"@zh-Hans ;
    yj:lineOf yj:gua_30 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "咸其辅颊舌。"@zh-Hans ;
    yj:baihuaText "感应只停留在口舌之间，靠言语哄人。此爻喻以花言巧语取悦于人、感而无实，虽能一时动人却难长久，宜以诚待人，莫徒逞口舌。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_30 yj:hasLine yj:gua_30_y1 ;
    yj:hasLine yj:gua_30_y2 ;
    yj:hasLine yj:gua_30_y3 ;
    yj:hasLine yj:gua_30_y4 ;
    yj:hasLine yj:gua_30_y5 ;
    yj:hasLine yj:gua_30_y6 .

yj:gua_31_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "恒初六"@zh-Hans ;
    rdfs:comment "恒初六"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "浚恒，贞凶，无攸利。"@zh-Hans ;
    yj:baihuaText "一开始就一味求深求久，固守此法则凶，没有好处。此爻喻立恒之初便苛求深入，操之过急反易受挫，宜循序渐进、培植根基，不可急切贪深。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_31_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "恒九二"@zh-Hans ;
    rdfs:comment "恒九二"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "悔亡。"@zh-Hans ;
    yj:baihuaText "悔恨消除。此爻喻身居下位而能长久守中，不偏不倚，因此先前的不安与悔恨都已消散，宜继续持中守正，安然处事。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_31_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "恒九三"@zh-Hans ;
    rdfs:comment "恒九三"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "不恒其德，或承之羞，贞吝。"@zh-Hans ;
    yj:baihuaText "不能恒守其德，或许会招来羞辱，固守此态则艰吝。此爻喻为人反复无常、失了操守，终将无以容身，宜坚定操守，不可朝三暮四。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_31_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "恒九四"@zh-Hans ;
    rdfs:comment "恒九四"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "田无禽。"@zh-Hans ;
    yj:xiaoxiangText "久非其位，安得禽也。"@zh-Hans ;
    yj:baihuaText "田野里没有禽兽可得。此爻喻长久守错方向、久而无功，方法或处所不对，再久也无所获，宜及时调整方向，莫在错路上空耗。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_31_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "恒六五"@zh-Hans ;
    rdfs:comment "恒六五"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "恒其德，贞妇人吉，夫子凶。"@zh-Hans ;
    yj:baihuaText "恒守其德，固守此道，对妇人吉利，对男子则凶。此爻喻一味顺从守常，宜柔弱者持之，若刚健者当断不断、只知因循，反会误事招凶。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_31_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "恒上六"@zh-Hans ;
    rdfs:comment "恒上六"@zh-Hans ;
    yj:lineOf yj:gua_31 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "震恒，凶。"@zh-Hans ;
    yj:xiaoxiangText "震恒在上，大无功也。"@zh-Hans ;
    yj:baihuaText "以震动为恒常，凶险。此爻喻把躁动不安当作常态，终日摇荡无定，必致凶险，宜沉下心来守定根本，不可长久地浮躁妄动。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_31 yj:hasLine yj:gua_31_y1 ;
    yj:hasLine yj:gua_31_y2 ;
    yj:hasLine yj:gua_31_y3 ;
    yj:hasLine yj:gua_31_y4 ;
    yj:hasLine yj:gua_31_y5 ;
    yj:hasLine yj:gua_31_y6 .

yj:gua_32_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "遁初六"@zh-Hans ;
    rdfs:comment "遁初六"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "遁尾，厉，勿用有攸往。"@zh-Hans ;
    yj:baihuaText "退避落在最后，处境危险。既然已经落后、走不脱，就不要急着有所行动，原地静守、不妄动，反而免于灾祸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_32_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "遁六二"@zh-Hans ;
    rdfs:comment "遁六二"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "执之用黄牛之革，莫之胜说。"@zh-Hans ;
    yj:baihuaText "用黄牛皮绳牢牢捆住，谁也解不开。象征在退避之时志意坚固、前后相随，与上位者紧密联结，坚守不移便无咎害。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_32_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "遁九三"@zh-Hans ;
    rdfs:comment "遁九三"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "系遁，有疾厉，畜臣妾，吉。"@zh-Hans ;
    yj:baihuaText "想退却被牵系住，心有牵挂而生忧患危厉。此时只宜操持家内小事、抚养仆役，不宜承担大事，守住分内即可得吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_32_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "遁九四"@zh-Hans ;
    rdfs:comment "遁九四"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "好遁，君子吉，小人否。"@zh-Hans ;
    yj:baihuaText "喜好而恰当地退避，能全身而退。君子识时务、能舍能退，故吉；小人贪恋不去，反受其害。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_32_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "遁九五"@zh-Hans ;
    rdfs:comment "遁九五"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "嘉遁，贞吉。"@zh-Hans ;
    yj:baihuaText "退避得体、光明正大，是合于正道的嘉美之退。居中得位，去留从容而不失其时，守正便可获吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_32_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "遁上九"@zh-Hans ;
    rdfs:comment "遁上九"@zh-Hans ;
    yj:lineOf yj:gua_32 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "肥遁，无不利。"@zh-Hans ;
    yj:baihuaText "远远退避，无所牵挂，超然于纷争之外。处在退避的最高处，了无犹豫滞碍，故无往不利。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_32 yj:hasLine yj:gua_32_y1 ;
    yj:hasLine yj:gua_32_y2 ;
    yj:hasLine yj:gua_32_y3 ;
    yj:hasLine yj:gua_32_y4 ;
    yj:hasLine yj:gua_32_y5 ;
    yj:hasLine yj:gua_32_y6 .

yj:gua_33_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "大壮初九"@zh-Hans ;
    rdfs:comment "大壮初九"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "壮于趾，征凶，有孚。"@zh-Hans ;
    yj:baihuaText "脚趾就先逞强冒进，躁动于下而不知自重，这样前行必有凶险。壮盛之时更须沉住气，不要一开始就轻举妄动。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_33_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "大壮九二"@zh-Hans ;
    rdfs:comment "大壮九二"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "贞吉。"@zh-Hans ;
    yj:xiaoxiangText "九二贞吉，以中也。"@zh-Hans ;
    yj:baihuaText "居中守正，刚而不躁，恰到好处。此时安守正道、不逞意气，自能获吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_33_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "大壮九三"@zh-Hans ;
    rdfs:comment "大壮九三"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。"@zh-Hans ;
    yj:baihuaText "小人一味逞强用力，君子却不用蛮力。如公羊以角顶篱笆、角被卡住，进退两难。逞强者守正也危，宜收敛锋芒。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_33_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "大壮九四"@zh-Hans ;
    rdfs:comment "大壮九四"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "贞吉，悔亡。藩决不羸，壮于大舆之腹。"@zh-Hans ;
    yj:xiaoxiangText "藩决不赢尚往也。"@zh-Hans ;
    yj:baihuaText "守正则吉，悔恨消除。篱笆已开、角不再被卡，力量如同大车的车轴，刚强而能行，是因正而通畅。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_33_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "大壮六五"@zh-Hans ;
    rdfs:comment "大壮六五"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "丧羊于易，无悔。"@zh-Hans ;
    yj:baihuaText "以柔居尊，如羊走失于平易之地，失去刚壮之态。但柔顺处中、不与人争，反而没有悔恨。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_33_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "大壮上六"@zh-Hans ;
    rdfs:comment "大壮上六"@zh-Hans ;
    yj:lineOf yj:gua_33 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "羝羊触藩，不能退，不能遂，无攸利，艰则吉。"@zh-Hans ;
    yj:baihuaText "如公羊顶篱笆，角被卡住，退不得也进不得，做什么都不利。唯有在艰难中静守，才能转为吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_33 yj:hasLine yj:gua_33_y1 ;
    yj:hasLine yj:gua_33_y2 ;
    yj:hasLine yj:gua_33_y3 ;
    yj:hasLine yj:gua_33_y4 ;
    yj:hasLine yj:gua_33_y5 ;
    yj:hasLine yj:gua_33_y6 .

yj:gua_34_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "晋初六"@zh-Hans ;
    rdfs:comment "晋初六"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "晋如，摧如，贞吉。罔孚，裕无咎。"@zh-Hans ;
    yj:baihuaText "想上进却遭挫折，一时不得信任。此时不必强求，守正则吉；未获信任时从容宽缓，反能免咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_34_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "晋六二"@zh-Hans ;
    rdfs:comment "晋六二"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "晋如，愁如，贞吉。受兹介福于其王母。"@zh-Hans ;
    yj:baihuaText "上进之中又有忧愁，处境不顺。但居中守正，终能获吉，如从王母那里承受大福，耐心坚守自有回报。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_34_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "晋六三"@zh-Hans ;
    rdfs:comment "晋六三"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "众允，悔亡。"@zh-Hans ;
    yj:baihuaText "与众人同心，得到广泛认同，悔恨消失。处在上下交接之际，凭众望所归和顺而行，可以继续向上。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_34_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "晋九四"@zh-Hans ;
    rdfs:comment "晋九四"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "晋如硕鼠，贞厉。"@zh-Hans ;
    yj:baihuaText "上进却如贪硕的大鼠，窃据不当之位、贪得无厌，守此必有危厉。德不配位者当自省退让。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_34_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "晋六五"@zh-Hans ;
    rdfs:comment "晋六五"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "悔亡，矢得勿恤，往吉，无不利。"@zh-Hans ;
    yj:baihuaText "悔恨消除，不必忧虑得失（如射箭有所失也不挂怀），前行必吉，无往不利。居尊得中、光明磊落，故大通。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_34_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "晋上九"@zh-Hans ;
    rdfs:comment "晋上九"@zh-Hans ;
    yj:lineOf yj:gua_34 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "晋其角，惟用伐邑，厉吉无咎，贞吝。"@zh-Hans ;
    yj:baihuaText "进到极点如兽之角，锋芒过盛。只宜用于整治自己的封邑，虽危而尚可吉、无咎，但守此终究有其羞吝。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_34 yj:hasLine yj:gua_34_y1 ;
    yj:hasLine yj:gua_34_y2 ;
    yj:hasLine yj:gua_34_y3 ;
    yj:hasLine yj:gua_34_y4 ;
    yj:hasLine yj:gua_34_y5 ;
    yj:hasLine yj:gua_34_y6 .

yj:gua_35_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "明夷初九"@zh-Hans ;
    rdfs:comment "明夷初九"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "明夷于飞，垂其翼。君子于行，三日不食。有攸往，主人有言。"@zh-Hans ;
    yj:baihuaText "光明受损如鸟飞而垂下翅膀。君子处此乱世，远行避险、忍饥三日；有所前往，主人会有微词。宜低调远害。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_35_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "明夷六二"@zh-Hans ;
    rdfs:comment "明夷六二"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "明夷于左股，用拯马壮，吉。"@zh-Hans ;
    yj:baihuaText "光明受伤，损及左腿。但尚能借强壮之马救助自己，及时补救、柔顺守则，因而能获吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_35_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "明夷九三"@zh-Hans ;
    rdfs:comment "明夷九三"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "明夷于南狩，得其大首，不可疾贞。"@zh-Hans ;
    yj:baihuaText "在南方狩猎般的行动中重创黑暗，擒得罪魁祸首。但不可操之过急、急求正治，要顾及时势、循序渐进。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_35_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "明夷六四"@zh-Hans ;
    rdfs:comment "明夷六四"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "入于左腹，获明夷之心，于出门庭。"@zh-Hans ;
    yj:baihuaText "深入敌腹之侧，探知了明夷之人的真实心意。此时应尽早抽身、退出其门庭，及时脱离险境。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_35_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "明夷六五"@zh-Hans ;
    rdfs:comment "明夷六五"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "箕子之明夷，利贞。"@zh-Hans ;
    yj:baihuaText "如箕子那样在昏暗中韬晦守贞。身处暗世而能坚守正道、内明不灭，故利于守正。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_35_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "明夷上六"@zh-Hans ;
    rdfs:comment "明夷上六"@zh-Hans ;
    yj:lineOf yj:gua_35 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "不明晦，初登于天，后入于地。"@zh-Hans ;
    yj:baihuaText "昏暗至极，不再光明。起初高居天上、光照四方，最终却坠入地下、失去法则。示戒：昏君必自取败亡。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_35 yj:hasLine yj:gua_35_y1 ;
    yj:hasLine yj:gua_35_y2 ;
    yj:hasLine yj:gua_35_y3 ;
    yj:hasLine yj:gua_35_y4 ;
    yj:hasLine yj:gua_35_y5 ;
    yj:hasLine yj:gua_35_y6 .

yj:gua_36_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "家人初九"@zh-Hans ;
    rdfs:comment "家人初九"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "闲有家，悔亡。"@zh-Hans ;
    yj:xiaoxiangText "闲有家，志未变也。"@zh-Hans ;
    yj:baihuaText "治家之初就要立好规矩、防患于未然。及早端正家风、约束于初，悔恨自然消除。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_36_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "家人六二"@zh-Hans ;
    rdfs:comment "家人六二"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "无攸遂，在中馈，贞吉。"@zh-Hans ;
    yj:baihuaText "不必自作主张、独断专行，安心操持家中饮食之事。以柔顺居中守其本分，守正则吉。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_36_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "家人九三"@zh-Hans ;
    rdfs:comment "家人九三"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "家人嗃嗃，悔厉吉。妇子嘻嘻，终吝。"@zh-Hans ;
    yj:baihuaText "治家过于严厉，虽有悔厉却终究得吉；若一味嬉笑放松，反会失去家节、终致羞吝。严慈须有度。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_36_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "家人六四"@zh-Hans ;
    rdfs:comment "家人六四"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "富家大吉。"@zh-Hans ;
    yj:xiaoxiangText "富家大吉，顺在位也。"@zh-Hans ;
    yj:baihuaText "善于持家、使家境富足，大吉。以柔顺当位、各守其分，家业自然兴旺。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_36_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "家人九五"@zh-Hans ;
    rdfs:comment "家人九五"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "王假有家，勿恤，吉。"@zh-Hans ;
    yj:baihuaText "君上以德感化而拥有这个家，上下相亲。不必忧虑，一家人交相爱戴，自然获吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_36_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "家人上九"@zh-Hans ;
    rdfs:comment "家人上九"@zh-Hans ;
    yj:lineOf yj:gua_36 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "有孚威加，终吉。"@zh-Hans ;
    yj:baihuaText "以诚信和威严临家，言行有物而令人敬服。有孚而又有威，终能获吉，是反身自省之效。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_36 yj:hasLine yj:gua_36_y1 ;
    yj:hasLine yj:gua_36_y2 ;
    yj:hasLine yj:gua_36_y3 ;
    yj:hasLine yj:gua_36_y4 ;
    yj:hasLine yj:gua_36_y5 ;
    yj:hasLine yj:gua_36_y6 .

yj:gua_37_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "睽初九"@zh-Hans ;
    rdfs:comment "睽初九"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "悔亡，丧马勿逐自复，见恶人，无咎。"@zh-Hans ;
    yj:xiaoxiangText "见恶人，以避咎也。"@zh-Hans ;
    yj:baihuaText "悔恨消除。失马不必追，自会回来；遇见恶人也不必计较，以宽厚相待，反而无咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_37_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "睽九二"@zh-Hans ;
    rdfs:comment "睽九二"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "遇主于巷，无咎。"@zh-Hans ;
    yj:baihuaText "在小巷中不期而遇志同道合之主。虽处背离之境，仍能曲径遇合，故无咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_37_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "睽六三"@zh-Hans ;
    rdfs:comment "睽六三"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "见舆曳，其牛觢。其人天且劓，无初有终。"@zh-Hans ;
    yj:baihuaText "见车被拖曳、牛被牵掣，又遭刑伤之厄，处境极困。但开始不顺、最终有合，坚持下去终有结果。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_37_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "睽九四"@zh-Hans ;
    rdfs:comment "睽九四"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "睽孤遇元夫，交孚，厉，无咎。"@zh-Hans ;
    yj:baihuaText "背离孤立之中遇见刚正之人，彼此以诚相交、互相信任。虽有危厉，终无咎害。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_37_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "睽六五"@zh-Hans ;
    rdfs:comment "睽六五"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "悔亡，厥宗噬肤，往何咎。"@zh-Hans ;
    yj:baihuaText "悔恨消除。同宗之人如啮肤般亲密相助，前往依附又有何咎，宜主动靠拢、趋向正道。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_37_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "睽上九"@zh-Hans ;
    rdfs:comment "睽上九"@zh-Hans ;
    yj:lineOf yj:gua_37 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "睽孤，见豕负涂，载鬼一车。先张之弧，后说之壶，匪寇婚媾。往遇雨则吉。"@zh-Hans ;
    yj:baihuaText "背离孤绝，疑心生暗鬼：见猪背污泥、疑车载鬼，先张弓欲射、后又放下。疑虑既消、原来非敌而是婚配之好，前往遇雨即吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_37 yj:hasLine yj:gua_37_y1 ;
    yj:hasLine yj:gua_37_y2 ;
    yj:hasLine yj:gua_37_y3 ;
    yj:hasLine yj:gua_37_y4 ;
    yj:hasLine yj:gua_37_y5 ;
    yj:hasLine yj:gua_37_y6 .

yj:gua_38_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "蹇初六"@zh-Hans ;
    rdfs:comment "蹇初六"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "往蹇，来誉。"@zh-Hans ;
    yj:baihuaText "前往遇险，退回来反得称誉，是见险知止、待时而动。此时不宜冒进，宜静候时机。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_38_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "蹇六二"@zh-Hans ;
    rdfs:comment "蹇六二"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "王臣蹇蹇，匪躬之故。"@zh-Hans ;
    yj:baihuaText "身为人臣而屡遭艰险，不是为自身私利，而是为公家之事。虽历尽艰难，终究没有过失。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_38_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "蹇九三"@zh-Hans ;
    rdfs:comment "蹇九三"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "往蹇，来反。"@zh-Hans ;
    yj:baihuaText "前往有险，反身退守，回归本处。险在前而懂得折返，家人相守而喜，稳妥为上。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_38_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "蹇六四"@zh-Hans ;
    rdfs:comment "蹇六四"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "往蹇，来连。"@zh-Hans ;
    yj:baihuaText "独自前往有险，退回来与人相连结。处在上下之间，退而联合众力、依托相助，方为妥当。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_38_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "蹇九五"@zh-Hans ;
    rdfs:comment "蹇九五"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "大蹇，朋来。"@zh-Hans ;
    yj:baihuaText "身处大难之中，但居中守节、德孚于众，故有志同道合的朋辈前来相助，患难可解。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_38_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "蹇上六"@zh-Hans ;
    rdfs:comment "蹇上六"@zh-Hans ;
    yj:lineOf yj:gua_38 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "往蹇，来硕吉，利见大人。"@zh-Hans ;
    yj:baihuaText "前往有险，退回来反而大有收获，故吉。此时宜见大人、依附尊贵者，共济艰难。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_38 yj:hasLine yj:gua_38_y1 ;
    yj:hasLine yj:gua_38_y2 ;
    yj:hasLine yj:gua_38_y3 ;
    yj:hasLine yj:gua_38_y4 ;
    yj:hasLine yj:gua_38_y5 ;
    yj:hasLine yj:gua_38_y6 .

yj:gua_39_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "解初六"@zh-Hans ;
    rdfs:comment "解初六"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "无咎。"@zh-Hans ;
    yj:baihuaText "险难初解之时，柔顺守下、与刚相应，安分而不躁动，因此没有咎害。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_39_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "解九二"@zh-Hans ;
    rdfs:comment "解九二"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "田获三狐，得黄矢，贞吉。"@zh-Hans ;
    yj:baihuaText "如打猎收获三只狐狸、得到黄矢，除去隐患、得中正之力。居中守正，故获吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_39_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "解六三"@zh-Hans ;
    rdfs:comment "解六三"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "负且乘，致寇至，贞吝。"@zh-Hans ;
    yj:baihuaText "背着东西又乘车，德不配位、招摇过市，以致招来盗寇。这是自己招祸，守此必有羞吝。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_39_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "解九四"@zh-Hans ;
    rdfs:comment "解九四"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "解而母，朋至斯孚。"@zh-Hans ;
    yj:baihuaText "解除之际，宜舍去身边拖累牵绊之人（如舍其母），同心之朋到来，彼此方能以诚相信。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_39_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "解六五"@zh-Hans ;
    rdfs:comment "解六五"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "君子惟有解，吉。有孚于小人。"@zh-Hans ;
    yj:baihuaText "君子唯有解除险难、化解纠结，才可得吉；同时以诚信感化、取信于小人，使众心归附。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_39_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "解上六"@zh-Hans ;
    rdfs:comment "解上六"@zh-Hans ;
    yj:lineOf yj:gua_39 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "公用射隼于高庸之上，获之，无不利。"@zh-Hans ;
    yj:baihuaText "如王公在高墙之上射落凶隼，一举除去悖乱之人。解除祸患、肃清障碍，无往不利。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_39 yj:hasLine yj:gua_39_y1 ;
    yj:hasLine yj:gua_39_y2 ;
    yj:hasLine yj:gua_39_y3 ;
    yj:hasLine yj:gua_39_y4 ;
    yj:hasLine yj:gua_39_y5 ;
    yj:hasLine yj:gua_39_y6 .

yj:gua_40_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "损初九"@zh-Hans ;
    rdfs:comment "损初九"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "祀事遄往，无咎，酌损之。"@zh-Hans ;
    yj:baihuaText "事情紧急且合于道义，就应尽快前往操办，不必过多计较得失，没有过失。但减损的分寸要斟酌，不可一味付出而伤了自己。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_40_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "损九二"@zh-Hans ;
    rdfs:comment "损九二"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "利贞，征凶，弗损益之。"@zh-Hans ;
    yj:baihuaText "宜守正，不宜轻率进取，冒进前往反有凶险。此时不必自我减损，守护好自己的立场，就是最好的增益。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_40_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "损六三"@zh-Hans ;
    rdfs:comment "损六三"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "三人行，则损一人。一人行，则得其友。"@zh-Hans ;
    yj:baihuaText "三人同行，必损去一人；一人独行，反能寻得志同之友。说明人多易生猜疑，专心专一才能得真正的伙伴。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_40_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "损六四"@zh-Hans ;
    rdfs:comment "损六四"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "损其疾，使遄有喜，无咎。"@zh-Hans ;
    yj:baihuaText "减损自身的毛病缺点，行动迅速便能转忧为喜，没有过失。改正过失要趁早，越快越好。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_40_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "损六五"@zh-Hans ;
    rdfs:comment "损六五"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "或益之十朋之龟，弗克违，元吉。"@zh-Hans ;
    yj:baihuaText "有人送他价值十朋的大宝龟，推辞不掉，大为吉祥。说明居尊而虚己受助，是自天佑之的福分。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_40_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "损上九"@zh-Hans ;
    rdfs:comment "损上九"@zh-Hans ;
    yj:lineOf yj:gua_40 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "弗损益之，无咎，贞吉。利有攸往，得臣无家。"@zh-Hans ;
    yj:baihuaText "不必减损自己就能增益于人，无过失，守正则吉，宜于有所行动，可以得到臣民归附而不据为私产。损己为人大得人心。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_40 yj:hasLine yj:gua_40_y1 ;
    yj:hasLine yj:gua_40_y2 ;
    yj:hasLine yj:gua_40_y3 ;
    yj:hasLine yj:gua_40_y4 ;
    yj:hasLine yj:gua_40_y5 ;
    yj:hasLine yj:gua_40_y6 .

yj:gua_41_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "益初九"@zh-Hans ;
    rdfs:comment "益初九"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "利用为大作，元吉，无咎。"@zh-Hans ;
    yj:baihuaText "正是大有作为的好时机，宜依靠有利条件做一番大事业，大吉而无过失。但要珍惜所获，不可浪费，谨守本分方为长久。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_41_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "益六二"@zh-Hans ;
    rdfs:comment "益六二"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "或益之十朋之龟，弗克违，永贞吉。王用享于帝，吉。"@zh-Hans ;
    yj:baihuaText "有人馈赠他价值十朋的宝龟，推辞不掉，长久守正则吉；君王以此祭祀上帝，吉祥。虚心受惠而心存诚敬，自得福佑。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_41_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "益六三"@zh-Hans ;
    rdfs:comment "益六三"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "益之用凶事，无咎。有孚中行，告公用圭。"@zh-Hans ;
    yj:baihuaText "用增益之法去解救祸患危难，没有过失。心怀诚信、行事中正，捧圭告公，可得信任与支持。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_41_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "益六四"@zh-Hans ;
    rdfs:comment "益六四"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "中行，告公从，利用为依迁邦。"@zh-Hans ;
    yj:baihuaText "行事守中道，禀告公上便能得到顺从，宜依靠这样的人成就大事、迁都安邦。忠心得用，可托付重任。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_41_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "益九五"@zh-Hans ;
    rdfs:comment "益九五"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "有孚惠心，勿问，元吉。有孚惠我德。"@zh-Hans ;
    yj:baihuaText "心怀诚信与惠人之心，不必多问占卜便有元吉；因为有诚信，别人也会感念你的恩德。施惠出诚，福报自然而来。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_41_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "益上九"@zh-Hans ;
    rdfs:comment "益上九"@zh-Hans ;
    yj:lineOf yj:gua_41 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "莫益之，或击之，立心勿恒，凶。"@zh-Hans ;
    yj:baihuaText "没有人再来增益他，反有人攻击他；若立心反复不定，凶险。说明一味贪求而不施予，终会招致孤立。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_41 yj:hasLine yj:gua_41_y1 ;
    yj:hasLine yj:gua_41_y2 ;
    yj:hasLine yj:gua_41_y3 ;
    yj:hasLine yj:gua_41_y4 ;
    yj:hasLine yj:gua_41_y5 ;
    yj:hasLine yj:gua_41_y6 .

yj:gua_42_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "夬初九"@zh-Hans ;
    rdfs:comment "夬初九"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "壮于前趾，往不胜为咎。"@zh-Hans ;
    yj:baihuaText "逞强抢先，贸然向前，力不能胜就会招致过失。做事要量力而行，不可凭一时血气之勇。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_42_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "夬九二"@zh-Hans ;
    rdfs:comment "夬九二"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "惕号，莫夜有戎，勿恤。"@zh-Hans ;
    yj:baihuaText "保持警惕，高声呼号戒惧，即使夜里有敌来袭也不必忧虑。居中守正、有备无患，则可安然无险。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_42_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "夬九三"@zh-Hans ;
    rdfs:comment "夬九三"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "壮于頄，有凶。君子夬夬，独行遇雨。若濡有愠，无咎。"@zh-Hans ;
    yj:baihuaText "怒气形于颜色，面露强硬，有凶险。君子当果断而独自前行，纵遇风雨沾湿、受人埋怨，只要能持守，终无过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_42_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "夬九四"@zh-Hans ;
    rdfs:comment "夬九四"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "臀无肤，其行次且。牵羊悔亡，闻言不信。"@zh-Hans ;
    yj:baihuaText "处境困顿如臀部无肤、行走艰难，犹豫不前。若能像牵羊人那样顺势而行，悔恨可消；可惜听闻忠言却不肯相信，终身受累。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_42_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "夬九五"@zh-Hans ;
    rdfs:comment "夬九五"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "苋陆夬夬，中行无咎。"@zh-Hans ;
    yj:baihuaText "清除奸邪如拔除苋陆之草，果断彻底，行事守中道则没有过失。除害要坚决，但也要把握分寸。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_42_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "夬上六"@zh-Hans ;
    rdfs:comment "夬上六"@zh-Hans ;
    yj:lineOf yj:gua_42 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "无号，终有凶。"@zh-Hans ;
    yj:baihuaText "危机已至，呼号求救也无用，终究有凶。说明小人之势到了尽头，终难长久。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_42 yj:hasLine yj:gua_42_y1 ;
    yj:hasLine yj:gua_42_y2 ;
    yj:hasLine yj:gua_42_y3 ;
    yj:hasLine yj:gua_42_y4 ;
    yj:hasLine yj:gua_42_y5 ;
    yj:hasLine yj:gua_42_y6 .

yj:gua_43_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "姤初六"@zh-Hans ;
    rdfs:comment "姤初六"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "系于金柅，贞吉。有攸往，见凶。羸豕孚蹄遯。"@zh-Hans ;
    yj:baihuaText "像被系在铜制刹车木上一样加以约束，守正则吉；若贸然前往，反有凶险。此时当节制妄动，防微杜渐。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_43_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "姤九二"@zh-Hans ;
    rdfs:comment "姤九二"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "包有鱼，无咎，不利宾。"@zh-Hans ;
    yj:baihuaText "厨中包着鱼，没有过失，但不宜拿去招待宾客。管好自己分内之物即可，不必外示于人。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_43_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "姤九三"@zh-Hans ;
    rdfs:comment "姤九三"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "臀无肤，其行次且，厉，无大咎。"@zh-Hans ;
    yj:baihuaText "处境困顿，如同臀部无肤、行走艰难，危险但无大的过失。进退两难时，忍耐守候，尚不至大祸。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_43_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "姤九四"@zh-Hans ;
    rdfs:comment "姤九四"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "包无鱼，起凶。"@zh-Hans ;
    yj:baihuaText "厨中没有鱼，凶险将起。说明远离了下层的民众，失去了应得的支持。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_43_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "姤九五"@zh-Hans ;
    rdfs:comment "姤九五"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "以杞苞瓜，含章，有陨自天。"@zh-Hans ;
    yj:baihuaText "像用杞树枝条护住瓜果一样，内藏美质而不外露，会有意外的天降之福。居中守正，静待时机，福自天来。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_43_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "姤上九"@zh-Hans ;
    rdfs:comment "姤上九"@zh-Hans ;
    yj:lineOf yj:gua_43 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "姤其角，吝，无咎。"@zh-Hans ;
    yj:baihuaText "遇到的是坚硬的角，处境窘困有惜，但还能免于过失。上到极高之处相逢无门，当知收敛，方可免咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_43 yj:hasLine yj:gua_43_y1 ;
    yj:hasLine yj:gua_43_y2 ;
    yj:hasLine yj:gua_43_y3 ;
    yj:hasLine yj:gua_43_y4 ;
    yj:hasLine yj:gua_43_y5 ;
    yj:hasLine yj:gua_43_y6 .

yj:gua_44_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "萃初六"@zh-Hans ;
    rdfs:comment "萃初六"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "有孚不终，乃乱乃萃。若号，一握为笑，勿恤，往无咎。"@zh-Hans ;
    yj:baihuaText "心存诚信却不能始终如一，于是乱糟糟聚在一起。若能及时呼求救正，一握之间便可转忧为笑，不必忧虑，前往无过失。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_44_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "萃六二"@zh-Hans ;
    rdfs:comment "萃六二"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "引吉，无咎。孚乃利用禴。"@zh-Hans ;
    yj:baihuaText "被人引荐而相聚，吉祥无过失。心怀诚信，即便用微薄的祭品也可以祭享。真诚胜过排场。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_44_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "萃六三"@zh-Hans ;
    rdfs:comment "萃六三"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "萃如嗟如，无攸利，往无咎，小吝。"@zh-Hans ;
    yj:baihuaText "想聚而难以聚，叹息哀伤，没有什么利益。前往虽无过失，也有小小的惜憾。勉强求聚不如安守其位。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_44_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "萃九四"@zh-Hans ;
    rdfs:comment "萃九四"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "大吉无咎。"@zh-Hans ;
    yj:xiaoxiangText "大吉无咎，位不当也。"@zh-Hans ;
    yj:baihuaText "大吉而没有过失。居下位上承尊者，得聚合之利，但须以正直行事，才可保此吉象。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_44_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "萃九五"@zh-Hans ;
    rdfs:comment "萃九五"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "萃有位，无咎，匪孚。元永贞，悔亡。"@zh-Hans ;
    yj:baihuaText "身居其位而聚合众人，没有过失，但未必人人信服。唯有长久守正，悔恨才会消失。聚人须以德服人。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_44_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "萃上六"@zh-Hans ;
    rdfs:comment "萃上六"@zh-Hans ;
    yj:lineOf yj:gua_44 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "赍资涕洟，无咎。"@zh-Hans ;
    yj:baihuaText "携带财物钱财相投，涕泪交流，没有过失。虽然处境不安，然诚心归依，仍可免咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_44 yj:hasLine yj:gua_44_y1 ;
    yj:hasLine yj:gua_44_y2 ;
    yj:hasLine yj:gua_44_y3 ;
    yj:hasLine yj:gua_44_y4 ;
    yj:hasLine yj:gua_44_y5 ;
    yj:hasLine yj:gua_44_y6 .

yj:gua_45_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "升初六"@zh-Hans ;
    rdfs:comment "升初六"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "允升，大吉。"@zh-Hans ;
    yj:baihuaText "获得信任而被允许上升，大为吉祥。上级与自己志同道合，正是上进的好开端。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_45_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "升九二"@zh-Hans ;
    rdfs:comment "升九二"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "孚乃利用禴，无咎。"@zh-Hans ;
    yj:baihuaText "心怀诚信，即便用微薄的祭品祭享也可，没有过失。以诚相待，自得喜悦与助力。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_45_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "升九三"@zh-Hans ;
    rdfs:comment "升九三"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "升虚邑。"@zh-Hans ;
    yj:baihuaText "上升进入一座空虚的城邑，畅行无阻。说明时势顺遂、无所疑虑，可顺利进取。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_45_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "升六四"@zh-Hans ;
    rdfs:comment "升六四"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "王用享于岐山，吉，无咎。"@zh-Hans ;
    yj:baihuaText "君王在岐山举行享祭，吉祥而无过失。顺势行事、恭敬谨慎，位高而不失其正。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_45_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "升六五"@zh-Hans ;
    rdfs:comment "升六五"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "贞吉，升阶。"@zh-Hans ;
    yj:baihuaText "守正则吉，如登台阶一样步步上升。居中得位，大志得以实现，前程可观。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_45_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "升上六"@zh-Hans ;
    rdfs:comment "升上六"@zh-Hans ;
    yj:lineOf yj:gua_45 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "冥升，利于不息之贞。"@zh-Hans ;
    yj:baihuaText "在昏暗中一味上升，仍宜守持不息不懈的正道。上升到了极高处，当知收敛自守，方可长久。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_45 yj:hasLine yj:gua_45_y1 ;
    yj:hasLine yj:gua_45_y2 ;
    yj:hasLine yj:gua_45_y3 ;
    yj:hasLine yj:gua_45_y4 ;
    yj:hasLine yj:gua_45_y5 ;
    yj:hasLine yj:gua_45_y6 .

yj:gua_46_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "困初六"@zh-Hans ;
    rdfs:comment "困初六"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "臀困于株木。入于幽谷，三岁不觌。"@zh-Hans ;
    yj:baihuaText "像臀部困坐在枯树桩上一样，进退不得，又陷入幽深山谷，三年也见不到人。处境极为闭塞，当耐心等待。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_46_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "困九二"@zh-Hans ;
    rdfs:comment "困九二"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "困于酒食，朱绂方来，利用享祀，征凶。无咎。"@zh-Hans ;
    yj:baihuaText "困于酒食之中，朱红的官服正要送来，宜祭祀祈福，但贸然出征则有凶险，然若能守正，也可免咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_46_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "困六三"@zh-Hans ;
    rdfs:comment "困六三"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "困于石，据于蒺藜，入于其宫，不见其妻，凶。"@zh-Hans ;
    yj:baihuaText "困在坚石之下，手抓蒺藜之上，进入家中又见不到妻子，凶险。进退失据、内外无援，最为凶险。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_46_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "困九四"@zh-Hans ;
    rdfs:comment "困九四"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "来荼荼，困于金车，吝，有终。"@zh-Hans ;
    yj:baihuaText "来势迟缓蹒跚，又困于金车的阻隔，处境艰难令人惜，但最终尚能收场。虽受制于人，仍可徐图出路。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_46_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "困九五"@zh-Hans ;
    rdfs:comment "困九五"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "劓刖，困于赤绂，乃徐有说，利用祭祀。"@zh-Hans ;
    yj:baihuaText "遭受劓、刖一样的挫伤，受困于赤绂之下，但慢慢会得到解脱，宜祭祀祈福。中正之德终能施予于人、受福于人。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_46_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "困上六"@zh-Hans ;
    rdfs:comment "困上六"@zh-Hans ;
    yj:lineOf yj:gua_46 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "困于葛藟，于臲兀，曰动悔有悔，征吉。"@zh-Hans ;
    yj:baihuaText "被葛藤缠困，处境动摇不安。若能觉悟到妄动招悔，便可知悔而改、前往则吉。困极思变，及时行动便可脱困。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_46 yj:hasLine yj:gua_46_y1 ;
    yj:hasLine yj:gua_46_y2 ;
    yj:hasLine yj:gua_46_y3 ;
    yj:hasLine yj:gua_46_y4 ;
    yj:hasLine yj:gua_46_y5 ;
    yj:hasLine yj:gua_46_y6 .

yj:gua_47_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "井初六"@zh-Hans ;
    rdfs:comment "井初六"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "井泥不食，旧井无禽。"@zh-Hans ;
    yj:baihuaText "井水浑浊不能饮用，废弃的旧井连飞禽都不来了。说明居于下位、久无更新，终将被时代舍弃。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_47_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "井九二"@zh-Hans ;
    rdfs:comment "井九二"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "井谷射鲋，瓮敝漏。"@zh-Hans ;
    yj:baihuaText "井中只能射到小鱼，汲水的陶瓮又破漏漏水。有才能而不被任用，无所依靠，白白浪费了资源。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_47_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "井九三"@zh-Hans ;
    rdfs:comment "井九三"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "井渫不食，为我心恻。可用汲，王明，并受其福。"@zh-Hans ;
    yj:baihuaText "井已淘净却无人来饮，令我心中恻然；其实可以去汲用，若遇明主，则上下同受其福。贤才当等待赏识之人。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_47_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "井六四"@zh-Hans ;
    rdfs:comment "井六四"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "井甃，无咎。"@zh-Hans ;
    yj:baihuaText "修整井壁，没有过失。适时修缮自守，虽不能大有作为，却也没有过患。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_47_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "井九五"@zh-Hans ;
    rdfs:comment "井九五"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "井冽，寒泉食。"@zh-Hans ;
    yj:baihuaText "井水清冽，寒泉可饮。居中守正，才德如清泉般为人所用，是养人的正道。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_47_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "井上六"@zh-Hans ;
    rdfs:comment "井上六"@zh-Hans ;
    yj:lineOf yj:gua_47 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "井收勿幕，有孚元吉。"@zh-Hans ;
    yj:baihuaText "汲水已成，不必盖住井口，任人取用，心怀诚信，大为吉祥。为人大方施予、惠而不吝，成就最大。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_47 yj:hasLine yj:gua_47_y1 ;
    yj:hasLine yj:gua_47_y2 ;
    yj:hasLine yj:gua_47_y3 ;
    yj:hasLine yj:gua_47_y4 ;
    yj:hasLine yj:gua_47_y5 ;
    yj:hasLine yj:gua_47_y6 .

yj:gua_48_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "革初九"@zh-Hans ;
    rdfs:comment "革初九"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "巩用黄牛之革。"@zh-Hans ;
    yj:baihuaText "变革之初，如用黄牛皮把东西牢牢捆住，时机未到，只宜固守不动，不可轻率有所作为，此时急于求变反招祸患。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_48_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "革六二"@zh-Hans ;
    rdfs:comment "革六二"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "已日乃革之，征吉，无咎。"@zh-Hans ;
    yj:baihuaText "到了该变的日子才行动起来变革，时机既成熟，前进便吉，没有过失。说明变革要等条件具备，不可抢先也不可久拖。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_48_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "革九三"@zh-Hans ;
    rdfs:comment "革九三"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "征凶，贞厉。革言三就，有孚。"@zh-Hans ;
    yj:baihuaText "贸然前进有凶险，死守也危险。变革之议反复斟酌三次而众议相合，说明唯有取信于人、慎重论证，才可行动。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_48_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "革九四"@zh-Hans ;
    rdfs:comment "革九四"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "悔亡，有孚，改命吉。"@zh-Hans ;
    yj:baihuaText "悔恨消失，取得信任，此时更改旧命、更张旧制，吉祥。变革深得人心，正是大刀阔斧革新的时候。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_48_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "革九五"@zh-Hans ;
    rdfs:comment "革九五"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "大人虎变，未占有孚。"@zh-Hans ;
    yj:baihuaText "大人物如虎换新毛，文采焕然一新，不用占问就已获众人信服。变革彻底而气象明朗，德位相配，自然天下归心。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_48_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "革上六"@zh-Hans ;
    rdfs:comment "革上六"@zh-Hans ;
    yj:lineOf yj:gua_48 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "君子豹变，小人革面，征凶。居贞吉。"@zh-Hans ;
    yj:baihuaText "君子变革如豹换毛，文采斐然；小人则只是改换脸面顺从。此时一意前行有凶，安居守正才吉；革新已到收尾，宜守成不宜再攻。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_48 yj:hasLine yj:gua_48_y1 ;
    yj:hasLine yj:gua_48_y2 ;
    yj:hasLine yj:gua_48_y3 ;
    yj:hasLine yj:gua_48_y4 ;
    yj:hasLine yj:gua_48_y5 ;
    yj:hasLine yj:gua_48_y6 .

yj:gua_49_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "鼎初六"@zh-Hans ;
    rdfs:comment "鼎初六"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "鼎颠趾，利出否。得妾以其子，无咎。"@zh-Hans ;
    yj:baihuaText "鼎足颠倒向上，正好倒出鼎中残渣，清除废物有利用；如同纳妾而得其子，虽非正途却无过失。说明开局先要清理旧的污秽积弊。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_49_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "鼎九二"@zh-Hans ;
    rdfs:comment "鼎九二"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "鼎有实，我仇有疾，不我能即，吉。"@zh-Hans ;
    yj:baihuaText "鼎中实有食物，我敌视之人有病患，无法接近侵害我，吉祥。守好手中本分与实力，外来的敌意自会消解，不必主动争斗。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_49_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "鼎九三"@zh-Hans ;
    rdfs:comment "鼎九三"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "鼎耳革，其行塞，雉膏不食。方雨，亏悔，终吉。"@zh-Hans ;
    yj:baihuaText "鼎耳损坏，抬不起来，行走受阻，美味雉羹吃不上。正逢下雨，悔恨稍减，终归吉祥。才华一时受阻，耐心等待转机即可。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_49_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "鼎九四"@zh-Hans ;
    rdfs:comment "鼎九四"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "鼎折足，覆公餗，其刑渥，凶。"@zh-Hans ;
    yj:baihuaText "鼎的脚折断，倾覆了给公上享用的美食，罪责重大，凶险。能力不足以当重任却硬撑，坏了大事必受严惩，当自知分量。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_49_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "鼎六五"@zh-Hans ;
    rdfs:comment "鼎六五"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "鼎黄耳，金铉，利贞。"@zh-Hans ;
    yj:baihuaText "鼎有黄色的耳、金属的横杠，稳固端庄，宜于守持正道。居尊位而虚中纳贤、刚柔相济，正是守正得吉的时候。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_49_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "鼎上九"@zh-Hans ;
    rdfs:comment "鼎上九"@zh-Hans ;
    yj:lineOf yj:gua_49 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "鼎玉铉，大吉，无不利。"@zh-Hans ;
    yj:baihuaText "鼎配玉制的横杠，贵重而温润，大为吉祥，无所不利。刚柔调和、德位相应，是成就圆满、无往不利的境地。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_49 yj:hasLine yj:gua_49_y1 ;
    yj:hasLine yj:gua_49_y2 ;
    yj:hasLine yj:gua_49_y3 ;
    yj:hasLine yj:gua_49_y4 ;
    yj:hasLine yj:gua_49_y5 ;
    yj:hasLine yj:gua_49_y6 .

yj:gua_50_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "震初九"@zh-Hans ;
    rdfs:comment "震初九"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "震来虩虩，后笑言哑哑，吉。"@zh-Hans ;
    yj:baihuaText "雷来时惶恐戒惧，事后谈笑自若，吉祥。起初的惊惧使人知戒，事后能从容恢复常态，是善处变故之道。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_50_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "震六二"@zh-Hans ;
    rdfs:comment "震六二"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "震来厉，亿丧贝，跻于九陵，勿逐，七日得。"@zh-Hans ;
    yj:baihuaText "雷来凶险，丧失大量财货，只得登上高陵避难。不必追索，七日后自会复得。突遭损失时先保身退避，失去的往往会自然回归。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_50_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "震六三"@zh-Hans ;
    rdfs:comment "震六三"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "震苏苏，震行无眚。"@zh-Hans ;
    yj:xiaoxiangText "震苏苏，位不当也。"@zh-Hans ;
    yj:baihuaText "雷声中惊惶不安，若随震而行则可免灾祸。心中虽不定，只要不呆立原地而顺势行动，就不会有过失。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_50_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "震九四"@zh-Hans ;
    rdfs:comment "震九四"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "震遂泥。"@zh-Hans ;
    yj:baihuaText "雷声陷落泥中，动弹不得。身处震动之中却被困住，进退失据，此时难有作为，宜静待雷息。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_50_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "震六五"@zh-Hans ;
    rdfs:comment "震六五"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "震往来厉，亿无丧有事。"@zh-Hans ;
    yj:baihuaText "雷声往来反复，危险重重，但不会有大的损失，仍能从事其职。居中守事、不慌不乱，虽险而可保事业不失。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_50_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "震上六"@zh-Hans ;
    rdfs:comment "震上六"@zh-Hans ;
    yj:lineOf yj:gua_50 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "震索索，视矍矍，征凶。震不于其躬于其邻，无咎。婚媾有言。"@zh-Hans ;
    yj:baihuaText "震得瑟瑟发抖，两眼惊慌四顾，此时前行有凶。灾难若未落到自己而落在邻人身上，则应及早戒备，可无过失；婚事却有口舌之争。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_50 yj:hasLine yj:gua_50_y1 ;
    yj:hasLine yj:gua_50_y2 ;
    yj:hasLine yj:gua_50_y3 ;
    yj:hasLine yj:gua_50_y4 ;
    yj:hasLine yj:gua_50_y5 ;
    yj:hasLine yj:gua_50_y6 .

yj:gua_51_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "艮初六"@zh-Hans ;
    rdfs:comment "艮初六"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "艮其趾，无咎，利永贞。"@zh-Hans ;
    yj:baihuaText "止住自己的脚趾，不妄动，没有过失，利于长久守正。在行动起步时就懂得克制，是最省事的自我约束。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_51_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "艮六二"@zh-Hans ;
    rdfs:comment "艮六二"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "艮其腓，不拯其随，其心不快。"@zh-Hans ;
    yj:baihuaText "止住小腿，却不能挽救其随人而动，心中不快。想止而身不由己，被上方牵制，虽未失正，却难免憋闷。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_51_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "艮九三"@zh-Hans ;
    rdfs:comment "艮九三"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "艮其限，裂其夤，厉阍心。"@zh-Hans ;
    yj:baihuaText "止住腰胯，撕裂了脊背的筋肉，危险揪心。硬性强行制止，用力过猛反而伤及自身，戒之在急。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_51_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "艮六四"@zh-Hans ;
    rdfs:comment "艮六四"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "艮其身，无咎。"@zh-Hans ;
    yj:baihuaText "止住自己的身躯，安然无咎。懂得约束自身、不轻举妄动，是得体的自守之道。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_51_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "艮六五"@zh-Hans ;
    rdfs:comment "艮六五"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "艮其辅，言有孚，悔亡。"@zh-Hans ;
    yj:baihuaText "止住自己的面颊嘴唇，说话有信用，悔恨消除。管住口舌、言而有信，是居位慎言者的要务。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_51_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "艮上九"@zh-Hans ;
    rdfs:comment "艮上九"@zh-Hans ;
    yj:lineOf yj:gua_51 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "敦艮，吉。"@zh-Hans ;
    yj:baihuaText "敦厚笃实地止住，吉祥。以厚重笃定之心善守到最后，是艮止的最高境界。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_51 yj:hasLine yj:gua_51_y1 ;
    yj:hasLine yj:gua_51_y2 ;
    yj:hasLine yj:gua_51_y3 ;
    yj:hasLine yj:gua_51_y4 ;
    yj:hasLine yj:gua_51_y5 ;
    yj:hasLine yj:gua_51_y6 .

yj:gua_52_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "渐初六"@zh-Hans ;
    rdfs:comment "渐初六"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "鸿渐于干，小子厉，有言，无咎。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞到水边，如年少者处境艰危，遭人责难，但终无过失。起步之初位卑力弱，虽受非议，守分而行即可。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_52_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "渐六二"@zh-Hans ;
    rdfs:comment "渐六二"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "鸿渐于磐，饮食衎衎，不素饱也。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞到磐石上，安然饮食，和乐自得。找到安稳立足之处，衣食有着，是进得其所、名副其实之时。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_52_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "渐九三"@zh-Hans ;
    rdfs:comment "渐九三"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "鸿渐于陆，夫征不复，妇孕不育，凶。利用御寇。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞上高陆，丈夫远征不归，妇人怀孕不育，凶险；宜于抵御外寇。冒进失位、夫妻离群，此时以守御自保为上。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_52_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "渐六四"@zh-Hans ;
    rdfs:comment "渐六四"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "鸿渐于木，或得其桷，无咎。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞到树上，或能找到平稳枝桠栖息，无咎。处境本不安全，能顺势择安而栖，便可得免于祸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_52_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "渐九五"@zh-Hans ;
    rdfs:comment "渐九五"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "鸿渐于陵，妇三岁不孕，终莫之胜，吉。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞到山陵之巅，妇人三年不孕，终究没有什么能胜过她，吉祥。虽长久受阻，只要坚守正道，终能如愿。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_52_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "渐上九"@zh-Hans ;
    rdfs:comment "渐上九"@zh-Hans ;
    yj:lineOf yj:gua_52 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "鸿渐于陆，其羽可用为仪，吉。"@zh-Hans ;
    yj:baihuaText "鸿雁渐飞到高陆，其羽毛可作礼仪之饰，吉祥。功成身退、以德为范，可为后人楷模，善始善终。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_52 yj:hasLine yj:gua_52_y1 ;
    yj:hasLine yj:gua_52_y2 ;
    yj:hasLine yj:gua_52_y3 ;
    yj:hasLine yj:gua_52_y4 ;
    yj:hasLine yj:gua_52_y5 ;
    yj:hasLine yj:gua_52_y6 .

yj:gua_53_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "归妹初九"@zh-Hans ;
    rdfs:comment "归妹初九"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "归妹以娣，跛而履，征吉。"@zh-Hans ;
    yj:baihuaText "少女以陪嫁之妹的身份出嫁，如跛脚之人勉强行走，前进仍吉。名分虽次、条件不足，安分随行也能有所成就。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_53_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "归妹九二"@zh-Hans ;
    rdfs:comment "归妹九二"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "眇而视，利幽人之贞。"@zh-Hans ;
    yj:baihuaText "如独眼之人勉强观看，宜于幽静守正之人的贞守。条件有缺、视野受限时，安于幽静自持，才是最妥当的选择。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_53_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "归妹六三"@zh-Hans ;
    rdfs:comment "归妹六三"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "归妹以须，反归以娣。"@zh-Hans ;
    yj:baihuaText "少女出嫁却需等待，结果反以陪嫁之妹的身份嫁出。时机不当、位分不合，急于求成往往只得其次。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_53_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "归妹九四"@zh-Hans ;
    rdfs:comment "归妹九四"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "归妹愆期，迟归有时。"@zh-Hans ;
    yj:baihuaText "少女出嫁错过了婚期，迟些出嫁自有其时。好事不怕晚，宁可等待合适时机，也不可凑合错配。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_53_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "归妹六五"@zh-Hans ;
    rdfs:comment "归妹六五"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "帝乙归妹，其君之袂，不如其娣之袂良。月几望，吉。"@zh-Hans ;
    yj:baihuaText "帝乙嫁女，正妻的衣袖反不如陪嫁之妹的华美。月近满盈，吉祥。位尊而心谦、重德不重饰，反得圆满吉庆。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_53_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "归妹上六"@zh-Hans ;
    rdfs:comment "归妹上六"@zh-Hans ;
    yj:lineOf yj:gua_53 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "女承筐无实，士刲羊无血，无攸利。"@zh-Hans ;
    yj:baihuaText "女子捧筐却没有实物，男子宰羊却不见血，无所利益。有名无实、虚应故事，终究一无所获，戒在诚心与实干。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_53 yj:hasLine yj:gua_53_y1 ;
    yj:hasLine yj:gua_53_y2 ;
    yj:hasLine yj:gua_53_y3 ;
    yj:hasLine yj:gua_53_y4 ;
    yj:hasLine yj:gua_53_y5 ;
    yj:hasLine yj:gua_53_y6 .

yj:gua_54_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "丰初九"@zh-Hans ;
    rdfs:comment "丰初九"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "遇其配主，虽旬无咎，往有尚。"@zh-Hans ;
    yj:baihuaText "遇到与自己相配的主人，虽遇阻碍也无过失，前往必受推崇。找到相合的伙伴共同行事，虽有小阻，仍可成就。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_54_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "丰六二"@zh-Hans ;
    rdfs:comment "丰六二"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "丰其蔀，日中见斗，往得疑疾。有孚发若，吉。"@zh-Hans ;
    yj:baihuaText "遮蔽太厚，正午却见北斗星，前往会招来猜疑之疾；若以诚信感发，则吉。被蒙蔽而生疑，唯有用诚意打动，方能化解。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_54_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "丰九三"@zh-Hans ;
    rdfs:comment "丰九三"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "丰其沛，日中见沫，折其右肱，无咎。折其右肱，无咎。"@zh-Hans ;
    yj:baihuaText "遮蔽重重，正午只见微光，折伤了右臂，无咎。环境昏暗、得力受损，虽难有大作为，但知难而止可免咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_54_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "丰九四"@zh-Hans ;
    rdfs:comment "丰九四"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "丰其蔀，日中见斗，遇其夷主，吉。按：四处上卦之下，以阳居阴，履非其位，而比于五故曰“遇”也。夷者，伤也。主者，五也。谓四不期相遇，而能上行伤五，则吉。故曰“遇其夷主，吉行也”。"@zh-Hans ;
    yj:baihuaText "遮蔽太厚，正午见斗，遇到有伤之主，吉。处境昏暗而位不当，能向上遇合，则化险为吉，宜主动寻明主。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_54_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "丰六五"@zh-Hans ;
    rdfs:comment "丰六五"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "来章，有庆誉，吉。"@zh-Hans ;
    yj:baihuaText "招来文采彰明之士，有喜庆美誉，吉祥。居尊位而广纳贤才、彰显文明，故有吉庆之声名。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_54_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "丰上六"@zh-Hans ;
    rdfs:comment "丰上六"@zh-Hans ;
    yj:lineOf yj:gua_54 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "丰其屋，蔀其家。窥其户，阒其无人。三岁不觌，凶。"@zh-Hans ;
    yj:baihuaText "使房屋丰大、遮蔽其家，窥其门中却寂静无人。三年不见人影，凶。一味追求排场而众叛亲离，虽盛而无实，终致大凶。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_54 yj:hasLine yj:gua_54_y1 ;
    yj:hasLine yj:gua_54_y2 ;
    yj:hasLine yj:gua_54_y3 ;
    yj:hasLine yj:gua_54_y4 ;
    yj:hasLine yj:gua_54_y5 ;
    yj:hasLine yj:gua_54_y6 .

yj:gua_55_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "旅初六"@zh-Hans ;
    rdfs:comment "旅初六"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "旅琐琐，斯其所取灾。"@zh-Hans ;
    yj:baihuaText "行旅之人琐碎小气，这正是自取灾祸的原因。旅途之中格局狭小、斤斤计较，必招麻烦，当放开胸襟。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_55_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "旅六二"@zh-Hans ;
    rdfs:comment "旅六二"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "旅即次，怀其资，得僮仆贞。"@zh-Hans ;
    yj:baihuaText "行旅之人住进客舍，怀揣资财，得到忠贞的僮仆。安顿得所、财有守护、又得可靠帮手，是旅途中的安稳之象。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_55_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "旅九三"@zh-Hans ;
    rdfs:comment "旅九三"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "旅焚其次，丧其僮仆，贞厉。"@zh-Hans ;
    yj:baihuaText "行旅之人烧了自己所住的客舍，失去了僮仆，守正也有危险。在外骄纵妄为，自毁栖身之所与助力，须深自戒惧。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_55_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "旅九四"@zh-Hans ;
    rdfs:comment "旅九四"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "旅于处，得其资斧，我心不快。"@zh-Hans ;
    yj:baihuaText "行旅之人寄居他处，得到了钱财器具，心中仍不痛快。虽有资财却未得正位，心有不快，是得不偿位之象。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_55_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "旅六五"@zh-Hans ;
    rdfs:comment "旅六五"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "射雉，一矢亡，终以誉命。"@zh-Hans ;
    yj:baihuaText "射野鸡，虽失一支箭，终能获得声誉和任命。小有损失而换得长远名声与赏识，射雉失矢不为亏，宜以文明取胜。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_55_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "旅上九"@zh-Hans ;
    rdfs:comment "旅上九"@zh-Hans ;
    yj:lineOf yj:gua_55 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "鸟焚其巢，旅人先笑后号咷，丧牛于易，凶。"@zh-Hans ;
    yj:baihuaText "鸟巢被烧，旅人先笑后哭，丧牛于易地，凶。旅居在外而傲慢无礼，乐极生悲，失去根本依托，大凶之象，戒在骄纵。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_55 yj:hasLine yj:gua_55_y1 ;
    yj:hasLine yj:gua_55_y2 ;
    yj:hasLine yj:gua_55_y3 ;
    yj:hasLine yj:gua_55_y4 ;
    yj:hasLine yj:gua_55_y5 ;
    yj:hasLine yj:gua_55_y6 .

yj:gua_56_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "巽初六"@zh-Hans ;
    rdfs:comment "巽初六"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "进退，利武人之贞。"@zh-Hans ;
    yj:baihuaText "处境彷徨，进也不敢、退也不甘，心志犹疑不定。此时宜效法武人的刚毅果决，果断选定方向并坚持守正，迟疑不决只会错失时机。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_56_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "巽九二"@zh-Hans ;
    rdfs:comment "巽九二"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "巽在床下，用史巫纷若，吉，无咎。"@zh-Hans ;
    yj:baihuaText "身处低位，谦卑顺服如同伏在床下，看似过卑，实为谨慎自处。若能诚心借助卜祝巫祝之人的沟通之力，谦而不过、柔而不失，便可获吉而无过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_56_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "巽九三"@zh-Hans ;
    rdfs:comment "巽九三"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "频巽，吝。"@zh-Hans ;
    yj:baihuaText "频频顺从、反复迎合，过分周旋于上下之间，这样的态度会招致羞辱。谦顺本是美德，但若失去原则、一味讨好，反而被人看轻。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_56_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "巽六四"@zh-Hans ;
    rdfs:comment "巽六四"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "悔亡，田获三品。"@zh-Hans ;
    yj:baihuaText "柔居柔位，上承九五，悔恨得以消除。此时处事得宜，如同田猎收获三类猎物，收获颇丰。关键在于上下配合、柔顺承上而不失分寸。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_56_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "巽九五"@zh-Hans ;
    rdfs:comment "巽九五"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "贞吉，悔亡，无不利，无初有终。先庚三日，后庚三日，吉。"@zh-Hans ;
    yj:baihuaText "居中得正，坚守正道可获吉祥，悔恨消除，无所不利。开头或许不顺，但坚持到底必有善果；做事前后反复斟酌（先庚三日、后庚三日），审慎布局，大吉。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_56_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "巽上九"@zh-Hans ;
    rdfs:comment "巽上九"@zh-Hans ;
    yj:lineOf yj:gua_56 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "巽在床下，丧其齐斧，贞凶。"@zh-Hans ;
    yj:baihuaText "居于极位仍过度卑微，如同伏在床下，谦顺已走到尽头。此时失去应有的刚断与威权，如丧失利斧，固守此道将有凶险，宜悔改而振作。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_56 yj:hasLine yj:gua_56_y1 ;
    yj:hasLine yj:gua_56_y2 ;
    yj:hasLine yj:gua_56_y3 ;
    yj:hasLine yj:gua_56_y4 ;
    yj:hasLine yj:gua_56_y5 ;
    yj:hasLine yj:gua_56_y6 .

yj:gua_57_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "兑初九"@zh-Hans ;
    rdfs:comment "兑初九"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "和兑，吉。"@zh-Hans ;
    yj:baihuaText "以平和自然之心与人相处，不谄媚、不刻意，这样的和悦出自本心，行为端正无疑，故获吉祥。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_57_y2 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "兑九三"@zh-Hans ;
    rdfs:comment "兑九三"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "孚兑，吉，悔亡。"@zh-Hans ;
    yj:baihuaText "心怀诚信而与人交流、取悦于人，不虚情假意。因诚信在心，故得吉祥，昔日的悔恨也随之消除。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_57_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "兑六三"@zh-Hans ;
    rdfs:comment "兑六三"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "来兑，凶。"@zh-Hans ;
    yj:baihuaText "主动逢迎、献媚求悦，位不正而心不端。这种有求于人、失去自我的讨好之悦，非但不能得人真心，反招凶险。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_57_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "兑九四"@zh-Hans ;
    rdfs:comment "兑九四"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "商兑未宁，介疾有喜。"@zh-Hans ;
    yj:baihuaText "在取悦他人与守正自处之间反复权衡，心绪不宁。若能果断拒绝邪曲、划清界限，远离谄媚之疾，反而会有可喜的结果。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_57_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "兑九五"@zh-Hans ;
    rdfs:comment "兑九五"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "孚于剥，有厉。"@zh-Hans ;
    yj:baihuaText "身居尊位却轻信那些刻意取悦、侵蚀正道之人，虽然位正，仍难免危险。居上者尤须分辨真心与奉承，不可被甜言所惑。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_57_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "兑上六"@zh-Hans ;
    rdfs:comment "兑上六"@zh-Hans ;
    yj:lineOf yj:gua_57 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "引兑。"@zh-Hans ;
    yj:baihuaText "居于喜悦之极，一味诱惑他人来取悦自己，或强引人相悦。这种取悦已失光明正大，缺乏真诚，难以长久，也难以服人。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_57 yj:hasLine yj:gua_57_y1 ;
    yj:hasLine yj:gua_57_y2 ;
    yj:hasLine yj:gua_57_y3 ;
    yj:hasLine yj:gua_57_y4 ;
    yj:hasLine yj:gua_57_y5 ;
    yj:hasLine yj:gua_57_y6 .

yj:gua_58_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "涣初六"@zh-Hans ;
    rdfs:comment "涣初六"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "用拯马壮，吉。"@zh-Hans ;
    yj:baihuaText "涣散初起、形势尚轻，及时施救最为要紧。此时如借助强健之马奋力救援，出手迅速有力，便能阻止涣散之势，获得吉祥。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_58_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "涣九二"@zh-Hans ;
    rdfs:comment "涣九二"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "涣奔其机，悔亡。"@zh-Hans ;
    yj:baihuaText "身处涣散之中，应迅速奔向可以依靠的凭依之地，寻得稳固的依托。归宿既定、心有所依，悔恨自然消除。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_58_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "涣六三"@zh-Hans ;
    rdfs:comment "涣六三"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "涣其躬，无悔。"@zh-Hans ;
    yj:baihuaText "志在向外、不在私己，能舍弃自身的得失而不被牵累。放下小我、不纠缠于私利，故可无所悔恨。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_58_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "涣六四"@zh-Hans ;
    rdfs:comment "涣六四"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "涣其群，元吉。涣有丘，匪夷所思。"@zh-Hans ;
    yj:baihuaText "能解散朋党集团、破除私小宗派，大为吉祥。散小群而聚大群，形成如山丘般的合力，这是常人难以想到的远见卓识。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_58_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "涣九五"@zh-Hans ;
    rdfs:comment "涣九五"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "涣汗其大号。涣王居，无咎。"@zh-Hans ;
    yj:baihuaText "以君位之尊发号施令，如大汗淋漓般痛切而有力，使政令畅达、人心振奋；同时散去自身的私利积藏，公而忘私，故无过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_58_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "涣上九"@zh-Hans ;
    rdfs:comment "涣上九"@zh-Hans ;
    yj:lineOf yj:gua_58 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "涣其血，去逖，出，无咎。"@zh-Hans ;
    yj:baihuaText "能远离祸患、散去流血之危，转身出走、脱离险境。及时远离危险之源，保全自身，因此无所咎害。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_58 yj:hasLine yj:gua_58_y1 ;
    yj:hasLine yj:gua_58_y2 ;
    yj:hasLine yj:gua_58_y3 ;
    yj:hasLine yj:gua_58_y4 ;
    yj:hasLine yj:gua_58_y5 ;
    yj:hasLine yj:gua_58_y6 .

yj:gua_59_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "节初九"@zh-Hans ;
    rdfs:comment "节初九"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "不出户庭，无咎。"@zh-Hans ;
    yj:baihuaText "时机未到、通塞未明，故安守其位、不出户庭。此时收敛谨慎、不轻举妄动，正合时宜，可以避免过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_59_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "节九二"@zh-Hans ;
    rdfs:comment "节九二"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "不出门庭，凶。"@zh-Hans ;
    yj:baihuaText "时机已到、当出而不出，反而闭门不出、固守自封。该行动时却不行动，错失良机，因此有凶。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_59_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "节六三"@zh-Hans ;
    rdfs:comment "节六三"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "不节若，则嗟若，无咎。"@zh-Hans ;
    yj:baihuaText "不能自我节制、放纵失度，事后便只能叹息懊悔。这声叹息是自取其咎，怨不得别人；但尚未造成大过，故亦无咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_59_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "节六四"@zh-Hans ;
    rdfs:comment "节六四"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "安节，亨。"@zh-Hans ;
    yj:baihuaText "安然守节、顺理而行，恰到好处。因能顺承在上者之道、柔和适度地自制，故获亨通。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_59_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "节九五"@zh-Hans ;
    rdfs:comment "节九五"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "甘节，吉。往有尚。"@zh-Hans ;
    yj:baihuaText "居中得正，节制而甘美适中，不苦不迫，令人乐意遵守，因此吉祥。如此推行而有作为，必受人崇尚推崇。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_59_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "节上六"@zh-Hans ;
    rdfs:comment "节上六"@zh-Hans ;
    yj:lineOf yj:gua_59 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "苦节，贞凶，悔亡。"@zh-Hans ;
    yj:baihuaText "节制过甚，如同苦节，虽守正却令人难以忍受，故有凶险。节制以适中为贵，走到极端便失其道，须及时疏导、悔改自宽。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_59 yj:hasLine yj:gua_59_y1 ;
    yj:hasLine yj:gua_59_y2 ;
    yj:hasLine yj:gua_59_y3 ;
    yj:hasLine yj:gua_59_y4 ;
    yj:hasLine yj:gua_59_y5 ;
    yj:hasLine yj:gua_59_y6 .

yj:gua_60_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "中孚初九"@zh-Hans ;
    rdfs:comment "中孚初九"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "虞吉，有它不燕。"@zh-Hans ;
    yj:baihuaText "安守本分、专一守信，故获吉祥。但一旦心存旁骛、另有他求，内心便不得安宁。诚信贵在专一，须始终不易其志。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_60_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "中孚九二"@zh-Hans ;
    rdfs:comment "中孚九二"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "鸣鹤在阴，其子和之，我有好爵，吾与尔靡之。"@zh-Hans ;
    yj:baihuaText "诚信之至，如鹤在幽暗处鸣叫，其子亦和声相应。同心之人彼此感应，如同我有美酒愿与你共享，真诚相感，自然投合。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_60_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "中孚六三"@zh-Hans ;
    rdfs:comment "中孚六三"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "得敌，或鼓或罢，或泣或歌。"@zh-Hans ;
    yj:baihuaText "位不当而心无定主，遇到对手便忽而进逼、忽而退让，一喜一悲、忽泣忽歌，摇摆不定。缺乏真诚定力，终难成事。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_60_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "中孚六四"@zh-Hans ;
    rdfs:comment "中孚六四"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "月几望，马匹亡，无咎。"@zh-Hans ;
    yj:baihuaText "如月近圆满而将亏，当此之际舍弃同类私党而专事于上。能断绝攀附、独立守正，故无咎害。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_60_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "中孚九五"@zh-Hans ;
    rdfs:comment "中孚九五"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "有孚挛如，无咎。"@zh-Hans ;
    yj:baihuaText "居中得正，诚信充盛，以诚联系凝聚众心，如同牢牢系结一般。以至诚感召上下、团结众人，因此没有过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_60_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "中孚上九"@zh-Hans ;
    rdfs:comment "中孚上九"@zh-Hans ;
    yj:lineOf yj:gua_60 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "翰音登于天，贞凶。"@zh-Hans ;
    yj:baihuaText "声闻虚高、徒有虚名，如鸡鸣之声上达于天，却无实德相副。虚声浮誉不能长久，固守于此反有凶险，须返归诚信之实。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_60 yj:hasLine yj:gua_60_y1 ;
    yj:hasLine yj:gua_60_y2 ;
    yj:hasLine yj:gua_60_y3 ;
    yj:hasLine yj:gua_60_y4 ;
    yj:hasLine yj:gua_60_y5 ;
    yj:hasLine yj:gua_60_y6 .

yj:gua_61_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "小过初六"@zh-Hans ;
    rdfs:comment "小过初六"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "飞鸟以凶。"@zh-Hans ;
    yj:baihuaText "如飞鸟高飞而失其所安，越分躁进，反招凶险。处位卑下而妄求高远，自取灾祸，此时不可盲动。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_61_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "小过六二"@zh-Hans ;
    rdfs:comment "小过六二"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "过其祖，遇其妣不及其君，遇其臣，无咎。"@zh-Hans ;
    yj:baihuaText "宜越过其祖而遇其妣，却不越过君上而遇其臣。做事不过分、知所谦退，合乎分寸、守其本位，故可无咎。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_61_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "小过九三"@zh-Hans ;
    rdfs:comment "小过九三"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "弗过防之，从或戕之，凶。"@zh-Hans ;
    yj:baihuaText "不肯稍加防备、疏于戒备，便有随从反被其伤害之患，凶险。刚而不用、又失警惕，易遭暗算，务必严加防范。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_61_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "小过九四"@zh-Hans ;
    rdfs:comment "小过九四"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "无咎，弗过遇之，往厉必戒，勿用永贞。"@zh-Hans ;
    yj:baihuaText "不越分而恰能与其相遇，故无咎。若贸然前往则有危险，必须引以为戒；不宜长久固守一途，宜审时变通。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_61_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "小过六五"@zh-Hans ;
    rdfs:comment "小过六五"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "密云不雨，自我西郊。公弋取彼在穴。"@zh-Hans ;
    yj:baihuaText "如密云自西郊而来却未能成雨，时机未至。此时当如公侯射取穴中之物，静待时机、稳取实利，不可急于求成。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_61_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "小过上六"@zh-Hans ;
    rdfs:comment "小过上六"@zh-Hans ;
    yj:lineOf yj:gua_61 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "弗遇过之，飞鸟离之，凶，是谓灾眚。"@zh-Hans ;
    yj:baihuaText "不肯相遇而径直越过，如飞鸟高飞反遭网罗之害，凶险，这叫做灾祸。过度越分、飞得太高太远，必自取祸殃。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_61 yj:hasLine yj:gua_61_y1 ;
    yj:hasLine yj:gua_61_y2 ;
    yj:hasLine yj:gua_61_y3 ;
    yj:hasLine yj:gua_61_y4 ;
    yj:hasLine yj:gua_61_y5 ;
    yj:hasLine yj:gua_61_y6 .

yj:gua_62_y1 a yj:Line ;
    rdfs:label "初九"@zh-Hans ;
    skos:altLabel "既济初九"@zh-Hans ;
    rdfs:comment "既济初九"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初九"@zh-Hans ;
    yj:yaociText "曳其轮，濡其尾，无咎。"@zh-Hans ;
    yj:xiaoxiangText "曳其轮，义无咎也。"@zh-Hans ;
    yj:baihuaText "如同拖住车轮、沾湿尾巴，警示初出之时不可冒进。成功之初宜缓行自持、抑制躁动，如此谨慎，方能无咎。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_62_y2 a yj:Line ;
    rdfs:label "六二"@zh-Hans ;
    skos:altLabel "既济六二"@zh-Hans ;
    rdfs:comment "既济六二"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "六二"@zh-Hans ;
    yj:yaociText "妇丧其佛，勿逐，七日得。"@zh-Hans ;
    yj:baihuaText "柔居中正，如妇人丢失了首饰，不必急着去追寻。守中自持、静待时机，失去的自会在七日后失而复得。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_62_y3 a yj:Line ;
    rdfs:label "九三"@zh-Hans ;
    skos:altLabel "既济九三"@zh-Hans ;
    rdfs:comment "既济九三"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "九三"@zh-Hans ;
    yj:yaociText "高宗伐鬼方，三年克之，小人勿用。"@zh-Hans ;
    yj:baihuaText "如高宗讨伐鬼方，历时三年方才攻克，劳而终成。成事艰难、耗费巨大，故不可任用小人，以免坏乱已成的局面。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_62_y4 a yj:Line ;
    rdfs:label "六四"@zh-Hans ;
    skos:altLabel "既济六四"@zh-Hans ;
    rdfs:comment "既济六四"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "六四"@zh-Hans ;
    yj:yaociText "繻有衣袽，终日戒。"@zh-Hans ;
    yj:baihuaText "如同衣裳破旧、以碎布填补御寒，处境已隐有忧患。此时应终日戒备、时时警惕，防范未然，方能保住成果。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_62_y5 a yj:Line ;
    rdfs:label "九五"@zh-Hans ;
    skos:altLabel "既济九五"@zh-Hans ;
    rdfs:comment "既济九五"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "九五"@zh-Hans ;
    yj:yaociText "东邻杀牛，不如西邻之禴祭，实受其福。"@zh-Hans ;
    yj:baihuaText "东邻杀牛盛祭，不如西邻简朴的禴祭更能实受神福。祭祀贵在诚心而非奢华，守诚务本者，方能真正获得福报。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_62_y6 a yj:Line ;
    rdfs:label "上六"@zh-Hans ;
    skos:altLabel "既济上六"@zh-Hans ;
    rdfs:comment "既济上六"@zh-Hans ;
    yj:lineOf yj:gua_62 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上六"@zh-Hans ;
    yj:yaociText "濡其首，厉。"@zh-Hans ;
    yj:baihuaText "身处成功之极，如渡水时沾湿了头，险象已至，危险。成功至极而不戒惧，必将由安逸转入危败，须及早警惕收敛。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_62 yj:hasLine yj:gua_62_y1 ;
    yj:hasLine yj:gua_62_y2 ;
    yj:hasLine yj:gua_62_y3 ;
    yj:hasLine yj:gua_62_y4 ;
    yj:hasLine yj:gua_62_y5 ;
    yj:hasLine yj:gua_62_y6 .

yj:gua_63_y1 a yj:Line ;
    rdfs:label "初六"@zh-Hans ;
    skos:altLabel "未济初六"@zh-Hans ;
    rdfs:comment "未济初六"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "1"^^xsd:integer ;
    yj:name "初六"@zh-Hans ;
    yj:yaociText "濡其尾，吝。"@zh-Hans ;
    yj:baihuaText "如渡河时沾湿了尾巴，力不能及而贸然前行，进退失据，故有吝惜悔憾。能力未足时不可强求速成，宜退守待时。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_63_y2 a yj:Line ;
    rdfs:label "九二"@zh-Hans ;
    skos:altLabel "未济九二"@zh-Hans ;
    rdfs:comment "未济九二"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "2"^^xsd:integer ;
    yj:name "九二"@zh-Hans ;
    yj:yaociText "曳其轮，贞吉。"@zh-Hans ;
    yj:baihuaText "如同拖住车轮、抑制前进之势，安守其位、不急于求进。守正自持、待时而动，故获吉祥。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_63_y3 a yj:Line ;
    rdfs:label "六三"@zh-Hans ;
    skos:altLabel "未济六三"@zh-Hans ;
    rdfs:comment "未济六三"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "3"^^xsd:integer ;
    yj:name "六三"@zh-Hans ;
    yj:yaociText "未济，征凶，利涉大川。"@zh-Hans ;
    yj:baihuaText "事未完成而位又不当，此时若贸然兴兵进取则有凶险，宜择时机、借助外力渡过大河，才能化险为功。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_63_y4 a yj:Line ;
    rdfs:label "九四"@zh-Hans ;
    skos:altLabel "未济九四"@zh-Hans ;
    rdfs:comment "未济九四"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "4"^^xsd:integer ;
    yj:name "九四"@zh-Hans ;
    yj:yaociText "贞吉，悔亡。震用伐鬼方，三年有赏于大邦。"@zh-Hans ;
    yj:baihuaText "守正可获吉祥、悔恨消除。如奋威讨伐鬼方，历时三年终获大邦的赏赐。坚定守正、坚持到底，终将得到回报。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_63_y5 a yj:Line ;
    rdfs:label "六五"@zh-Hans ;
    skos:altLabel "未济六五"@zh-Hans ;
    rdfs:comment "未济六五"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "5"^^xsd:integer ;
    yj:name "六五"@zh-Hans ;
    yj:yaociText "贞吉，无悔。君子之光，有孚，吉。"@zh-Hans ;
    yj:baihuaText "守正而获吉祥，无所悔恨。君子德行光辉、诚信充盈，故能照耀四方、得人信服，获得吉祥。"@zh-Hans ;
    yj:yinYang "阴"@zh-Hans .

yj:gua_63_y6 a yj:Line ;
    rdfs:label "上九"@zh-Hans ;
    skos:altLabel "未济上九"@zh-Hans ;
    rdfs:comment "未济上九"@zh-Hans ;
    yj:lineOf yj:gua_63 ;
    yj:yaoPosition "6"^^xsd:integer ;
    yj:name "上九"@zh-Hans ;
    yj:yaociText "有孚于饮酒，无咎。濡其首，有孚失是。"@zh-Hans ;
    yj:baihuaText "心怀诚信而从容饮酒待时，本无咎害；但若沉湎其中、饮酒沾湿了头，便失去诚信的分寸，诚信失当，反成过失。"@zh-Hans ;
    yj:yinYang "阳"@zh-Hans .

yj:gua_63 yj:hasLine yj:gua_63_y1 ;
    yj:hasLine yj:gua_63_y2 ;
    yj:hasLine yj:gua_63_y3 ;
    yj:hasLine yj:gua_63_y4 ;
    yj:hasLine yj:gua_63_y5 ;
    yj:hasLine yj:gua_63_y6 .

