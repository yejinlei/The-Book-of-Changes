yj:note_1383 a yj:CommentaryNote ;
    rdfs:label "干宝注·《周易集解》·师卦·卦辞·彖象"@zh-Hans ;
    rdfs:comment "楚灵、齐闵，穷兵之祸也。"@zh-Hans ;
    yj:commentaryNoteText "楚灵、齐闵，穷兵之祸也。"@zh-Hans ;
    yj:sourceCitation "《周易集解》·师卦·卦辞·彖象"@zh-Hans ;
    yj:annotates yj:gua_06 ;
    yj:belongsToCommentary yj:zb_jijie ;
