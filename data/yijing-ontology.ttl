# === Commentators (注家) ===
yj:zj_fuxi a yj:Commentator ;
    rdfs:label "伏羲"@zh-Hans ;
    rdfs:comment "上古易学家（传说）：观鸟兽之文与地之宜，始作八卦，以通神明之德，以类万物之情。"@zh-Hans ;
    yj:name "伏羲"@zh-Hans ;
    yj:xingming "伏羲"@zh-Hans ;
    yj:dynasty "上古"@zh-Hans ;
    yj:representativeWork "八卦"@zh-Hans ;
    yj:birthDeath "传说"@zh-Hans ;
    yj:baihuaText "观鸟兽之文与地之宜，始作八卦，以通神明之德，以类万物之情。"@zh-Hans .

yj:zj_wenwang a yj:Commentator ;
    rdfs:label "周文王"@zh-Hans ;
    rdfs:comment "西周易学家（前1152-前1056）：西伯姬昌，被囚羑里时推演周易，将八卦重为六十四卦并作卦辞。"@zh-Hans ;
    yj:name "周文王"@zh-Hans ;
    yj:xingming "周文王"@zh-Hans ;
    yj:dynasty "西周"@zh-Hans ;
    yj:representativeWork "重卦为六十四卦，作卦辞"@zh-Hans ;
    yj:birthDeath "前1152-前1056"@zh-Hans ;
    yj:baihuaText "西伯姬昌，被囚羑里时推演周易，将八卦重为六十四卦并作卦辞。"@zh-Hans .

yj:zj_zhougong a yj:Commentator ;
    rdfs:label "周公"@zh-Hans ;
    rdfs:comment "西周易学家（约前1100）：文王之子姬旦，制礼作乐，相传作三百八十四爻爻辞。"@zh-Hans ;
    yj:name "周公"@zh-Hans ;
    yj:xingming "周公"@zh-Hans ;
    yj:dynasty "西周"@zh-Hans ;
    yj:representativeWork "作爻辞"@zh-Hans ;
    yj:birthDeath "约前1100"@zh-Hans ;
    yj:baihuaText "文王之子姬旦，制礼作乐，相传作三百八十四爻爻辞。"@zh-Hans .

yj:zj_kongzi a yj:Commentator ;
    rdfs:label "孔子"@zh-Hans ;
    rdfs:comment "春秋易学家（前551-前479）：晚而好易，韦编三绝，作彖、象、系辞、文言、说卦、序卦、杂卦等十翼，将易从占筮之书提升为义理经典。"@zh-Hans ;
    yj:name "孔子"@zh-Hans ;
    yj:xingming "孔子"@zh-Hans ;
    yj:dynasty "春秋"@zh-Hans ;
    yj:representativeWork "十翼（易传）"@zh-Hans ;
    yj:birthDeath "前551-前479"@zh-Hans ;
    yj:baihuaText "晚而好易，韦编三绝，作彖、象、系辞、文言、说卦、序卦、杂卦等十翼，将易从占筮之书提升为义理经典。"@zh-Hans ;
    yj:schoolNote "儒家"@zh-Hans ;
    yj:belongsToSchool yj:school_%E5%84%92%E5%AE%B6 .

yj:zj_zixia a yj:Commentator ;
    rdfs:label "子夏"@zh-Hans ;
